# --------------------------------------------------------------------------

def term_size():
    try:
        import fcntl
        import struct
        import termios
        packed = fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ,
                             struct.pack("HHHH", 0, 0, 0, 0))
        rows, cols = struct.unpack("HHHH", packed)[:2]
        if rows and cols:
            return cols, rows
    except Exception:
        pass
    try:
        import shutil
        size = shutil.get_terminal_size((80, 24))
        return size.columns, size.lines
    except Exception:
        return 80, 24


def stdin_fd():
    """The fd to forward to the remote, or None if there is nothing to read."""
    try:
        fd = sys.stdin.fileno()
    except (AttributeError, ValueError, IOError):
        return None
    try:
        os.fstat(fd)
    except OSError:
        return None
    return fd


def pump(chan, is_tty=False):
    """Bridge local stdin/stdout/stderr and the remote channel until it closes.

    Local stdin is forwarded to the channel, chan.recv() is written to stdout
    and chan.recv_stderr() to stderr.  stdin matters more than it looks:
    anything that reads input -- `-c cat`, a prompt, a pipeline fed from a
    local file -- hangs forever if we only drain the channel, which is what
    ssh(1) would never do.

    With is_tty the local terminal is put in raw mode so keystrokes reach the
    remote pty unwrapped, and SIGWINCH keeps the remote pty sized to the
    window.  A pty merges the remote's stderr into stdout, so the stderr
    stream only ever carries data in the non-tty case.
    """
    import termios
    import tty

    out = sys.stdout.buffer
    err = sys.stderr.buffer
    chan.settimeout(0.0)
    infd = stdin_fd()

    resized = [False]

    def on_winch(signum, frame):
        resized[0] = True

    old_attrs = None
    old_winch = None
    if is_tty:
        try:
            old_winch = signal.signal(signal.SIGWINCH, on_winch)
        except (ValueError, AttributeError, OSError):
            pass
        if infd is not None:
            old_attrs = termios.tcgetattr(infd)

    try:
        if old_attrs is not None:
            tty.setraw(infd)
            tty.setcbreak(infd)

        while True:
            if resized[0]:
                resized[0] = False
                cols, rows = term_size()
                try:
                    chan.resize_pty(width=cols, height=rows)
                except Exception:
                    pass

            # Drain whatever the remote has already sent, then wait.  Any
            # error here -- a dropped connection most of all -- ends the
            # session quietly; a terminal bridge has no business printing
            # a traceback over the output it was carrying.
            got = False
            try:
                if chan.recv_ready():
                    data = chan.recv(65536)
                    if not data:
                        break
                    out.write(data)
                    out.flush()
                    got = True
                if chan.recv_stderr_ready():
                    data = chan.recv_stderr(65536)
                    if data:
                        err.write(data)
                        err.flush()
                        got = True
            except Exception:
                break
            if got:
                continue

            if chan.exit_status_ready() and not chan.recv_ready() \
                    and not chan.recv_stderr_ready():
                break

            watch = [chan] if infd is None else [chan, infd]
            try:
                ready, _, _ = select.select(watch, [], [], 0.2)
            except (select.error, InterruptedError):
                continue

            if infd is not None and infd in ready:
                try:
                    data = os.read(infd, 65536)
                except OSError:
                    data = b""
                if data:
                    try:
                        chan.sendall(data)
                    except Exception:
                        break
                else:
                    # Local EOF: close the remote's stdin so it can finish,
                    # then stay in the loop to collect whatever it still
                    # prints -- stdin ending does not mean the remote has.
                    try:
                        chan.shutdown_write()
                    except Exception:
                        pass
                    infd = None
    finally:
        if old_attrs is not None:
            termios.tcsetattr(infd, termios.TCSADRAIN, old_attrs)
        if old_winch is not None:
            try:
                signal.signal(signal.SIGWINCH, old_winch)
            except Exception:
                pass


def run_interactive(client, opts):
    transport = client.get_transport()
    chan = transport.open_session(timeout=opts.timeout)

    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    if interactive:
        cols, rows = term_size()
        chan.get_pty(term=os.environ.get("TERM", "xterm-256color"),
                     width=cols, height=rows)
    chan.invoke_shell()

    pump(chan, is_tty=interactive)

    status = 0
    try:
        if chan.exit_status_ready():
            status = chan.recv_exit_status()
    except Exception:
        pass
    chan.close()
    return status


def run_command(client, command, opts):
    transport = client.get_transport()
    chan = transport.open_session(timeout=opts.timeout)
    if opts.force_tty:
        cols, rows = term_size()
        chan.get_pty(term=os.environ.get("TERM", "xterm-256color"),
                     width=cols, height=rows)
    chan.exec_command(command)

    if opts.force_tty and sys.stdin.isatty() and sys.stdout.isatty():
        # The remote pty echoes and handles line editing, so the local tty has
        # to stay out of the way -- the same bridge an interactive login uses.
        pump(chan, is_tty=True)
    else:
        pump(chan)

    status = chan.recv_exit_status()
    chan.close()
    return status


