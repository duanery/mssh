def split_copy_arg(arg):
    """Split a copy argument into (endpoint_or_None, path).

    A remote file is written the way a login target is, with ':' and the
    path appended:  [user[:password]@]host[:port]:path.  The path may be
    absolute or relative to the remote home directory, and a trailing ':'
    with nothing after it means that home directory, as in scp.

        root@10.0.0.9:/var/log/syslog      absolute
        10.0.0.9:/var/log/syslog           as the local user
        root@10.0.0.9:logs/today.log       relative to ~
        root@10.0.0.9:36001:/var/log/x     with a port
        root@10.0.0.9:                     the home directory itself

    A local path is told apart the way scp tells one: what sits before the
    first ':' has to be able to be a host name.  So './x' and '/tmp/a:b' and
    './mail@archive/x' stay local -- '/' cannot appear in a host name -- while
    'notes:2024.txt' does not: with the user optional that reads as host
    'notes', exactly as it does under scp, and a local file of that name has
    to be written './notes:2024.txt'.  Any other file name a host name cannot
    spell is local too, so an odd name is a path rather than a usage error.

    Three things cannot be written here at all, and each raises ValueError
    naming the way round it.  A password containing '/', because a host name
    has no '/' and that is what tells a local path from a credential.  A
    remote path that is all digits: 'h:8900' is host h on port 8900, as it is
    everywhere else in mssh, so as a copy argument it carries no path -- write
    'h:8900:8900' for that file, or './h:8900' for a local one.  And an empty
    port field, 'h::8900', which is either a port left out or a path beginning
    with ':' and says nothing about which -- write 'h:./:8900' for the path.
    """
    cred, sep, hostpart = arg.rpartition("@")
    if sep:
        if not cred or "/" in cred:
            # No user name, or a '/' before the '@': a local path that happens
            # to contain '@', like ./mail@archive/x.
            return None, arg
    # With no '@' at all, rpartition has already left the whole argument in
    # hostpart and cred empty, which is what we want: host[:port]:path with
    # the user defaulted.

    # Skip a bracketed IPv6 literal, whose own ':'s are not separators.
    start = 0
    bracketed = hostpart.startswith("[")
    if bracketed:
        end = hostpart.find("]")
        if end < 0:
            raise ValueError("unterminated '[' in %r" % arg)
        start = end + 1

    colon = hostpart.find(":", start)
    if colon < 0:
        # No ':' anywhere: a local path ('./x', 'x'), or a login target with
        # no path appended ('root@h').  Either way there is no remote path
        # here, and the caller reads arg as a plain path.
        return None, arg

    host, rest = hostpart[:colon], hostpart[colon + 1:]

    # Settle whether this is a remote argument at all before reading the rest
    # of it.  A host part that cannot be a host name means the ':' belonged to
    # a local file name ('./x:y', '/tmp/a:b', ':leading'), which goes back as
    # a plain path -- an odd file name is not a usage error.  Deciding it here
    # keeps the complaints below for arguments that really do name a host.
    if bracketed:
        named_host = colon == end + 1 and valid_host(host[1:end], True)
    else:
        named_host = valid_host(host)
    if not named_host:
        return None, arg

    head, tail_sep, tail = rest.partition(":")

    if tail_sep and not head:
        # 'h::8900'.  The field a port would go in is empty, and that is not
        # a spelling mssh can read: it is either the port left out by mistake
        # or a path that really begins with ':', and the argument says nothing
        # about which.  Both are writable, just not like this.
        raise ValueError(
            "%r leaves the field before the second ':' empty, where the port "
            "goes; that is either a missing port or a path starting with "
            "':', and nothing here says which -- write %r for the path, or "
            "fill the port in (%s:PORT:%s)"
            % (arg, "%s:./%s" % (host, rest), host, tail)
        )

    if head.isdigit():
        # A numeric field is the port.  What follows it, if anything, is the
        # path; on its own it is just a login target with no path.
        if not tail_sep:
            # '10.0.0.9:8900' is host and port, the way it is everywhere else
            # in mssh -- not the remote file named '8900', and not a local
            # file with a ':' in its name.  So it is a usable endpoint but
            # carries no path, which as a copy argument is incomplete: say so
            # instead of silently picking one of the three readings.  A lone
            # argument never reaches this message; main() catches it and logs
            # in to that port.
            raise ValueError(
                "%r names host %s on port %s, with no path to copy; append "
                "':' and a path (%r), or './%s' for a local file of that "
                "name" % (arg, host, head, arg + ":/tmp/", arg)
            )
        host = "%s:%s" % (host, head)
        path = tail or "."
    else:
        # Everything after the first ':' is the path, colons included, so a
        # remote name like 'h:/tmp/a:b' survives whole.  (A *local* '/tmp/a:b'
        # never reaches here -- '/tmp/a' is not a host name, so the check
        # above sent it back as a path.)
        path = rest or "."

    spec = cred + "@" + host if sep else host
    try:
        return parse_endpoint(spec), path
    except ValueError:
        # The host name passed, so what is left to reject is the credential
        # part -- ':pw@h:/tmp' has no user before the ':'.  Read it as a local
        # path with a ':' in it; plan_copy then reports "no remote path",
        # which names the fix.
        return None, arg


def plan_copy(args):
    """Turn 'SOURCE... DEST' into (direction, sources, dest, endpoint).

    ``direction`` is "up" or "down"; ``sources`` and ``dest`` are bare paths
    with the endpoint stripped off, and ``endpoint`` is the remote host they
    all refer to.  Raises ValueError on any combination we cannot serve, so
    main() can reject it before opening a connection.
    """
    if len(args) < 2:
        raise ValueError(
            "file copy needs SOURCE and DEST, e.g. "
            "./app.tar root@10.0.0.9:/tmp/"
        )

    split = [split_copy_arg(a) for a in args]
    src_marks, (dest_ep, dest) = split[:-1], split[-1]

    for _, path in src_marks:
        if not path:
            raise ValueError("empty source path")
    if not dest:
        raise ValueError("empty destination path")

    remote = [ep for ep, _ in split if ep is not None]
    if not remote:
        raise ValueError(
            "no remote path among %s; write the remote side as "
            "[user@]host:/path" % ", ".join(args)
        )

    # One target per copy: every remote argument has to name the same host,
    # and a password given on either side counts for the whole connection.
    target = remote[0]
    for ep in remote[1:]:
        if (ep.user, ep.host, ep.port) != (target.user, target.host,
                                           target.port):
            raise ValueError(
                "all remote paths must be on the same host, got %s and %s"
                % (target, ep)
            )
        if target.password is None and ep.password is not None:
            target.password = ep.password

    remote_srcs = sum(1 for ep, _ in src_marks if ep is not None)
    if dest_ep is not None:
        if remote_srcs == len(src_marks):
            raise ValueError(
                "cannot copy remote to remote: every path is on %s"
                % target.host
            )
        if remote_srcs:
            raise ValueError("cannot mix local and remote sources")
        direction = "up"
    else:
        if remote_srcs != len(src_marks):
            raise ValueError("cannot mix local and remote sources")
        direction = "down"

    return direction, [p for _, p in src_marks], dest, target


def open_target_sftp(client):
    """An SFTP session on the target, or a clear exit if there is none."""
    try:
        return client.open_sftp()
    except paramiko.SSHException as exc:
        raise SystemExit(
            "mssh: target has no sftp subsystem (%s); sshd needs a\n"
            "      'Subsystem sftp' line. For a single file you can use:\n"
            "  mssh TARGET -c 'cat > /remote/path' < ./local/path" % exc
        )
    except (socket.error, OSError) as exc:
        raise SystemExit("mssh: cannot start sftp on the target: %s" % exc)


def _human(size):
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if size < 1024 or unit == "TiB":
            if unit == "B":
                return "%d B" % size
            return "%.1f %s" % (size, unit)
        size /= 1024.0


class _Interrupted(Exception):
    """Ctrl-C during a transfer, raised at a safe chunk boundary."""

    def __init__(self, path=None, done=0):
        Exception.__init__(self, "interrupted")
        self.path = path
        self.done = done


# Ctrl-C cannot simply raise during an SFTP transfer.  The default handler
# fires at an arbitrary bytecode boundary, which in practice is halfway
# through reading a packet; paramiko then closes the remote file politely on
# the way out, reads the rest of that packet as a header, and dies with
# "Garbage packet received" -- an exception that *replaces* the
# KeyboardInterrupt, so main() never sees it.  Even when the stream survives,
# that close is synchronous and waits for every outstanding prefetch reply,
# which for a large file over a slow chain means downloading the remainder
# before exiting.  So the handler only records the request, and the transfer
# callback acts on it between chunks.
_ABORT = {"requested": False}


def _install_abort_handler():
    """Make SIGINT set a flag instead of raising.

    Returns a callable that restores the previous handlers.
    """
    previous = None

    def on_sigint(signum, frame):
        if _ABORT["requested"]:
            # Asked twice: the transfer is not responding, so stop being
            # polite and let the interrupt through even if the unwind is
            # untidy.  run_copy turns the fallout back into a clean exit.
            try:
                signal.signal(signal.SIGINT, signal.default_int_handler)
            except Exception:
                pass
            raise KeyboardInterrupt
        _ABORT["requested"] = True
        sys.stderr.write("\nmssh: interrupting transfer...\n")
        sys.stderr.flush()

    _ABORT["requested"] = False

    # Closing the channel strands paramiko's prefetch thread on a dead
    # socket, and threading prints its traceback by default.  That death is
    # the intended consequence of the teardown, not news, so drop it -- but
    # only while an abort is in flight, and only for background threads.
    old_hook = getattr(threading, "excepthook", None)

    def thread_hook(args):
        if _ABORT["requested"]:
            return
        if old_hook is not None:
            old_hook(args)

    if old_hook is not None:
        threading.excepthook = thread_hook

    try:
        previous = signal.signal(signal.SIGINT, on_sigint)
    except (ValueError, OSError, AttributeError):
        return lambda: None

    def restore():
        try:
            signal.signal(signal.SIGINT, previous)
        except Exception:
            pass
        if old_hook is not None:
            threading.excepthook = old_hook

    return restore


def _transfer_callback(sftp, label):
    """Paramiko transfer callback: checks for Ctrl-C, then draws progress.

    Paramiko calls this every 32 KiB, which makes it the natural place to
    notice an abort request -- it is a chunk boundary, so the packet stream
    is intact and we can tear the channel down deliberately.
    """
    try:
        show = sys.stderr.isatty()
    except Exception:
        show = False

    state = {"start": time.time(), "last": 0.0}
    name = os.path.basename(label) or label

    def callback(done, total):
        if _ABORT["requested"]:
            if show:
                sys.stderr.write("\n")
                sys.stderr.flush()
            # Kill the channel before unwinding.  Paramiko's file close is
            # synchronous and would otherwise wait for every outstanding
            # prefetch reply; on a dead channel it raises EOFError instead,
            # which paramiko swallows itself.
            try:
                sftp.sock.close()
            except Exception:
                pass
            raise _Interrupted(label, done)

        if not show:
            return
        now = time.time()
        # Redraw at most ~8x/s, but never skip the final frame.
        if now - state["last"] < 0.125 and 0 < done < total:
            return
        state["last"] = now
        elapsed = now - state["start"]
        pct = (100.0 * done / total) if total else 100.0
        # Below half a second the rate is dominated by timer noise -- a
        # 2 TiB/s first frame is worse than no number at all.
        rate = "%s/s" % _human(done / elapsed) if elapsed >= 0.5 else ""
        sys.stderr.write("\r\033[K%s  %s / %s  %3.0f%%  %s"
                         % (name, _human(done), _human(total), pct, rate))
        if total and done >= total:
            sys.stderr.write("\n")
        sys.stderr.flush()

    return callback


def _remote_isdir(sftp, path):
    try:
        return statmod.S_ISDIR(sftp.stat(path).st_mode)
    except IOError:
        return False


def _remote_isfile(sftp, path):
    """Does ``path`` already exist remotely?  Decides whether to set a mode."""
    try:
        sftp.stat(path)
        return True
    except IOError:
        return False


def local_umask():
    """This process's umask, for filtering a copied file's mode.

    Read from /proc where possible: the portable way to query a umask is
    umask(0) followed by umask(old), which briefly sets it to 0 -- a race
    against anything else creating a file in the meantime.

    Used for both directions.  scp filters by the *receiving* side's umask,
    and on upload that is the remote's, which SFTP gives us no way to ask
    for.  The local one is the best available answer and the same number in
    the overwhelming majority of cases (both sides 022); where it differs,
    the result is still sane -- a mode the user's own environment considers
    appropriate -- and -p is there for anyone who wants the exact bits.
    """
    try:
        with open("/proc/self/status") as fh:
            for line in fh:
                if line.startswith("Umask:"):
                    return int(line.split()[1], 8)
    except (IOError, OSError, ValueError, IndexError):
        pass
    # No /proc (or an unexpected format): fall back to the racy dance, which
    # is still better than guessing.
    current = os.umask(0o022)
    os.umask(current)
    return current


def _copy_mode(source_mode, umask):
    """The mode a freshly copied file or directory should get.

    Mirrors what open(2)/mkdir(2) do for scp on the receiving side: the
    source's permission bits filtered by the umask, with
    setuid/setgid/sticky carried through untouched, as scp carries them.

    Only applied to something this copy created.  An existing file or
    directory keeps its own mode -- overwriting a 0600 config on the target
    must not widen it because our copy happened to be 0644, and scp behaves
    the same way (measured, in both directions).
    """
    return (source_mode & ~umask & 0o777) | (source_mode & 0o7000)


def _apply_local_attrs(path, attrs):
    """Copy mode and mtime from a remote stat onto a local path (-p)."""
    try:
        if attrs.st_mode is not None:
            os.chmod(path, statmod.S_IMODE(attrs.st_mode))
        if attrs.st_mtime is not None:
            atime = attrs.st_atime if attrs.st_atime is not None \
                else attrs.st_mtime
            os.utime(path, (atime, attrs.st_mtime))
    except OSError as exc:
        sys.stderr.write("mssh: cannot preserve attributes on %s: %s\n"
                         % (path, exc))


def _apply_remote_attrs(sftp, path, st):
    """Copy mode and mtime from a local stat onto a remote path (-p)."""
    try:
        sftp.chmod(path, statmod.S_IMODE(st.st_mode))
        sftp.utime(path, (st.st_atime, st.st_mtime))
    except IOError as exc:
        sys.stderr.write("mssh: cannot preserve attributes on :%s: %s\n"
                         % (path, exc))


def _remote_mkdir(sftp, path, mode=None):
    """Create ``path`` remotely, at ``mode`` if given.

    ``mode`` is forced writable and searchable by us for the duration: a
    0555 source directory cannot be filled after it is created, so the
    narrowing happens once the contents are in (upload_path does it).
    """
    if _remote_isdir(sftp, path):
        return None
    try:
        if mode is None:
            sftp.mkdir(path)
        else:
            sftp.mkdir(path, mode | 0o700)
    except IOError as exc:
        # A parallel creation or an existing dir is fine; anything else is not.
        if not _remote_isdir(sftp, path):
            raise SystemExit("mssh: cannot create remote directory :%s: %s"
                             % (path, exc))
        return None
    try:
        return statmod.S_IMODE(sftp.stat(path).st_mode)
    except IOError:
        return None


def _check_abort():
    """Raise if Ctrl-C arrived.

    Called where no transfer callback would fire: paramiko skips the callback
    for a zero-byte file, so a tree of tiny files needs its own check.
    """
    if _ABORT["requested"]:
        raise _Interrupted()


def upload_path(sftp, local, remote, opts):
    """Copy a local file or tree to ``remote`` (which is the final name)."""
    _check_abort()
    st = os.stat(local)                      # follows symlinks, like scp
    mode = statmod.S_IMODE(st.st_mode)

    if statmod.S_ISDIR(st.st_mode):
        if not opts.recursive:
            raise SystemExit("mssh: omitting directory %s (use -r)" % local)
        created = _remote_mkdir(sftp, remote, mode)
        for name in sorted(os.listdir(local)):
            upload_path(sftp, os.path.join(local, name),
                        remote.rstrip("/") + "/" + name, opts)
        # Attributes last: writing the contents bumps the directory mtime,
        # and a read-only source directory can only be narrowed once it is
        # full.  Only a directory we created ourselves is touched -- an
        # existing one keeps its own mode, as it does under scp.
        if opts.preserve:
            _apply_remote_attrs(sftp, remote, st)
        elif created is not None:
            want = _copy_mode(mode, local_umask())
            if want != created:
                try:
                    sftp.chmod(remote, want)
                except IOError as exc:
                    sys.stderr.write("mssh: cannot set mode on :%s: %s\n"
                                     % (remote, exc))
        return

    # Does it exist already?  If so it keeps its own mode, as under scp --
    # overwriting a 0600 config on the target must not widen it just because
    # our copy happens to be 0644.  Asked before the transfer, since the
    # transfer is what creates it.
    fresh = not opts.preserve and not _remote_isfile(sftp, remote)

    try:
        sftp.put(local, remote, callback=_transfer_callback(sftp, local))
    except _Interrupted:
        raise
    except IOError as exc:
        raise SystemExit("mssh: cannot write :%s: %s" % (remote, exc))

    # paramiko's put() sends no mode at all, so the file arrives at the
    # server's default 0666 & ~its umask and an executable source lands
    # non-executable -- the reported bug.  Set it afterwards.
    if opts.preserve:
        _apply_remote_attrs(sftp, remote, st)
    elif fresh:
        want = _copy_mode(mode, local_umask())
        try:
            sftp.chmod(remote, want)
        except IOError as exc:
            sys.stderr.write("mssh: cannot set mode on :%s: %s\n"
                             % (remote, exc))


def download_path(sftp, remote, local, opts):
    """Copy a remote file or tree to ``local`` (which is the final name)."""
    _check_abort()
    try:
        attrs = sftp.stat(remote)            # follows symlinks, like scp
    except IOError as exc:
        raise SystemExit("mssh: cannot read :%s: %s" % (remote, exc))

    if attrs.st_mode is not None and statmod.S_ISDIR(attrs.st_mode):
        if not opts.recursive:
            raise SystemExit("mssh: omitting remote directory :%s (use -r)"
                             % remote)
        created = False
        if not os.path.isdir(local):
            try:
                # Writable while we fill it; narrowed below, as on upload.
                os.makedirs(local, statmod.S_IMODE(attrs.st_mode) | 0o700)
                created = True
            except OSError as exc:
                raise SystemExit("mssh: cannot create %s: %s" % (local, exc))
        for entry in sorted(sftp.listdir_attr(remote),
                            key=lambda a: a.filename):
            download_path(sftp, remote.rstrip("/") + "/" + entry.filename,
                          os.path.join(local, entry.filename), opts)
        if opts.preserve:
            _apply_local_attrs(local, attrs)
        elif created:
            try:
                want = _copy_mode(statmod.S_IMODE(attrs.st_mode),
                                  local_umask())
                if want != statmod.S_IMODE(os.stat(local).st_mode):
                    os.chmod(local, want)
            except OSError as exc:
                sys.stderr.write("mssh: cannot set mode on %s: %s\n"
                                 % (local, exc))
        return

    # As on upload: an existing file keeps its own mode, so only a file this
    # copy creates gets one.  Asked before the transfer creates it.
    fresh = not opts.preserve and not os.path.exists(local)

    try:
        sftp.get(remote, local,
                 callback=_transfer_callback(sftp, remote),
                 max_concurrent_prefetch_requests=MAX_PREFETCH)
    except _Interrupted:
        # A half-written file is worse than none: it looks complete to every
        # tool that follows.  Drop it and name it, so nothing silently uses it.
        try:
            os.unlink(local)
            sys.stderr.write("mssh: removed partial %s\n" % local)
        except OSError:
            pass
        raise
    except IOError as exc:
        raise SystemExit("mssh: cannot write %s: %s" % (local, exc))

    # paramiko's get() opens the local file with a plain open(), so the mode
    # comes from our umask alone and a downloaded script arrived
    # non-executable.  Set it afterwards, mirroring the upload side.
    if opts.preserve:
        _apply_local_attrs(local, attrs)
    elif fresh and attrs.st_mode is not None:
        want = _copy_mode(statmod.S_IMODE(attrs.st_mode), local_umask())
        try:
            os.chmod(local, want)
        except OSError as exc:
            sys.stderr.write("mssh: cannot set mode on %s: %s\n"
                             % (local, exc))


def run_copy(client, plan, opts):
    """Serve the SOURCE... DEST form over one SFTP session on the target.

    ``plan`` is the tuple main() already got from plan_copy, so the
    arguments are parsed and validated before any connection is opened.
    """
    direction, sources, dest, _ = plan

    sftp = open_target_sftp(client)
    restore_sigint = _install_abort_handler()
    try:
        if direction == "up":
            for src in sources:
                if not os.path.exists(src):
                    raise SystemExit(
                        "mssh: %s: no such file or directory" % src)
            dest_is_dir = _remote_isdir(sftp, dest)
            if len(sources) > 1 and not dest_is_dir:
                raise SystemExit(
                    "mssh: :%s is not a directory, but %d sources were given"
                    % (dest, len(sources))
                )
            for src in sources:
                target = dest
                if dest_is_dir:
                    base = os.path.basename(src.rstrip("/")) or src
                    target = dest.rstrip("/") + "/" + base
                verbose(opts, "upload %s -> :%s" % (src, target))
                upload_path(sftp, src, target, opts)
        else:
            dest_is_dir = os.path.isdir(dest)
            if len(sources) > 1 and not dest_is_dir:
                raise SystemExit(
                    "mssh: %s is not a directory, but %d sources were given"
                    % (dest, len(sources))
                )
            for src in sources:
                target = dest
                if dest_is_dir:
                    base = os.path.basename(src.rstrip("/")) or src
                    target = os.path.join(dest, base)
                verbose(opts, "download :%s -> %s" % (src, target))
                download_path(sftp, src, target, opts)
    except _Interrupted as exc:
        # The channel may still be live (an abort noticed between files rather
        # than mid-chunk); close it before the polite sftp.close() in the
        # finally block can block waiting on a reply.
        try:
            sftp.sock.close()
        except Exception:
            pass
        if exc.path is not None:
            sys.stderr.write("mssh: interrupted %s at %s\n"
                             % (os.path.basename(exc.path) or exc.path,
                                _human(exc.done)))
        else:
            sys.stderr.write("mssh: interrupted\n")
        return 130
    except (paramiko.SSHException, EOFError) as exc:
        # The channel we tore down on abort can surface as a protocol error
        # while unwinding; report the interrupt, not the debris.
        if _ABORT["requested"]:
            sys.stderr.write("mssh: interrupted\n")
            return 130
        raise SystemExit("mssh: sftp error: %s" % exc)
    finally:
        restore_sigint()
        try:
            sftp.close()
        except Exception:
            pass
    return 0


# --------------------------------------------------------------------------
# persistent session
# --------------------------------------------------------------------------
#
# A plain `mssh target -c cmd` cannot help a caller that wants to keep state:
# every run is a new process, so a `cd /var/log` in one call is gone by the
# next, along with the exported variables and the chain that took seconds to
# build.  A session keeps one local daemon holding the SSH chain and one
# long-lived remote program; each later call is a short connection to that
# daemon over a unix socket, which feeds in one command and prints its output.
#
# The remote program runs behind a pty, for two reasons found by measurement:
# without one a program's stdout and stderr arrive as two unordered streams
# (error text detaches from the output it belongs to), and only a pty gives a
# working Ctrl-C -- over pipes, signalling the foreground child leaves the
# shell to run the *rest* of the command list, which is the wrong semantics.
# The costs are that the pty turns '\n' into '\r\n' (stripped on the way out)
# and merges stderr into stdout (the exit status, not the stream, is what
# tells a caller whether a command failed).

# A dumb terminal keeps programs from emitting colour and cursor escapes, but
# column-aware ones (ls, ps) still format for the width we claim here.
SESSION_TERM = "dumb"
SESSION_COLS = 200
SESSION_ROWS = 50

# Shell mode runs bash when the target has it, since the framing below wants
# a POSIX shell and a login $SHELL could be anything, csh included.
SESSION_SHELL = '"$(command -v bash 2>/dev/null || echo /bin/sh)"'

# How one command is framed in shell mode.  The naive form -- appending
# "; printf ..." to the user's line -- is broken on ordinary input: 'sleep 1 &',
# 'echo x |', a trailing '# comment', 'if true', a heredoc and any unterminated
# quote each wedge the session, because the framing is then parsed in the same
# syntactic position as the command.  Sending the command base64-encoded and
# unwrapping it remotely puts it inside an eval instead, where none of that can
# happen.  '</dev/null' is what keeps a bare 'cat' from swallowing the next
# control line, and $__M holds the marker so the literal marker string never
# travels the channel and cannot be echoed back by accident.
SESSION_FRAME = ('eval "$(echo %s | base64 -d)" </dev/null'
                 ' ; printf \'\\n%%s%%s\\n\' "$__M" "$?"\n')

# The same frame, but with local stdin fed to the command:
# 'echo aa | mssh --session s cat' should behave like 'echo aa | ssh host cat'.
#
# The data does not travel through the pty at all.  It goes over a second SSH
# channel, into a fifo, which the session's own shell reads -- so the command
# still runs in the long-lived shell (cwd, variables and functions intact) while
# its stdin arrives out of band.  Three simpler designs were tried first and
# each is worse:
#
#   * running the command on the second channel instead, with stdin forwarded
#     natively, loses the session: open_session starts a *new* process on the
#     target, so 'cd /tmp' and every unexported variable, function, shell
#     option, open fd and background job of the live shell do not apply to it.
#     Measured: a fresh channel saw '/' and an empty $PLAIN after the session
#     shell had done 'cd /var/log; PLAIN=p'.
#   * a base64 heredoc into a temp file keeps the shell but crawls: the pty
#     carries every byte as text for the remote shell to decode, measured at
#     0.4 MiB/s against bash, and it cannot stream -- the command sees nothing
#     until the last line arrives, so 'tail -f | mssh ...' could not work.
#   * feeding the pty directly cannot work at all: canonical mode truncates a
#     line at 4095 bytes and reads control bytes as signals -- measured, a 0x03
#     in the data killed the program.
#
# The fifo is created by the writer channel, which announces it ('echo R')
# before blocking on the open; only then is the command framed.  That ordering
# is what makes it race-free -- a reader framed against a path that does not
# exist yet fails immediately with "No such file or directory".  Opening a fifo
# for writing blocks until the reader arrives, so by the time 'rm' runs both
# ends hold the inode: the name goes away at once while the pipe itself lives
# until both sides close.  Nothing is left on the target even if the daemon is
# killed mid-command.
SESSION_FRAME_IN = ('eval "$(echo %s | base64 -d)" < "%s"'
                    ' ; printf \'\\n%%s%%s\\n\' "$__M" "$?"\n')
# The writer channel's program.  'mkfifo -m 600' before anything else, so the
# path is never briefly world-writable; the readiness byte then tells the daemon
# the fifo exists.  'exec cat' replaces the shell so the channel's EOF closes
# fd 3 directly, which is what the reader sees as end of input.
SESSION_WRITER = ('mkfifo -m 600 %(path)s 2>/dev/null && echo R && '
                  'exec 3> %(path)s && rm -f %(path)s && exec cat >&3\n')
SESSION_WRITER_READY = b"R"
# A fifo per command, never one reused path.  Measured, sharing one path
# misroutes data: when a command times out its reader stays queued on the fifo,
# so the *next* command's stdin was delivered to the abandoned reader instead --
# cmd2's payload landed in cmd1's output file while cmd2 read nothing.  A unique
# path per send makes that impossible.  mkfifo costs ~5ms.
SESSION_IN_PATH = "/tmp/.mssh-in-%s"

# Resynchronisation after an interrupt or a timeout: the marker carries a
# one-shot token instead of a status, so it cannot be confused with the frame
# of the command that was abandoned, however late that one arrives.
SESSION_RESYNC = 'printf \'\\n%%s%s\\n\' "$__M"\n'
SESSION_SETUP = "unset PS1 PS2 PROMPT_COMMAND; __M='%s'\n"

# Only the tail of the buffer is tested against --prompt: a prompt is short,
# and scanning megabytes of output on every poll would be quadratic.
SESSION_TAIL = 4096

# How long the daemon's loop sleeps when no descriptor is ready.  It only
# bounds how soon --idle, --wait and an interrupt from another thread are
# noticed; data wakes the select immediately.
SESSION_TICK = 0.05

# How much output may be held for a client that is not reading, and how much
# of its stdin may be held for a remote window that is full, before the
# producing side is dropped from the select.  One pipe's worth: enough that a
# brief pause costs nothing, small enough that the pressure reaches the remote
# program rather than growing here.
SESSION_BACKLOG = 65536

# Descriptors a request may carry: the output pipe(s), then stdin.  A send
# carries two at most (stdout, stdin); an exec carries three, since its stderr
# is a pipe of its own.  The cap is the protocol, not a buffer size -- a peer
# that sends more is not speaking it, and the extras are closed rather than
# kept.
SESSION_MAX_FDS = 3

# Terminal escapes, stripped in interactive mode before --prompt is matched.
# TERM=dumb stops most of them, but not all: a coloured prompt would put
# '\x1b[0m' after the text the user's regex anchors on, and shell-integration
# markers (OSC 633) trail every prompt in some environments -- either one
# makes a correct '...$'-anchored regex silently never match.
SESSION_ESC_RE = re.compile(
    rb"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)"      # OSC ... BEL / ST
    rb"|\x1b\[[0-?]*[ -/]*[@-~]"               # CSI
    rb"|\x1b[@-Z\\-_]"                         # two-character escapes
)


class SessionGone(Exception):
    """No live daemon is listening on that session's socket."""


class _SessionDead(Exception):
    """The remote program behind the session has exited."""


def stdin_kind(fd=None):
    """What the client's stdin is: 'pipe', 'file', 'tty', 'null' or 'none'.

    The kind, not the command, is what decides whether stdin is forwarded.
    Guessing from the command line cannot work -- 'cat' reads it, 'ls' does not,
    and 'sh -c "..."' could do either -- while fstat answers for free and reads
    nothing, so a command that turns out to ignore its input costs nothing.

    'null' is told apart from 'pipe' by device number, not by name: a command
    reading /dev/null and one given no input at all are indistinguishable, so
    forwarding it would set up a channel and a fifo to deliver nothing.  That
    matters because scripts, cron jobs and agents write '</dev/null' routinely.
    """
    if fd is None:
        fd = stdin_fd()
    if fd is None:
        return "none"
    try:
        st = os.fstat(fd)
    except OSError:
        return "none"
    if statmod.S_ISFIFO(st.st_mode) or statmod.S_ISSOCK(st.st_mode):
        return "pipe"
    if statmod.S_ISREG(st.st_mode):
        return "file"
    if statmod.S_ISCHR(st.st_mode):
        try:
            if st.st_rdev == os.stat(os.devnull).st_rdev:
                return "null"
        except OSError:
            pass
        try:
            if os.isatty(fd):
                return "tty"
        except OSError:
            pass
        return "pipe"                     # some other character device
    return "pipe"


def want_stdin(opts):
    """True if this send should carry the client's stdin to the remote command.

    A pipe or a regular file is forwarded: that is 'echo aa | mssh --session s
    cat' and 'mssh --session s wc -l <file', both of which mean to send data.

    A terminal is not, unless --stdin asks for it.  Forwarding it by default
    would make the ordinary interactive 'mssh --session s ls' sit waiting for
    the user to type an EOF before the command could finish.

    /dev/null and a closed stdin are never forwarded; there is nothing to send.
    """
    if opts.no_stdin:
        return False
    kind = stdin_kind()
    if kind == "tty":
        return bool(opts.stdin)
    return kind in ("pipe", "file")


def session_frame(line, in_path=None):
    """The remote text that runs one command and prints its frame marker."""
    blob = base64.b64encode(line.encode("utf-8")).decode("ascii")
    if in_path is None:
        return SESSION_FRAME % blob
    return SESSION_FRAME_IN % (blob, in_path)


def session_dir():
    """Directory holding session sockets, created 0700 and checked on use.

    Always ~/.mssh/sessions, never $XDG_RUNTIME_DIR: that variable is set in
    some shells and not others (a desktop terminal has it, a cron job or an
    `ssh host` command does not), so keying off it split one user's sessions
    into two namespaces -- a session started from one shell was invisible to
    `--sessions` in another.  $HOME is the thing that actually identifies the
    user here.

    Holding one of these sockets is equivalent to being logged in on the
    target, so the directory is guarded like a private key rather than like a
    temp file: never a predictable path in /tmp, owner-only, and re-verified
    on every use rather than only at creation.
    """
    path = os.path.join(os.path.expanduser("~"), ".mssh", "sessions")

    try:
        os.makedirs(path, 0o700)
    except OSError:
        pass

    try:
        st = os.lstat(path)
    except OSError as exc:
        raise SystemExit("mssh: cannot use session directory %s: %s"
                         % (path, exc))
    if not statmod.S_ISDIR(st.st_mode):
        raise SystemExit("mssh: session directory %s is not a directory"
                         % path)
    if st.st_uid != os.getuid():
        raise SystemExit("mssh: session directory %s belongs to uid %d, not "
                         "you -- refusing to use it" % (path, st.st_uid))
    if st.st_mode & 0o077:
        os.chmod(path, 0o700)
    return path


def session_path(name):
    """Socket path for a session name, with the name validated first."""
    if not SESSION_NAME_RE.match(name or ""):
        raise SystemExit(
            "mssh: invalid session name %r; use up to 64 characters from "
            "A-Z a-z 0-9 . _ - starting with a letter, digit or _" % (name,)
        )
    return os.path.join(session_dir(), name + ".sock")


def _peer_uid(conn):
    """uid of the process on the other end of a unix socket, or None."""
    import struct
    try:
        blob = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                               struct.calcsize("3i"))
    except (AttributeError, OSError):
        return None
    _pid, uid, _gid = struct.unpack("3i", blob)
    return uid


class _ClientGone(Exception):
    """The client that asked for this command is no longer listening."""


class _BufSink(object):
    """Collects output in memory, for the setup banner and for drains.

    The same sink interface as _FdSink, so one loop serves both: the only
    difference is where the bytes end up.
    """

    wfd = None
    backlog = 0

    def __init__(self):
        self.chunks = []

    def write(self, data):
        if data:
            self.chunks.append(data)

    def flush(self):
        return True

    def drain(self):
        pass

    def value(self):
        return b"".join(self.chunks)


class _FdSink(object):
    """Output bytes to the client's pipe, buffering whatever will not fit.

    The descriptor is the write end of a pipe the client created and handed
    over with its request, so the command's output never passes through JSON:
    it is copied from the channel to this fd and read straight off the other
    end.  Nothing frames it, so nothing has to encode it.

    The fd is non-blocking because this is the only thread: a write that
    blocked -- a client paused in a pager, a terminal that stopped scrolling --
    would stop the loop reading the channel, the client's stdin and the request
    socket alike.  What will not fit is held here instead, and the loop stops
    reading the channel once too much has piled up, so the backpressure reaches
    the remote program through the SSH window rather than growing in the
    daemon.
    """

    def __init__(self, fd):
        self.wfd = fd
        self.buf = b""
        self.gone = False

    @property
    def backlog(self):
        return len(self.buf)

    def write(self, data):
        if data and not self.gone:
            self.buf += data
            self.flush()

    def flush(self):
        """Push what the pipe will take.  False once the reader is gone."""
        while self.buf and not self.gone:
            try:
                sent = os.write(self.wfd, self.buf)
            except BlockingIOError:
                break                     # the pipe is full; select on it
            except OSError:
                # The client died or closed its end.  Drop what is left: there
                # is nobody to hand it to, and the command still frames on its
                # own marker.
                self.gone = True
                self.buf = b""
                break
            self.buf = self.buf[sent:]
        return not self.gone

    def drain(self, limit=30.0):
        """Block until the last of the output is in the pipe.

        Called once, after the command has ended and before the descriptor is
        closed: whatever the pipe was too full to take is still the command's
        output, and closing on it would truncate the tail of a command whose
        client reads slowly.  Blocking is safe here only because nothing else
        is left to watch -- the frame is closed and the lock is about to go.
        """
        deadline = time.time() + limit
        while self.buf and not self.gone and self.flush():
            if not self.buf:
                break
            remaining = deadline - time.time()
            if remaining <= 0:
                break                     # a client that never reads again
            try:
                if not select.select([], [self.wfd], [], remaining)[1]:
                    break
            except (select.error, InterruptedError):
                continue


class _ShellFramer(object):
    """Shell mode: everything up to our frame marker is the command's output.

    One line is held back, because the framing printf writes a newline of its
    own that is not part of the command's output: when the marker comes
    straight after a line, that line was the command's last and its newline was
    the frame's, so emitting it earlier would append a newline the command
    never printed.

    The hold is released after --idle of quiet, which is what lets an
    interactive filter work.  Without that release the holdback was unbounded:
    'mssh --session s --stdin cat' showed nothing at all until Ctrl-D, because
    each typed line sat here waiting for the next one.  A held line is safe to
    release once the output goes quiet, since a real frame marker follows its
    line immediately -- far inside --idle -- so anything still held after a
    pause had a newline of its own.
    """

    def __init__(self, session):
        self.session = session
        self.tail = b""
        self.held = None
        self.last_data = time.time()

    def feed(self, data, sink):
        """Hand this chunk to the sink.  (status, False) at the marker."""
        session = self.session
        self.last_data = time.time()
        self.tail += data
        lines = self.tail.split(b"\n")
        self.tail = lines.pop()
        for raw in lines:
            line = session._clean(raw)
            status = session._marker_status(line)
            if status is None:
                if self.held is not None:
                    sink.write(self.held + b"\n")
                self.held = line
                continue
            if self.held:
                # A last line that had no newline of its own.
                sink.write(self.held)
            self.held = None
            return (status, False)
        return None

    def idle(self, sink, now):
        """Release what a pause proves was complete.  Never ends the frame."""
        if now - self.last_data < self.session.idle:
            return None
        if self.held is not None:
            # Nothing followed it, so its newline was real: hand it over
            # rather than waiting for a line that may never come.
            sink.write(self.held + b"\n")
            self.held = None
        if self.tail and not self.session.mark.startswith(
                self.tail.rstrip(b"\r")):
            # A partial line that has gone quiet: a prompt, a progress bar, a
            # status line.  Release it once it cannot be the start of the
            # marker, so a command that asks a question is not held back.
            sink.write(self.session._clean(self.tail))
            self.tail = b""
        return None

    def flush(self, sink, newline=True):
        """Hand over the leftovers when no marker is going to come."""
        if self.held is not None:
            sink.write(self.held + b"\n" if newline else self.held)
            self.held = None
        if self.tail:
            sink.write(self.session._clean(self.tail))
            self.tail = b""

    def on_abort(self, sink):
        # Ctrl-C destroyed the whole command list, the framing printf
        # included, so no marker is coming; resynchronise instead.  The held
        # line keeps its own newline here, since the frame never printed one.
        self.flush(sink, newline=False)
        self.session._resync()
        return (130, False)


class _InteractiveFramer(object):
    """Interactive mode: a reply ends at --prompt, or at a pause without one.

    --prompt is matched against one line at a time -- the trailing partial line
    first, since that is where an interactive program leaves its prompt, then
    whole lines, for the rarer program that ends its prompt with a newline.
    Matching the whole buffer instead would frame early on output that merely
    quoted something prompt-shaped.
    """

    def __init__(self, session):
        self.session = session
        self.tail = b""
        self.last_data = time.time()

    def feed(self, data, sink):
        session = self.session
        self.last_data = time.time()
        self.tail += data
        lines = self.tail.split(b"\n")
        self.tail = lines.pop()
        for raw in lines:
            line = session._clean(raw)
            if session.prompt_re is not None:
                match = session._prompt_at_end(line)
                if match is not None:
                    if match:
                        sink.write(match)
                    return (None, False)
            sink.write(line + b"\n")
        if session.prompt_re is not None:
            match = session._prompt_at_end(session._clean(self.tail))
            if match is not None:
                if match:
                    sink.write(match)
                return (None, False)
        return None

    def idle(self, sink, now):
        session = self.session
        if session.prompt_re is not None:
            return None
        if now - self.last_data < session.idle:
            return None
        # No --prompt: fall back to "nothing new for a while".  This is a
        # heuristic, which is why --prompt exists.
        if self.tail:
            sink.write(session._clean(self.tail))
            self.tail = b""
            return None
        return (None, False)

    def flush(self, sink, newline=True):
        if self.tail:
            sink.write(self.session._clean(self.tail))
            self.tail = b""

    def on_abort(self, sink):
        self.flush(sink)
        # The program itself handled the Ctrl-C and will print its own prompt
        # again; drain that so the next command frames cleanly.
        self.session._drain_interactive()
        return (130, False)


class _ExecJob(object):
    """One command running on a channel of its own, outside the session shell.

    Held in the session only so that --interrupt can reach it: there is no pty
    here and therefore no Ctrl-C to type, so the only way to stop the remote
    command is to close the channel under it.
    """

    def __init__(self, chan):
        self.chan = chan
        self.aborted = False

    def abort(self):
        self.aborted = True
        try:
            self.chan.close()
        except Exception:
            pass


class _Session(object):
    """One live remote program behind a pty, framed into request/response.

    Output is streamed, not buffered: a command that runs for minutes and
    prints as it goes (a poller, a tail, a build) must show its lines while it
    runs, not all at once when --wait expires.  So framing works a line at a
    time and every completed line is handed straight to the client.

    One command is one trip round a single select loop (_pump), in the thread
    that asked for it.  The channel, the client's stdin descriptor, the output
    pipe and the request socket are all watched together there, because each
    of them can block and none of them may stop the others: a full output pipe
    must not stop stdin arriving, and a slow producer on stdin must not stop
    output being handed over.  An earlier design ran stdin in a thread of its
    own and polled the channel with a 50 ms blocking recv; this does the same
    work in one place, and wakes the moment anything is ready rather than at
    the next tick.

    The same object also runs commands that do *not* use the shell: --exec
    opens a channel of its own, with no pty, and copies its two streams to
    two pipes (exec_run / _pump_exec).  Those take neither the lock nor the
    pty, so any number of them run at once, alongside whatever the shell is
    doing; they live here only because they share the transport and because
    --interrupt has to be able to reach them.
    """

    def __init__(self, chan, mark, mode, prompt_re, idle, target, command,
                 transport=None, timeout=DEFAULT_TIMEOUT):
        self.chan = chan
        self.mark = mark.encode("utf-8")
        self.mode = mode                  # "shell" or "interactive"
        self.prompt_re = prompt_re        # compiled bytes pattern, or None
        self.idle = idle
        self.target = target
        self.command = command
        # Kept to open the stdin writer channel; the session's own channel
        # cannot carry it, since the pty would read the data as keystrokes.
        self.transport = transport
        self.timeout = timeout
        self.lock = threading.Lock()
        self.started = time.time()
        self.last = self.started
        self.served = 0
        self.dead = None
        # Frames we have asked for but not yet seen the marker of.  A command
        # that timed out leaves one behind, and its marker will still turn up
        # later; without this count the next command would frame on that stale
        # marker and report the stale command's exit status as its own.
        self.outstanding = 0
        # Set to ask an in-flight command to stop.  An interrupt cannot wait
        # for the lock -- the command holding it is exactly what needs
        # interrupting -- so it signals through this instead.
        self.abort = threading.Event()
        # Commands running on channels of their own (--exec).  They do not
        # touch the pty and do not take the lock, so several run at once and
        # --interrupt has to be able to find them.
        self.execs = set()
        self.execs_lock = threading.Lock()

    @property
    def pending(self):
        return self.outstanding > 0

    # -- channel i/o ------------------------------------------------------

    def _write(self, text):
        try:
            self.chan.sendall(text.encode("utf-8"))
        except Exception as exc:
            raise _SessionDead("write failed: %s" % exc)

    def _recv(self):
        try:
            data = self.chan.recv(65536)
        except socket.timeout:
            return None
        except Exception as exc:
            raise _SessionDead("read failed: %s" % exc)
        if data == b"":
            raise _SessionDead("the remote program exited")
        return data

    # -- framing ----------------------------------------------------------

    def _clean(self, line):
        """One line, as the caller should see it."""
        if line.endswith(b"\r"):
            line = line[:-1]
        if self.mode == "interactive":
            line = SESSION_ESC_RE.sub(b"", line)
        return line

    def _marker_payload(self, line):
        """Whatever follows the marker on this line, or None if not a marker."""
        if not line.startswith(self.mark):
            return None
        return line[len(self.mark):]

    def _marker_status(self, line):
        """The exit status if this line is our frame marker, else None.

        A marker whose digits did not survive gives -1 rather than None: it
        still frames the command, we just cannot say how it ended.  Treating
        it as output instead would leak the marker to the caller and leave the
        session one frame out of step.
        """
        payload = self._marker_payload(line)
        if payload is None:
            return None
        return int(payload) if payload.isdigit() else -1

    # -- the loop ---------------------------------------------------------

    def _pump(self, framer, sink, deadline, in_fd=None, in_chan=None,
              conn=None):
        """Drive one command to its end.  Returns (status, timed_out).

        Everything that can block is watched here together, in one thread:

          chan     the remote program's output, framed into the sink
          in_fd    the client's stdin, copied to the writer channel
          sink.wfd the client's output pipe, when it is full and we have more
          conn     the request socket, which says nothing but tells us by
                   going readable that the client has gone

        The channel is dropped from the read set while the sink has a backlog,
        and stdin is dropped while the writer channel has one, so neither side
        is read faster than it can be handed on -- the pressure travels back to
        the remote program through the SSH window instead of piling up here.

        select() is given a tick rather than the whole remaining time because
        --idle, --wait and an interrupt from another thread are all deadlines
        no descriptor will wake us for.
        """
        self.chan.settimeout(0.0)
        if in_chan is not None:
            in_chan.settimeout(0.0)
        pending_in = b""                  # read from stdin, not yet sent on
        in_done = in_fd is None           # no more stdin will come

        while True:
            if not sink.flush():
                raise _ClientGone("the client stopped reading")

            # Push whatever stdin we are holding; a timeout means the remote
            # window is full, so the rest waits for the next turn.
            while pending_in and in_chan is not None:
                try:
                    sent = in_chan.send(pending_in)
                except socket.timeout:
                    break
                except Exception:
                    # The remote reader is gone -- the command ignored its
                    # stdin, or ended early.  Drop the rest, as a pipe does.
                    pending_in, in_fd, in_done = b"", None, True
                    break
                if sent == 0:
                    pending_in, in_fd, in_done = b"", None, True
                    break
                pending_in = pending_in[sent:]
            if in_done and not pending_in and in_chan is not None:
                # End of input -- a real EOF, or the client going away.  The
                # channel's EOF is what the remote command's read() sees as 0.
                try:
                    in_chan.shutdown_write()
                except Exception:
                    pass
                in_chan = None

            rset = [] if sink.backlog >= SESSION_BACKLOG else [self.chan]
            if in_fd is not None and len(pending_in) < SESSION_BACKLOG:
                rset.append(in_fd)
            if conn is not None:
                rset.append(conn)
            wset = [sink.wfd] if sink.backlog and sink.wfd is not None else []

            timeout = SESSION_TICK
            if deadline != float("inf"):
                timeout = max(0.0, min(timeout, deadline - time.time()))
            try:
                ready, _w, _x = select.select(rset, wset, [], timeout)
            except (select.error, InterruptedError):
                ready = []

            if conn is not None and conn in ready:
                # Nothing follows the request on this socket, so the only
                # thing readable can be the end of it: the client is gone.
                # Without this watch a killed client would leave the command
                # waiting on a descriptor that stays readable forever.
                try:
                    alive = bool(conn.recv(65536))
                except (socket.error, OSError):
                    alive = False
                if not alive:
                    raise _ClientGone("the client hung up")

            if in_fd is not None and in_fd in ready:
                try:
                    data = os.read(in_fd, 65536)
                except OSError:
                    data = b""
                if data:
                    pending_in += data
                else:
                    in_fd, in_done = None, True   # the producer is done

            if self.chan in ready:
                data = self._recv()
                if data:
                    done = framer.feed(data, sink)
                    if done is not None:
                        self.outstanding = 0
                        sink.flush()
                        return done

            if self.abort.is_set():
                self.abort.clear()
                return framer.on_abort(sink)

            now = time.time()
            done = framer.idle(sink, now)
            if done is not None:
                return done
            if now >= deadline:
                framer.flush(sink)
                return (None, True)

    def _resync(self):
        """Stop whatever is running and get the shell back to a known state.

        The obvious alternative -- wait for the abandoned command's own marker
        to turn up -- does not work: a command that never ends (a poller, a
        tail -f) never produces one, and waiting for it wedges every later
        command.  So the leftover is interrupted, and a marker carrying a
        one-shot token is requested.  The token is what makes this
        unambiguous: however many stale markers are still in flight, this
        drains past all of them and stops at exactly the right place.
        """
        if self.mode == "interactive":
            self._write("\x03")
            self._drain_interactive()
            return

        for attempt in range(2):
            token = os.urandom(6).hex().encode("ascii")
            if attempt == 0:
                self._write("\x03")
                # The Ctrl-C makes the pty discard whatever input is queued
                # behind it, and a write issued in the same breath is part of
                # that queue: measured, the resync line reached the shell as
                # 'rintf ...', its first byte eaten.  Let the interrupt land.
                time.sleep(0.3)
            self._write(SESSION_RESYNC % token.decode("ascii"))
            if self._await_token(token, 20 if attempt == 0 else 10):
                self.outstanding = 0
                return
        # The shell never answered.  Leave the count set so the next command
        # tries to resynchronise again rather than framing on a stale marker.

    def _await_token(self, token, limit):
        """Read until a marker line carries this token.  True if it came."""
        tail = b""
        deadline = time.time() + limit
        self.chan.settimeout(0.05)
        while time.time() < deadline:
            try:
                data = self._recv()
            except _SessionDead:
                return False
            if not data:
                continue
            tail += data
            lines = tail.split(b"\n")
            tail = lines.pop()
            for raw in lines:
                if self._marker_payload(self._clean(raw)) == token:
                    return True
        return False

    def _prompt_at_end(self, line):
        """Text before the prompt if this line ends with one, else None."""
        found = None
        for found in self.prompt_re.finditer(line[-SESSION_TAIL:]):
            pass
        if found is None or line[-SESSION_TAIL:][found.end():].strip():
            return None
        return line[:len(line) - (min(len(line), SESSION_TAIL) - found.start())]

    # -- stdin forwarding -------------------------------------------------

    def open_stdin_writer(self):
        """Start the channel that will feed one command's stdin.

        Returns (channel, remote fifo path).  The channel's program creates the
        fifo and prints one byte before it blocks opening it, and this waits for
        that byte: the command must not be framed against a path that does not
        exist yet, which fails at once with "No such file or directory".
        """
        if self.transport is None:
            raise _SessionDead("no transport for a stdin channel")
        path = SESSION_IN_PATH % os.urandom(8).hex()
        chan = self.transport.open_session(timeout=self.timeout)
        chan.exec_command(SESSION_WRITER % {"path": path})

        chan.settimeout(max(self.timeout, 1.0))
        seen = b""
        while SESSION_WRITER_READY not in seen:
            try:
                data = chan.recv(64)
            except socket.timeout:
                break
            except Exception as exc:
                chan.close()
                raise _SessionDead("stdin channel failed: %s" % exc)
            if not data:
                break
            seen += data
        if SESSION_WRITER_READY not in seen:
            # No readiness byte: mkfifo is missing, /tmp is read-only, or the
            # target refused the channel.  Say which, since the alternative is
            # a command that mysteriously reports a missing file.
            err = b""
            try:
                if chan.recv_stderr_ready():
                    err = chan.recv_stderr(200)
            except Exception:
                pass
            chan.close()
            raise _SessionDead(
                "could not set up a stdin channel on the target (mkfifo in "
                "/tmp must work)%s" % (": %s" % err.decode("utf-8", "replace").strip()
                                       if err.strip() else "")
            )
        return chan, path

    @staticmethod
    def close_stdin_writer(chan):
        """Shut the writer channel down, which is what the remote sees as EOF."""
        if chan is None:
            return
        try:
            chan.shutdown_write()
        except Exception:
            pass
        try:
            chan.close()
        except Exception:
            pass

    # -- a command on a channel of its own --------------------------------

    def exec_run(self, line, wait, out_sink, err_sink, in_fd=None, conn=None):
        """Run one command on a new channel, outside the session's shell.

        Nothing here touches the pty: a fresh channel is opened, the command
        runs on it with no terminal at all, and its two streams are copied to
        two sinks.  That means no framing -- there is no marker to look for,
        because the channel's own exit status says when the command ended and
        which code it ended with -- and no carriage returns to strip, because
        no line discipline ever saw the bytes.  stdout and stderr stay apart
        for the same reason.

        What is given up is the session itself: open_session starts a new
        process on the target, so the shell's working directory, variables,
        functions and background jobs do not apply.  Only the chain is shared.
        Because the pty lock is not taken, several of these run at once, and
        one may run while the session's shell is busy with something else.

        A command that ends any way but normally -- a timeout, an interrupt, a
        client that walked away -- is killed rather than abandoned: the finally
        below closes the channel, and the server ends the command with it.
        That is the opposite of a shell command, which has no channel of its
        own to close and so keeps running on the pty until something stops it;
        there is nothing here for a later command to collide with, so there is
        no reason to leave one running with nobody watching.
        """
        if self.transport is None:
            raise _SessionDead("no transport for a command channel")
        try:
            chan = self.transport.open_session(timeout=self.timeout)
        except Exception as exc:
            raise _SessionDead("could not open a channel: %s" % exc)

        job = _ExecJob(chan)
        with self.execs_lock:
            self.execs.add(job)
        self.served += 1
        try:
            chan.settimeout(0.0)
            try:
                chan.exec_command(line)
            except Exception as exc:
                raise _SessionDead("could not start the command: %s" % exc)
            return self._pump_exec(job, out_sink, err_sink, time.time() + wait,
                                   in_fd=in_fd, conn=conn)
        finally:
            with self.execs_lock:
                self.execs.discard(job)
            try:
                chan.close()
            except Exception:
                pass
            self.last = time.time()

    def _pump_exec(self, job, out_sink, err_sink, deadline, in_fd=None,
                   conn=None):
        """Drive one --exec command to its end.  Returns (status, timed_out).

        The same shape as _pump: one select over everything that can block,
        in the thread that asked for it.  The differences are all consequences
        of there being no pty -- the client's stdin goes straight down this
        channel rather than through a fifo, stderr is a stream of its own, and
        the end is the channel's exit status rather than a printed marker.
        """
        chan = job.chan
        pending_in = b""
        in_done = in_fd is None
        in_closed = False
        out_eof = err_eof = False

        while True:
            for sink in (out_sink, err_sink):
                if not sink.flush():
                    raise _ClientGone("the client stopped reading")

            # Push whatever stdin we are holding; a timeout means the remote
            # window is full, so the rest waits for the next turn.
            while pending_in:
                try:
                    sent = chan.send(pending_in)
                except socket.timeout:
                    break
                except Exception:
                    pending_in, in_fd, in_done = b"", None, True
                    break
                if sent == 0:
                    pending_in, in_fd, in_done = b"", None, True
                    break
                pending_in = pending_in[sent:]
            if in_done and not pending_in and not in_closed:
                # End of input: the channel's EOF is what the remote command's
                # read() sees as 0.
                in_closed = True
                try:
                    chan.shutdown_write()
                except Exception:
                    pass

            backed_up = (out_sink.backlog >= SESSION_BACKLOG
                         or err_sink.backlog >= SESSION_BACKLOG)
            rset = [] if backed_up else [chan]
            if in_fd is not None and len(pending_in) < SESSION_BACKLOG:
                rset.append(in_fd)
            if conn is not None:
                rset.append(conn)
            wset = [s.wfd for s in (out_sink, err_sink)
                    if s.backlog and s.wfd is not None]

            timeout = SESSION_TICK
            if deadline != float("inf"):
                timeout = max(0.0, min(timeout, deadline - time.time()))
            try:
                ready, _w, _x = select.select(rset, wset, [], timeout)
            except (select.error, InterruptedError):
                ready = []

            if conn is not None and conn in ready:
                try:
                    alive = bool(conn.recv(65536))
                except (socket.error, OSError):
                    alive = False
                if not alive:
                    raise _ClientGone("the client hung up")

            if in_fd is not None and in_fd in ready:
                try:
                    data = os.read(in_fd, 65536)
                except OSError:
                    data = b""
                if data:
                    pending_in += data
                else:
                    in_fd, in_done = None, True   # the producer is done

            if not backed_up:
                # Both streams share one channel and one window, so neither is
                # read ahead of the other: drain whatever has arrived of each.
                try:
                    if not out_eof:
                        out_eof = self._drain_stream(
                                chan.recv_ready, chan.recv, out_sink)
                    if not err_eof:
                        err_eof = self._drain_stream(
                                chan.recv_stderr_ready, chan.recv_stderr,
                                err_sink)
                except socket.timeout:
                    pass
                except Exception as exc:
                    if not job.aborted:
                        raise _SessionDead("read failed: %s" % exc)

            if job.aborted:
                # --interrupt closed the channel under us; there is no pty to
                # type a Ctrl-C into, so that is the only way to stop it.
                return (130, False)

            # Both streams have to be quiet before the status is taken: the
            # exit status arrives on the channel while output may still be
            # buffered in it, and returning on the status alone truncates the
            # tail of a command that printed right before exiting.
            quiet = ((out_eof or not chan.recv_ready())
                     and (err_eof or not chan.recv_stderr_ready()))
            if not backed_up and quiet and chan.exit_status_ready():
                try:
                    status = chan.recv_exit_status()
                except Exception:
                    status = -1
                return (status if status is not None and status >= 0
                        else -1, False)

            if time.time() >= deadline:
                return (None, True)

    @staticmethod
    def _drain_stream(ready, read, sink):
        """Copy what has arrived on one of a channel's streams.  True at EOF.

        Read until the stream has nothing more for now, rather than once per
        turn: one select wakeup can cover several packets, and leaving them
        for the next turn would hold output back by a tick each time.
        """
        while ready():
            data = read(65536)
            if not data:
                return True
            sink.write(data)
        return False

    def interrupt_execs(self):
        """Stop every --exec command running on its own channel.

        Closing the channel is the whole mechanism: without a pty there is no
        Ctrl-C to deliver, and the server kills the command when its channel
        goes.
        """
        with self.execs_lock:
            jobs = list(self.execs)
        for job in jobs:
            job.abort()
        return len(jobs)

    # -- operations -------------------------------------------------------

    def run(self, line, wait, sink, in_path=None, in_fd=None, in_chan=None,
            conn=None):
        """Run one command to its end.  Returns (status, timed_out).

        Output goes to the sink as it is produced, which for a client command
        is the pipe it handed over with its request.

        in_path is the remote fifo the writer channel has already created, and
        in_fd/in_chan are the two ends this loop copies between; all three are
        None to leave the command reading /dev/null.  They only apply in shell
        mode -- an interactive program owns the pty, so its input is the
        command line itself.

        conn is the request socket, watched only so a client that goes away
        does not leave the command running with nobody to hand its output to.

        The pty lock is held for the command's whole life, since two commands
        interleaved on one pty would each read the other's output.
        """
        with self.lock:
            self.abort.clear()
            if self.outstanding:
                # A previous command timed out and may still be running.  It
                # has to be stopped before this one starts, or its output would
                # be mixed into ours and its marker would frame us early.
                self._resync()
            if self.mode == "shell":
                self._write(session_frame(line, in_path))
                framer = _ShellFramer(self)
            else:
                self._write(line.rstrip("\r\n") + "\n")
                framer = _InteractiveFramer(self)
            self.outstanding = 1
            self.served += 1

            try:
                status, timed_out = self._pump(
                    framer, sink, time.time() + wait,
                    in_fd=in_fd, in_chan=in_chan, conn=conn)
            finally:
                self.last = time.time()
            if not timed_out:
                self.outstanding = 0
            return status, timed_out

    def interrupt_running(self):
        """Ctrl-C.  Returns True if a command was in flight and was signalled.

        Deliberately does not take the lock when something is running: the
        command holding it is the one that needs interrupting.  Writing into
        the pty while another thread reads from it is safe.
        """
        if self.lock.acquire(False):
            try:
                if self.outstanding:
                    # A timed-out command, still running with nobody watching.
                    self._resync()
                    return True
                # Nothing running: the Ctrl-C only clears the remote line
                # editor, but resync anyway so a half-typed state cannot
                # linger into the next command.
                self._resync()
                self.last = time.time()
                return False
            finally:
                self.lock.release()
        self.abort.set()
        return True

    def _drain_interactive(self):
        """Discard what an abandoned interactive command left behind.

        There is no marker to aim at here -- an arbitrary program has no exit
        codes to report -- so this reads until the output stops, which is the
        same heuristic --prompt exists to replace during normal operation.
        """
        self.chan.settimeout(0.05)
        quiet_for = max(self.idle, 0.2)
        last_data = time.time()
        deadline = time.time() + 10
        while time.time() < deadline:
            try:
                data = self._recv()
            except _SessionDead:
                break
            if data:
                last_data = time.time()
            elif time.time() - last_data >= quiet_for:
                break
        self.outstanding = 0

    def setup(self, wait):
        """Bring the program to a known state; return its banner.

        The same loop as a real command, with the output collected here rather
        than written to a client: nobody is connected yet.
        """
        sink = _BufSink()
        if self.mode == "interactive":
            limit = wait if self.prompt_re is not None else max(self.idle * 4, 1.0)
            self._pump(_InteractiveFramer(self), sink, time.time() + limit)
            return sink.value()

        self._write(SESSION_SETUP % self.mark.decode("ascii"))
        blob = base64.b64encode(b"echo ready").decode("ascii")
        self._write(SESSION_FRAME % blob)
        self.outstanding = 1
        status, timed_out = self._pump(_ShellFramer(self), sink,
                                       time.time() + wait)
        out = sink.value()
        if timed_out or status is None:
            raise SystemExit(
                "mssh: the remote shell never answered; it may not be a "
                "POSIX shell (got %r)" % out[-200:]
            )
        if b"ready" not in out:
            raise SystemExit(
                "mssh: the remote shell cannot decode base64 -- a 'base64' "
                "command is required on the target for session mode (got %r)"
                % out[-200:]
            )
        return b""


# -- wire protocol ---------------------------------------------------------
#
# One request per connection, so a wedged request cannot block the socket for
# everyone else.  The socket carries JSON and nothing else, in both directions:
# the request is one line of it, and the reply is exactly one more line.
#
# The command's output does not travel on the socket at all.  It goes over a
# pipe the *client* creates and whose write end it hands over with the request
# (SCM_RIGHTS), so the daemon copies the remote program's bytes straight into
# it and the client reads them straight out.  Nothing is framed, so nothing has
# to be encoded: the earlier design wrapped every line in {"out": <base64>},
# which cost a JSON encode and decode and a base64 round trip per line of a
# build's output.  A pipe also streams for free -- the bytes are readable the
# moment they are written -- which is what the stream of messages existed to
# provide.
#
# Descriptors ride with an "op": "send" request, in this order:
#
#     fds[0]   the write end of the client's output pipe   (always)
#     fds[1]   the client's own stdin, for "stdin": true   (optional)
#
# "op": "exec" is the same exchange for a command that runs on a channel of
# its own rather than in the session's shell.  It carries one descriptor more,
# because without a pty the two output streams were never merged:
#
#     fds[0]   the write end of the client's stdout pipe   (always)
#     fds[1]   the write end of the client's stderr pipe   (always)
#     fds[2]   the client's own stdin, for "stdin": true   (optional)
#
# Its reply is the same single status message, and its stdin needs no fifo:
# the command's own channel carries it natively, since no pty is in the way.
#
# stdin is passed the same way rather than being written down the socket: the
# data is a byte stream of unknown length that must reach the remote command as
# it arrives ('tail -f | mssh --session s cat' has to work), and reading the
# producer's descriptor directly means no relay, no half-close protocol and no
# second thread.
#
# The command's end is the one thing that is still a message, because it is one
# fact rather than a stream: {"status": N, "timed_out": bool, "end": true}, or
# {"error": "..."}.  The daemon closes the output pipe *before* sending it, so
# by the time the client reads the status its output is already complete at the
# EOF on the pipe.
#
# On a send the client does not half-close its end of the socket, and the
# daemon does not read from it: the socket going readable can then only mean
# the client has gone, which is how a command notices that nobody is listening
# any more.  status, stop and interrupt are a plain request, half-close, one
# reply.


def _reply(conn, payload):
    """The daemon's one JSON line, and the half-close that ends the exchange."""
    try:
        conn.sendall(json.dumps(payload).encode("utf-8") + b"\n")
        conn.shutdown(socket.SHUT_WR)
    except (socket.error, OSError):
        pass


def _connect_session(name, timeout):
    import errno

    path = session_path(name)
    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    conn.settimeout(timeout)
    try:
        conn.connect(path)
    except socket.timeout:
        conn.close()
        raise SystemExit("mssh: session %s: timed out connecting to the "
                         "session daemon" % name)
    except (socket.error, OSError) as exc:
        conn.close()
        if exc.errno in (errno.ENOENT, errno.ECONNREFUSED):
            raise SessionGone(path)
        raise SystemExit("mssh: session %s: %s" % (name, exc))
    return conn


def _parse_reply(name, raw):
    """One line of the daemon's JSON, or a SystemExit naming what came back."""
    try:
        return json.loads(raw.decode("utf-8", "replace"))
    except ValueError:
        raise SystemExit("mssh: session %s: malformed reply from the session "
                         "daemon" % name)


def session_request(name, payload, timeout=None):
    """Send one request, half-close, and return the daemon's single reply.

    What --status, --stop, --interrupt and the liveness probe use: one line of
    JSON each way, nothing streamed.  A command's output does not come back
    this way -- see session_send.
    """
    conn = _connect_session(name, timeout)
    buf = b""
    try:
        conn.sendall(json.dumps(payload).encode("utf-8") + b"\n")
        conn.shutdown(socket.SHUT_WR)
        while b"\n" not in buf:
            try:
                data = conn.recv(65536)
            except socket.timeout:
                raise SystemExit("mssh: session %s: the session daemon "
                                 "stopped responding" % name)
            except ConnectionResetError:
                # The daemon closed the moment its reply was out.  The request
                # was fully read long before, so nothing of ours was lost, and
                # a reset is not an error of its own.
                break
            if not data:
                break
            buf += data
    finally:
        conn.close()

    line = buf.split(b"\n", 1)[0].strip()
    if not line:
        raise SystemExit("mssh: session %s: the session daemon closed the "
                         "connection without replying" % name)
    return _parse_reply(name, line)


def _session_pipes(name, payload, outputs, send_stdin=False):
    """Run one command behind N pipes: copy each to its stream, return the end.

    The output does not come back over the socket.  A pipe per stream is
    created here and its write end handed to the daemon with the request, so
    the remote program's bytes are copied into it and read out of it unchanged
    -- no framing, no base64, no JSON per line.  With send_stdin the local
    stdin descriptor goes the same way and the daemon feeds the command from
    it directly.

    outputs names the local streams, in the order the daemon expects the
    descriptors: one (merged output) for a session send, two (stdout, stderr)
    for an --exec.  Every end is watched until it is finished: each pipe until
    EOF, which is what says that stream is complete, and the socket until its
    one status message arrives.  The daemon closes the pipes first, so no
    order of arrival loses anything.

    The write side is deliberately left open.  The daemon reads nothing from
    it, so the socket becoming readable on its end means only one thing -- this
    process has gone -- which is how an abandoned command gets noticed.
    """
    conn = _connect_session(name, None)
    pipes = []                            # [(rfd, stream)], in request order
    wfds = []
    buf = b""
    try:
        for stream in outputs:
            rfd, wfd = os.pipe()
            pipes.append([rfd, stream])
            wfds.append(wfd)

        line = json.dumps(payload).encode("utf-8") + b"\n"
        fds = list(wfds)
        if send_stdin:
            fd = stdin_fd()
            if fd is None:
                raise SystemExit("mssh: session %s: stdin was requested but "
                                 "there is none to pass" % name)
            fds.append(fd)
        sent = conn.sendmsg([line],
                            [(socket.SOL_SOCKET, socket.SCM_RIGHTS,
                              array.array("i", fds).tobytes())])
        if sent < len(line):
            # A request longer than the socket buffer went out in part; the
            # descriptors rode on its first byte, the rest is plain.
            conn.sendall(line[sent:])
        while wfds:                       # the daemon holds the only write end
            os.close(wfds.pop())

        conn.settimeout(None)
        watch = [rfd for rfd, _stream in pipes] + [conn]
        while watch:
            try:
                ready, _w, _x = select.select(watch, [], [])
            except (select.error, InterruptedError):
                continue
            for rfd, stream in pipes:
                if rfd not in ready:
                    continue
                try:
                    data = os.read(rfd, 65536)
                except OSError:
                    data = b""
                if data:
                    stream.write(data)
                    stream.flush()
                else:
                    watch.remove(rfd)     # EOF: that stream is complete
            if conn in ready:
                try:
                    data = conn.recv(65536)
                except (socket.error, OSError):
                    data = b""
                if data:
                    buf += data
                    if b"\n" in buf:
                        watch.remove(conn)
                else:
                    watch.remove(conn)
    finally:
        for wfd in wfds:
            os.close(wfd)
        for rfd, _stream in pipes:
            os.close(rfd)
        conn.close()

    line = buf.split(b"\n", 1)[0].strip()
    if not line:
        raise SystemExit("mssh: session %s: the session daemon closed the "
                         "connection without replying" % name)
    return _parse_reply(name, line)


def session_send(name, payload, send_stdin=False):
    """Run one command in the session's shell; its output is already merged."""
    return _session_pipes(name, payload, [sys.stdout.buffer],
                          send_stdin=send_stdin)


def session_exec(name, payload, send_stdin=False):
    """Run one command on a channel of its own, stdout and stderr apart.

    Two pipes rather than one: without a pty the remote command's streams are
    never merged, so they are carried separately all the way to this process's
    own stdout and stderr, which is what lets 'mssh --session s --exec cmd
    2>/dev/null' do what it says.
    """
    return _session_pipes(name, payload,
                          [sys.stdout.buffer, sys.stderr.buffer],
                          send_stdin=send_stdin)


def session_alive(name):
    try:
        session_request(name, {"op": "status"}, timeout=10.0)
        return True
    except SessionGone:
        return False


# -- daemon ----------------------------------------------------------------


def _session_lock():
    """Hold the spawn window: probe, clear a stale socket, bind.

    Without it two simultaneous first calls could both find no daemon, both
    unlink and both bind.  Once the socket is listening it is its own guard, so
    the lock is released as soon as bind() returns.

    One shared lock file rather than one per session: spawns are brief and
    rare, so serializing them all costs nothing, and a per-name file would
    litter the directory with a lock for every session ever started -- there is
    no safe moment to delete one of those, since another process may be
    holding it.
    """
    import fcntl
    fd = os.open(os.path.join(session_dir(), ".spawn.lock"),
                 os.O_CREAT | os.O_RDWR, 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def _session_listen(name):
    """Create the listening socket for a new session, 0600."""
    path = session_path(name)
    lock_fd = _session_lock()
    try:
        if session_alive(name):
            raise SystemExit(
                "mssh: session %r is already running; --status to inspect "
                "it, --stop to end it" % name
            )
        try:
            os.unlink(path)               # a stale socket from a killed daemon
        except OSError:
            pass
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        old = os.umask(0o177)
        try:
            srv.bind(path)
        finally:
            os.umask(old)
        os.chmod(path, 0o600)
        srv.listen(16)
    finally:
        os.close(lock_fd)
    return srv, path


def _ready(fd, payload):
    try:
        os.write(fd, json.dumps(payload).encode("utf-8") + b"\n")
    except OSError:
        pass
    try:
        os.close(fd)
    except OSError:
        pass


def _session_predetach():
    """Prepare the daemon-to-be, but keep the controlling terminal.

    Called in the forked child before the chain is built.  Deliberately does
    NOT setsid yet: setsid destroys the controlling terminal (measured --
    /dev/tty stops opening immediately afterwards), and the chain still has to
    be able to ask for a password.  connect_hop's getpass reads /dev/tty, so it
    works here and would fail on the far side of a setsid.

    stdin, stdout and stderr are all left alone for the same reason, plus one
    more: -v logs the chain being built, and redirecting stderr here would send
    exactly the interesting part to a file while the terminal showed only the
    last line.  _session_detach() takes all of it away once the session is up.
    """
    os.chdir("/")
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)


def _session_detach(name, opts):
    """Become a daemon for real: leave the session, drop the std fds.

    Split from _session_predetach because everything here has to happen after
    the chain is built: setsid gives up the controlling terminal, so no
    password can be asked for beyond this point.

    Under -v, stderr goes on to <session>.log.  That is decided here rather
    than by the caller because this is the only place it matters, and the log
    therefore holds only what happens after this moment -- the startup trace
    has already gone to the terminal.

    There is deliberately no second fork here.  The usual reason for one is to
    guarantee the daemon can never reacquire a controlling terminal, but it
    would have to happen after paramiko's threads exist, and forking a
    multi-threaded process is exactly what this design goes out of its way to
    avoid (Python warns about it, too).  setsid alone already detaches us; the
    session leader could only reacquire a terminal by opening one deliberately,
    which nothing here does.
    """
    sys.stdout.flush()
    sys.stderr.flush()

    os.setsid()

    null = os.open(os.devnull, os.O_RDWR)
    os.dup2(null, 0)
    os.dup2(null, 1)
    if opts.verbose:
        out = os.open(os.path.join(session_dir(), name + ".log"),
                      os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        os.dup2(out, 2)
        os.close(out)
    else:
        os.dup2(null, 2)
    if null > 2:
        os.close(null)


def _session_serve(session, srv, path, clients, opts):
    """Answer requests until stopped, the program dies, or idle expires."""
    state = {"stop": False}

    def handle(conn):
        held = []            # the descriptors sent with the request, while ours
        try:
            uid = _peer_uid(conn)
            if uid is not None and uid != os.getuid():
                # Before the request is even read: a foreign uid must not get
                # as far as handing us descriptors.
                _reply(conn, {"error": "mssh: permission denied: uid %d is "
                                       "not the session owner" % uid})
                return
            conn.settimeout(30.0)
            data = b""
            while b"\n" not in data:
                chunk, ancdata, _flags, _addr = conn.recvmsg(
                        65536,
                        socket.CMSG_SPACE(SESSION_MAX_FDS
                                          * array.array("i").itemsize))
                for level, ctype, cred in ancdata:
                    if level == socket.SOL_SOCKET and ctype == socket.SCM_RIGHTS:
                        # A send carries the output pipe and, with stdin, the
                        # client's producer.  Anything beyond those is not part
                        # of the protocol: close it rather than leak it.
                        fds = array.array("i")
                        fds.frombytes(cred[:len(cred) - (len(cred) % fds.itemsize)])
                        for one in fds:
                            if len(held) < SESSION_MAX_FDS:
                                held.append(one)
                            else:
                                os.close(one)
                if not chunk:
                    break
                data += chunk
            if not data.strip():
                return
            req = json.loads(data.split(b"\n", 1)[0].decode("utf-8"))
            # Nothing else is read from this socket: the output pipe and stdin
            # are the descriptors above, and what remains is one JSON reply.
            dispatch(conn, req, held)
        except Exception as exc:                          # never kill the loop
            _reply(conn, {"error": "mssh: session daemon: %s" % exc})
        finally:
            for one in held:
                if one is not None:
                    try:
                        os.close(one)     # never taken over: leak nothing
                    except OSError:
                        pass
            try:
                conn.close()
            except Exception:
                pass

    def dispatch(conn, req, held):
        """Handle one request.

        held holds the descriptors that arrived with it -- for a send, the
        output pipe's write end and (with stdin) the client's own stdin; for an
        exec, stdout, stderr and the same optional stdin.  Each is taken out of
        the list by whoever becomes responsible for closing it; handle()'s
        finally closes whatever is left, so no path can leak one.  A descriptor
        kept open by mistake is not harmless: the client's producer (a 'yes'
        pipe) would be held for as long as the daemon lives.
        """
        def take(index):
            if index < len(held):
                fd, held[index] = held[index], None
                return fd
            return None

        def drop():
            for index in range(len(held)):
                fd = take(index)
                if fd is not None:
                    os.close(fd)

        op = req.get("op")
        if op not in ("send", "exec"):
            drop()
        if op == "status":
            _reply(conn, {
                "target": str(session.target), "command": session.command,
                "mode": session.mode, "started": session.started,
                "served": session.served, "pid": os.getpid(),
                "dead": session.dead, "running": session.lock.locked(),
            })
            return
        if op == "stop":
            state["stop"] = True
            _reply(conn, {"ok": True})
            return
        if op not in ("send", "exec", "interrupt"):
            _reply(conn, {"error": "mssh: unknown request %r" % (op,)})
            return
        if session.dead:
            drop()
            _reply(conn, {"error": "mssh: session ended: %s" % session.dead})
            return

        if op == "interrupt":
            try:
                signalled = session.interrupt_running()
            except _SessionDead as exc:
                die(str(exc))
                _reply(conn, {"error": "mssh: session ended: %s" % exc})
                return
            # An --exec command has no pty to type a Ctrl-C into, so it is
            # stopped by closing its channel; either kind counts as a command
            # that was interrupted.
            signalled = bool(session.interrupt_execs()) or signalled
            # Whatever output the interrupt produced belongs to the client
            # that is still streaming the interrupted command, not to this
            # one, so there is nothing to return but the fact of it.
            _reply(conn, {"interrupted": signalled, "status": None,
                          "timed_out": False})
            return

        wait = req.get("wait")
        wait = DEFAULT_SESSION_WAIT if wait is None else float(wait)
        if wait <= 0:
            wait = float("inf")           # --wait 0: until it ends or Ctrl-C
        with_stdin = bool(req.get("stdin"))

        if op == "exec":
            dispatch_exec(conn, req, take, wait, with_stdin)
            return

        if with_stdin and session.mode != "shell":
            # Interactive mode has nowhere safe to put it.  The program owns
            # the pty, so input could only be typed at it, and a pty in
            # canonical mode truncates a line at 4095 bytes and reads control
            # bytes as signals -- measured, a 0x03 in the data killed the
            # program.  Silently dropping the data would be worse: the command
            # would appear to work while reading nothing.
            drop()
            _reply(conn, {"error":
                          "mssh: this session holds an interactive program "
                          "(-c %s), whose input is the command line itself; "
                          "stdin cannot be forwarded to it"
                          % (session.command or "")})
            return
        out_fd = take(0)
        if out_fd is None:
            # Every send owes an output pipe with its request; missing, it is a
            # mismatch between client and running daemon.
            _reply(conn, {"error": "mssh: no output pipe came with the "
                                   "request; the running daemon is older than "
                                   "this client -- --stop the session and "
                                   "start it again"})
            return
        in_fd = take(1) if with_stdin else None
        if with_stdin and in_fd is None:
            os.close(out_fd)
            _reply(conn, {"error": "mssh: stdin was requested but no "
                                   "descriptor came with it; the running "
                                   "daemon is older than this client -- "
                                   "--stop the session and start it again"})
            return

        in_chan, in_path = None, None
        try:
            if with_stdin:
                # Open the writer channel *before* the command is framed: it is
                # what creates the fifo, and a command framed against a path
                # that does not exist yet fails at once with "No such file or
                # directory".
                try:
                    in_chan, in_path = session.open_stdin_writer()
                except _SessionDead as exc:
                    _reply(conn, {"error": "mssh: %s" % exc})
                    return

            # The output pipe is written from the one loop below, which must
            # never block on it: a client that stopped reading would otherwise
            # stop the channel being read and pin the pty lock with it.
            os.set_blocking(out_fd, False)
            sink = _FdSink(out_fd)

            try:
                status, timed_out = session.run(
                    req.get("line", ""), wait, sink, in_path=in_path,
                    in_fd=in_fd, in_chan=in_chan, conn=conn)
            except _SessionDead as exc:
                die(str(exc))
                _reply(conn, {"error": "mssh: session ended: %s" % exc})
                return
            except _ClientGone:
                return                    # nobody left to tell
            # Whatever the pipe was too full to take is still output: hand it
            # over before the descriptor goes, or a slow client loses the tail.
            sink.drain()
        finally:
            # The command is over, so nothing will read the fifo again: closing
            # the writer releases the remote 'cat' even if it is still being
            # fed, which is what makes 'yes | mssh --session s "echo hi"' end
            # instead of streaming forever.
            session.close_stdin_writer(in_chan)
            for fd in (out_fd, in_fd):
                if fd is not None:
                    try:
                        os.close(fd)
                    except OSError:
                        pass

        # The pipe is closed above, so the client has already seen the end of
        # the output by the time this arrives.
        _reply(conn, {"status": status, "timed_out": timed_out, "end": True})

    def dispatch_exec(conn, req, take, wait, with_stdin):
        """Run one command on a channel of its own, outside the shell.

        Three descriptors instead of two, because without a pty the command's
        streams were never merged: fds[0] is stdout, fds[1] is stderr, and
        fds[2] is the client's stdin when it asked for one.  stdin needs no
        fifo and no writer channel here -- the command's own channel carries
        it -- so there is far less to set up and far less to take down.
        """
        out_fd, err_fd = take(0), take(1)
        if out_fd is None or err_fd is None:
            for fd in (out_fd, err_fd):
                if fd is not None:
                    os.close(fd)
            _reply(conn, {"error": "mssh: --exec needs two output pipes with "
                                   "the request; the running daemon is older "
                                   "than this client -- --stop the session "
                                   "and start it again"})
            return
        in_fd = take(2) if with_stdin else None
        if with_stdin and in_fd is None:
            os.close(out_fd)
            os.close(err_fd)
            _reply(conn, {"error": "mssh: stdin was requested but no "
                                   "descriptor came with it; the running "
                                   "daemon is older than this client -- "
                                   "--stop the session and start it again"})
            return

        try:
            # Both pipes are written from the one loop below, which must never
            # block on either: a client reading stdout while ignoring stderr
            # would otherwise stop the channel being read at all.
            os.set_blocking(out_fd, False)
            os.set_blocking(err_fd, False)
            out_sink, err_sink = _FdSink(out_fd), _FdSink(err_fd)

            try:
                status, timed_out = session.exec_run(
                    req.get("line", ""), wait, out_sink, err_sink,
                    in_fd=in_fd, conn=conn)
            except _SessionDead as exc:
                # A channel that could not be opened says nothing about the
                # session's own shell, which is a different channel and may
                # well still be fine; do not take the session down for it.
                _reply(conn, {"error": "mssh: --exec: %s" % exc})
                return
            except _ClientGone:
                return                    # nobody left to tell
            # Whatever a pipe was too full to take is still output: hand it
            # over before the descriptor goes, or a slow client loses a tail.
            out_sink.drain()
            err_sink.drain()
        finally:
            for fd in (out_fd, err_fd, in_fd):
                if fd is not None:
                    try:
                        os.close(fd)
                    except OSError:
                        pass

        # Both pipes are closed above, so the client has already seen the end
        # of each stream by the time this arrives.
        _reply(conn, {"status": status, "timed_out": timed_out, "end": True})

    def die(reason):
        session.dead = reason
        state["stop"] = True

    srv.settimeout(1.0)
    try:
        while not state["stop"]:
            try:
                conn, _addr = srv.accept()
            except socket.timeout:
                if session.dead or session.chan.exit_status_ready():
                    break
                if opts.session_idle > 0 and \
                        time.time() - session.last > opts.session_idle:
                    verbose(opts, "session idle for %gs, exiting"
                            % opts.session_idle)
                    break
                continue
            except OSError:
                break
            worker = threading.Thread(target=handle, args=(conn,))
            worker.daemon = True
            worker.start()
    finally:
        try:
            srv.close()
        except Exception:
            pass
        try:
            os.unlink(path)
        except OSError:
            pass
        try:
            session.chan.close()
        except Exception:
            pass
        close_all(clients)


def serve_session(name, srv, path, readyfd, jumps, target, opts):
    """The daemon: build the chain, detach, then serve.

    Runs in the forked child, which still has the terminal: build_chain may
    need to ask for a password, and its -v trace belongs on the screen.  Only
    once the session is up does this detach for good.
    """
    clients = []
    try:
        clients, tgt = build_chain(jumps, target, opts)
        chan = tgt.get_transport().open_session(timeout=opts.timeout)
        chan.get_pty(term=SESSION_TERM, width=SESSION_COLS,
                     height=SESSION_ROWS)
        program = opts.command or SESSION_SHELL
        # 'exec' makes the program the channel's process leader, so a Ctrl-C
        # written into the pty reaches it; 'stty -echo' stops our own input
        # from coming straight back as output.
        chan.exec_command("stty -echo 2>/dev/null; exec " + program)

        mark = "__MSSH_%s__" % os.urandom(8).hex()
        prompt_re = re.compile(opts.prompt.encode("utf-8")) if opts.prompt else None
        session = _Session(chan, mark,
                           "interactive" if opts.command else "shell",
                           prompt_re, opts.idle, target, opts.command,
                           tgt.get_transport(), opts.timeout)
        banner = session.setup(opts.wait)
    except SystemExit as exc:
        # A SystemExit carries its own message and nothing has printed it yet
        # -- raising it is how mssh reports a failed hop -- so print it here,
        # on the terminal we still hold.  The parent only needs to know that we
        # failed; it deliberately says nothing more, or the same failure would
        # appear twice.
        message = str(exc).rstrip("\n")
        if message and message != "None":
            sys.stderr.write(message + "\n")
            sys.stderr.flush()
        _ready(readyfd, {"ok": False})
        close_all(clients)
        return 1
    except BaseException as exc:
        # Same reasoning: we still have the terminal, so report here.  The type
        # is included because an unexpected exception's str() is often empty.
        sys.stderr.write("mssh: session %s: %s: %s\n"
                         % (name, type(exc).__name__, exc))
        sys.stderr.flush()
        _ready(readyfd, {"ok": False})
        close_all(clients)
        return 1

    verbose(opts, "session %s ready, pid %d" % (name, os.getpid()))
    banner64 = base64.b64encode(banner).decode("ascii")

    # Detach before signalling readiness, not after: the parent exits the
    # moment it hears, and its shell then prints a prompt.  Anything we wrote
    # to the terminal after that would land on top of it.
    _session_detach(name, opts)
    _ready(readyfd, {"ok": True, "banner": banner64})

    verbose(opts, "session %s: serving on %s, everything below happened after "
                  "startup" % (name, path))
    _session_serve(session, srv, path, clients, opts)
    return 0


def run_session_spawn(name, jumps, target, opts):
    """Start a session daemon in the background and wait for it to be ready.

    The child keeps stdin and the terminal until the chain is up, so a hop that
    needs a password can still ask for one.  That is why there is no separate
    "collect the passwords first" step: connect_hop's own prompting works, in
    the process that actually needs the answer.
    """
    srv, path = _session_listen(name)
    readfd, writefd = os.pipe()

    # Fork before paramiko builds anything: a Transport starts threads, and
    # only the forking thread survives into the child -- measured, the channel
    # times out in a child forked from a process with a live transport.
    pid = os.fork()
    if pid == 0:
        os.close(readfd)
        try:
            _session_predetach()
            serve_session(name, srv, path, writefd, jumps, target, opts)
        except BaseException:
            try:
                os.unlink(path)
            except OSError:
                pass
        finally:
            os._exit(0)

    os.close(writefd)
    srv.close()
    return _await_session(name, readfd, pid, opts)


def _await_session(name, readfd, pid, opts):
    chunks = []
    while True:
        try:
            chunk = os.read(readfd, 4096)
        except OSError:
            break
        if not chunk:
            break
        chunks.append(chunk)
    os.close(readfd)
    # The daemon is our direct child and outlives us, so it cannot be reaped
    # here; only a failed one has already exited.  WNOHANG collects that case
    # without blocking on the one that succeeded.
    try:
        os.waitpid(pid, os.WNOHANG)
    except OSError:
        pass

    raw = b"".join(chunks).strip()
    if not raw:
        # The daemon keeps stderr until it is serving, so whatever killed it
        # has already been printed; there is nothing to point at.
        sys.stderr.write("mssh: session %s: the session daemon exited before "
                         "it was ready\n" % name)
        return 1
    try:
        info = json.loads(raw.decode("utf-8", "replace"))
    except ValueError:
        sys.stderr.write("mssh: session %s: the session daemon sent garbage\n"
                         % name)
        return 1
    if not info.get("ok"):
        # serve_session still had the terminal when it failed, so it printed
        # the reason itself, in full.  Relaying a summary of it here would only
        # print the same failure twice.
        return 1

    banner = base64.b64decode(info.get("banner") or "")
    if banner:
        sys.stdout.buffer.write(banner if banner.endswith(b"\n")
                                else banner + b"\n")
        sys.stdout.buffer.flush()
    verbose(opts, "session %s listening on %s" % (name, session_path(name)))
    return 0


# -- client ----------------------------------------------------------------


def _no_session(name):
    raise SystemExit(
        "mssh: no session %r; start one with:\n"
        "    mssh --session %s [-j <jump>...] <target>" % (name, name)
    )


def run_session_send(name, line, opts):
    """Stream one command's output to stdout, then exit with its status.

    With --exec the command runs on a channel of its own rather than in the
    session's shell, so stdout and stderr arrive apart and nothing of the
    shell's state applies; everything around it -- Ctrl-C, --wait, stdin, the
    exit code -- is the same either way.

    Ctrl-C here interrupts the remote command, the way it would in a terminal,
    rather than killing this process and leaving the command running: an agent
    or a script that gives up on a command needs the session left usable.
    """
    use_exec = bool(getattr(opts, "exec_channel", False))
    interrupted = {"count": 0}

    def on_sigint(_signum, _frame):
        interrupted["count"] += 1
        if interrupted["count"] > 1:
            # A second Ctrl-C means "let me out", even if the remote side is
            # not responding.
            raise KeyboardInterrupt
        sys.stderr.write("\nmssh: interrupting the remote command "
                         "(Ctrl-C again to leave it running)\n")
        try:
            session_request(name, {"op": "interrupt"}, timeout=15.0)
        except (SessionGone, SystemExit, OSError):
            pass

    with_stdin = want_stdin(opts)

    previous = signal.getsignal(signal.SIGINT)
    try:
        signal.signal(signal.SIGINT, on_sigint)
    except ValueError:
        previous = None                   # not the main thread; leave it alone

    request = {"op": "exec" if use_exec else "send",
               "line": line, "wait": opts.wait}
    if with_stdin:
        request["stdin"] = True
    call = session_exec if use_exec else session_send

    try:
        verbose(opts, "session %s: %s %d byte(s)%s, waiting up to %s"
                % (name, "running on its own channel:" if use_exec
                   else "sending", len(line),
                   " and forwarding stdin (%s)" % stdin_kind()
                   if with_stdin else "",
                   ("%gs" % opts.wait) if opts.wait > 0 else "forever"))
        started = time.time()
        code = _session_exit_code(
            name, call(name, request, send_stdin=with_stdin),
            opts, interrupted)
        verbose(opts, "session %s: finished in %.3fs, exit %d"
                % (name, time.time() - started, code))
        return code
    except KeyboardInterrupt:
        sys.stderr.write("mssh: detached; the command may still be running "
                         "(mssh --session %s --status)\n" % name)
        return 130
    finally:
        if previous is not None:
            signal.signal(signal.SIGINT, previous)


def run_session_interrupt(name):
    reply = session_request(name, {"op": "interrupt"}, timeout=30.0)
    if reply.get("error"):
        sys.stderr.write(reply["error"].rstrip("\n") + "\n")
        return 1
    if reply.get("interrupted"):
        sys.stderr.write("mssh: session %s: interrupted the running command\n"
                         % name)
    else:
        sys.stderr.write("mssh: session %s: nothing was running\n" % name)
    return 0


def _session_exit_code(name, message, opts, interrupted=None):
    """What this process should exit with, given the daemon's last word.

    The output itself has already been written: it came off the pipe as the
    command produced it, and this is only the one message that ends it.
    """
    message = message or {}
    error = message.get("error")
    status = message.get("status")
    timed_out = bool(message.get("timed_out"))

    if error:
        sys.stderr.write(error.rstrip("\n") + "\n")
        return 1
    if interrupted and interrupted["count"]:
        return 130
    if timed_out:
        sys.stderr.write(
            "mssh: session %s: no end of output after %gs -- the command may "
            "still be running (raise --wait, or --interrupt it)\n"
            % (name, opts.wait)
        )
        return 124
    return int(status) if status is not None else 0


def _uptime(seconds):
    seconds = int(seconds)
    return "%d:%02d:%02d" % (seconds // 3600, seconds // 60 % 60, seconds % 60)


def run_session_status(name):
    info = session_request(name, {"op": "status"}, timeout=15.0)
    sys.stdout.write(
        "session:  %s\n"
        "target:   %s\n"
        "mode:     %s\n"
        "program:  %s\n"
        "uptime:   %s\n"
        "commands: %d\n"
        "state:    %s\n"
        "pid:      %d\n"
        % (name, info.get("target", "?"), info.get("mode", "?"),
           info.get("command") or "login shell",
           _uptime(time.time() - float(info.get("started") or time.time())),
           int(info.get("served") or 0),
           "running a command" if info.get("running") else "idle",
           int(info.get("pid") or 0))
    )
    if info.get("dead"):
        sys.stdout.write("state:    ended (%s)\n" % info["dead"])
    return 0


def run_session_stop(name):
    session_request(name, {"op": "stop"}, timeout=15.0)
    # The daemon acknowledges before it unwinds, so wait for the socket to go:
    # otherwise an immediate restart races the teardown.
    path = session_path(name)
    deadline = time.time() + 15
    while time.time() < deadline and os.path.exists(path):
        time.sleep(0.05)
    sys.stderr.write("mssh: session %s stopped\n" % name)
    return 0


def run_session_list():
    directory = session_dir()
    rows = []
    try:
        entries = sorted(os.listdir(directory))
    except OSError:
        entries = []
    for entry in entries:
        if not entry.endswith(".sock"):
            continue
        name = entry[:-len(".sock")]
        try:
            info = session_request(name, {"op": "status"}, timeout=5.0)
        except SessionGone:
            continue                      # stale socket, a killed daemon
        except SystemExit:
            rows.append((name, "?", "?", "?", 0))
            continue
        rows.append((name, info.get("target", "?"), info.get("mode", "?"),
                     _uptime(time.time() - float(info.get("started") or 0)),
                     int(info.get("served") or 0)))

    if not rows:
        sys.stderr.write("mssh: no live sessions in %s\n" % directory)
        return 1
    width = max(len(r[0]) for r in rows + [("NAME",)])
    tgtw = max(len(r[1]) for r in rows) if rows else 6
    sys.stdout.write("%-*s  %-*s  %-11s  %-9s  %s\n"
                     % (width, "NAME", tgtw, "TARGET", "MODE", "UPTIME",
                        "SENT"))
    for row in rows:
        sys.stdout.write("%-*s  %-*s  %-11s  %-9s  %d\n"
                         % (width, row[0], tgtw, row[1], row[2], row[3],
                            row[4]))
    return 0


def run_session(parser, opts):
    """Dispatch every --session invocation."""
    name = opts.session
    if not SESSION_NAME_RE.match(name):
        parser.error("invalid session name %r; use up to 64 characters from "
                     "A-Z a-z 0-9 . _ - starting with a letter, digit or _"
                     % name)
        return 2

    controls = [flag for flag in ("stop", "interrupt", "status")
                if getattr(opts, flag)]
    if len(controls) > 1:
        parser.error("--%s and --%s cannot be combined" % tuple(controls[:2]))
        return 2
    if controls:
        if opts.args:
            parser.error("--%s takes no other arguments" % controls[0])
            return 2
        if opts.exec_channel:
            parser.error("--exec runs a command; it cannot be combined with "
                         "--%s" % controls[0])
            return 2
        try:
            if controls[0] == "status":
                return run_session_status(name)
            if controls[0] == "stop":
                return run_session_stop(name)
            return run_session_interrupt(name)
        except SessionGone:
            _no_session(name)

    if opts.copy_id:
        parser.error("--copy-id cannot be combined with --session")
        return 2
    if opts.force_tty:
        parser.error("-t cannot be combined with --session; a session always "
                     "allocates a pty")
        return 2
    if opts.recursive or opts.preserve:
        parser.error("-r/-p only apply to a file copy, not to --session")
        return 2
    if opts.prompt is not None and not opts.command:
        parser.error("--prompt marks the end of an interactive program's "
                     "reply, so it needs -c to say which program to run")
        return 2
    if opts.prompt is not None:
        try:
            re.compile(opts.prompt)
        except re.error as exc:
            parser.error("--prompt is not a valid regular expression: %s" % exc)
            return 2

    # A live session takes commands; only a dead one can be started.  That
    # split is by existence, not by guessing whether the argument looks more
    # like a command or a host: against a live session every positional is a
    # command, so 'mssh --session s root@host' runs that word in the shell
    # and says "command not found" rather than being second-guessed here.
    # Only the start-only flags are still refused.
    if session_alive(name):
        if opts.jump or opts.command:
            raise SystemExit(
                "mssh: session %r is already running; --status to inspect "
                "it, --stop to end it" % name
            )
        if not opts.args:
            parser.error("--session %s: nothing to send -- pass a command, "
                         "or --status/--stop/--interrupt" % name)
            return 2
        try:
            return run_session_send(name, " ".join(opts.args), opts)
        except SessionGone:
            # It answered a moment ago, so it ended in between -- usually
            # because the previous command was an 'exit'.  Same message as a
            # session that was never there: from here they are the same thing.
            _no_session(name)

    if opts.exec_channel:
        # --exec borrows a live session's chain; there is nothing to borrow
        # before one exists, and the first call is the one that builds it.
        parser.error("--exec runs a command in an existing session; start "
                     "one first with: mssh --session %s [-j <jump>...] "
                     "<target>" % name)
        return 2
    if len(opts.args) != 1:
        _no_session(name)
    try:
        target = parse_endpoint(opts.args[0])
    except ValueError:
        _no_session(name)
    try:
        jumps = [parse_endpoint(spec) for spec in opts.jump]
    except ValueError as exc:
        parser.error(str(exc))
        return 2
    _setup_paramiko_logging(opts)
    return run_session_spawn(name, jumps, target, opts)


