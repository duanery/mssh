def _setup_paramiko_logging(opts):
    import logging
    if opts.verbose:
        # Match paramiko's own output to the mssh timestamp format so the
        # two interleave readably on stderr.
        handler = logging.StreamHandler(sys.stderr)
        handler.setFormatter(logging.Formatter(
            fmt="[%(asctime)s.%(msecs)03d] paramiko: %(message)s",
            datefmt="%H:%M:%S",
        ))
        plog = logging.getLogger("paramiko")
        plog.handlers = [handler]
        plog.setLevel(logging.WARNING)
        plog.propagate = False
    else:
        logging.getLogger("paramiko").setLevel(logging.CRITICAL)


def verbose(opts, message):
    if opts.verbose:
        now = datetime.datetime.now()
        stamp = now.strftime("%H:%M:%S.") + "%03d" % (now.microsecond // 1000)
        elapsed = time.time() - _START_TIME
        sys.stderr.write("[%s +%7.3fs] mssh: %s\n" % (stamp, elapsed, message))
        sys.stderr.flush()


EPILOG = """\
endpoint format:
  [user[:password]@]host[:port]
  port defaults to 22 and must be numeric; the user defaults to the local
  one, so 'mssh 10.0.0.9' logs in as you; the password goes before the '@'
  and may contain ':' and '@'.  Bracket IPv6 hosts: user:pw@[::1]:22

examples:
  mssh 192.168.1.10                                # as the local user
  mssh -j ops:jumppw@10.0.0.1:22 root:rootpw@192.168.1.10:22
  mssh -j a:pw1@1.1.1.1:2222 -j b:pw2@10.0.0.5 app:pw3@172.16.0.9:22
  mssh -j ops@10.0.0.1 root@192.168.1.10 -i ~/.ssh/id_ed25519
  mssh -j ops:pw@10.0.0.1 root@192.168.1.10 -i ~/.ssh/id_rsa
  mssh -j ops:pw@10.0.0.1 root:pw@192.168.1.10 -c 'uptime; df -h'

file copy (SOURCE... DEST; remote side [user[:password]@]host[:port]:path):
  mssh -j ops@10.0.0.1 ./app.tar root@10.0.0.9:/tmp/       # upload
  mssh -j ops@10.0.0.1 root@10.0.0.9:/var/log/syslog ./    # download
  mssh ./app.tar 10.0.0.9:/tmp/           # user defaults here too
  mssh ./a ./b root@10.0.0.9:/opt/pkg/    # several, DEST must be a dir
  mssh -r ./dist root@10.0.0.9:/srv/www/  # -r recurses into directories
  mssh -rp root@10.0.0.9:/etc/nginx ./    # -p also keeps the mtime
  mssh ./x root@10.0.0.9:                 # bare ':' is the remote $HOME
  mssh ./x root@10.0.0.9:36001:/tmp/      # with a port
  The path after ':' may be absolute or relative to the remote home.
  An argument is remote when what precedes its first ':' could be a host
  name, as under scp, so a local file named 'notes:2024.txt' has to be
  written './notes:2024.txt'.  Two spellings are refused rather than
  guessed: 'h:8900' is host and port with no path (write 'h:8900:8900',
  or './h:8900' for a local file), and 'h::8900' leaves the port field
  empty (write 'h:./:8900' for that path, or fill the port in).
  Runs over sftp on the target; add -C to compress large transfers.
  A copied file keeps its permissions, as under scp: an executable stays
  executable, filtered by your umask.  A file that already exists keeps its
  own mode, so overwriting never widens one.  -p asks for the exact mode
  instead, umask and all, plus the modification time.

persistent session (keep one connection and one shell alive):
  mssh --session s -j ops@10.0.0.1 root@10.0.0.9   # first call: detaches
  mssh --session s 'cd /var/log && ls'             # runs in that shell
  mssh --session s 'grep -c error messages'        # exit code is grep's
  mssh --session s 'X=1'; mssh --session s 'echo $X'   # state persists
  Each call is a separate process, but the working directory, variables
  and background jobs live on in the session, which a plain -c cannot do.
  Once a session is live every positional is a command, so a repeated
  start runs the endpoint as one; --status says whether one is live.

  stdin is forwarded when it is a pipe or a file, as it would be to ssh:
  echo hello | mssh --session s cat                # prints hello
  mssh --session s 'wc -l' < access.log            # counts the local file
  tar cf - ./dir | mssh --session s 'tar xf - -C /srv'
  It streams, so a filter fed by a slow producer prints as it goes, and the
  command still runs in the session's shell -- a 'cd' before it still
  applies.  A terminal is NOT forwarded by default, since with --stdin the
  command reads until you type Ctrl-D: that is what you want for 'cat', and
  not what you want for a plain 'mssh --session s ls'.  -n never forwards,
  for when mssh's stdin belongs to something else (a script read from a pipe).
  /dev/null is never forwarded: it cannot be told from having no input.

  -c holds an interactive program instead of a shell, and --prompt names
  the regex that ends one of its replies:
  mssh --session g --prompt '\\(gdb\\) $' -j ops@10.0.0.1 root@10.0.0.9 \\
       -c 'gdb -q -ex "set pagination off" -p 1234'
  mssh --session g 'bt'                            # output, then exit 0

  mssh --session s --status    # target, uptime, commands served
  mssh --session s --interrupt # Ctrl-C, to unstick a hung command
  mssh --session s --stop      # end it; --sessions lists live ones

  Output streams as the command produces it, so a long-running command
  (a poller, a tail, a build) prints as it goes.  --wait bounds how long
  to keep watching, 0 for no bound; a timeout leaves the session usable
  and the next command stops whatever was still running.  Ctrl-C
  interrupts the remote command rather than killing the local one, so the
  session stays usable; press it twice to walk away and leave it running.

  The session runs behind a pty, so output is stdout and stderr merged in
  the order the program wrote them, and the exit code -- not the stream --
  is what says whether a command failed.  With nothing piped in, a command's
  stdin is /dev/null, so a bare 'cat' ends instead of hanging the session.  A
  program that paginates will stall at its pager until --interrupt, so
  turn paging off in the program itself (gdb: -ex 'set pagination off').

  --exec runs a command on a channel of its own instead of in the shell,
  for the many commands that want the chain but no context:
  mssh --session s --exec 'grep -c error /var/log/messages'
  mssh --session s --exec 'cat big.log' 2>/dev/null   # stderr is separate
  It shares the connection, not the shell, so a 'cd' from an earlier call
  does NOT apply and neither do its variables or functions.  In exchange
  there is no pty: stdout and stderr stay apart, nothing is framed and no
  carriage returns are added, and several --exec commands can run at once,
  even while the session's own shell is busy.  --wait, --interrupt, Ctrl-C,
  stdin and the exit code behave as they do without it, except that a
  command cut short -- a timeout, an interrupt, a client that walked away --
  is killed with its channel rather than left running on the target.

  Sessions live in ~/.mssh/sessions, one socket each, mode 0600: holding
  one is equivalent to being logged in on the target.

  The first call keeps your terminal until the chain is up, so a hop that
  needs a password still asks for one, and -v still shows each hop; only
  then does it detach.

first-time key setup (then no more passwords):
  ssh-keygen -t ed25519                       # if you have no key yet
  mssh --copy-id -j ops:pw1@10.0.0.1 root:pw2@10.0.0.9
  mssh -j ops@10.0.0.1 root@10.0.0.9          # subsequent logins, key auth

key types:
  ed25519 (recommended), ecdsa (nistp256/384/521) and rsa.  DSA is gone:
  paramiko 5 dropped it, as did OpenSSH 9.8.  An OpenSSH certificate is
  used automatically when <key>-cert.pub sits next to the private key.

idle connections:
  mssh sends a keepalive every 30s (-k SEC, 0 to disable), so an idle
  session survives NAT and firewall timeouts.  It cannot override a
  server-side ClientAliveInterval or a shell TMOUT -- those still apply.

security note:
  passwords on the command line are visible in `ps` and shell history.
  Prefer keys, or omit the password and let mssh prompt for it.

legacy servers:
  against OpenSSH older than 7.8, RSA keys cannot be used: those servers
  accept only SHA-1 'ssh-rsa' signatures, which paramiko 5 no longer
  produces. Use an ed25519 key (ssh-keygen -t ed25519) instead.
"""


def build_parser():
    parser = argparse.ArgumentParser(
        prog="mssh",
        description="Multi-hop SSH login through one or more jump hosts.",
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "-j", "--jump", action="append", default=[], metavar="SPEC",
        help="jump host as [user[:password]@]host[:port]; repeat for each hop, in order",
    )
    parser.add_argument(
        "args", metavar="TARGET|PATH", nargs="*",
        help="either one login target, [user[:password]@]host[:port] with the "
             "user defaulting to the local one, or copy arguments SOURCE... "
             "DEST in which the remote side carries that same endpoint with "
             "':' and a path appended: "
             "'./app.tar root@10.0.0.9:/tmp/' uploads, "
             "'root@10.0.0.9:/var/log/syslog ./' downloads",
    )
    parser.add_argument(
        "-r", "--recursive", action="store_true",
        help="copy directories recursively",
    )
    parser.add_argument(
        "-p", "--preserve", action="store_true",
        help="preserve the exact mode and the modification time on copied "
             "files.  Without it a copy still keeps its permissions, as scp "
             "does, but your umask filters them",
    )
    parser.add_argument(
        "-c", "--command", metavar="CMD",
        help="run CMD on the target and exit instead of opening a shell",
    )
    parser.add_argument(
        "-i", "--identity", action="append", metavar="KEYFILE",
        help="private key file to authenticate with, e.g. ~/.ssh/id_rsa; "
             "repeat to offer several. Applies to every hop. Prompts once "
             "for the passphrase if the key is encrypted",
    )
    parser.add_argument(
        "--copy-id", nargs="?", const="", metavar="PUBKEY",
        help="install a public key into ~/.ssh/authorized_keys on every hop, "
             "then exit without opening a shell or running -c, so later "
             "connections need no password. "
             "Defaults to ~/.ssh/id_ed25519.pub or id_rsa.pub",
    )
    parser.add_argument(
        "-t", "--force-tty", action="store_true",
        help="allocate a pty even with -c",
    )
    parser.add_argument(
        "-n", "--no-stdin", action="store_true",
        help="never forward stdin; the remote command reads /dev/null.  With "
             "--session, stdin is otherwise forwarded whenever it is a pipe or "
             "a file, so use this when this process's stdin belongs to "
             "something else, such as a script being read from a pipe",
    )
    parser.add_argument(
        "-o", "--timeout", type=float, default=DEFAULT_TIMEOUT, metavar="SEC",
        help="per-hop connect timeout in seconds (default: %d)" % DEFAULT_TIMEOUT,
    )
    parser.add_argument(
        "-k", "--keepalive", type=int, default=30, metavar="SEC",
        help="keepalive interval, 0 to disable (default: 30)",
    )
    parser.add_argument(
        "-C", "--compress", action="store_true", help="enable compression",
    )
    parser.add_argument(
        "--strict", action="store_true",
        help="reject unknown host keys instead of auto-adding them",
    )
    parser.add_argument(
        "--known-hosts", metavar="FILE", help="known_hosts file to load",
    )
    parser.add_argument(
        "--no-agent", action="store_true", help="do not use ssh-agent",
    )
    parser.add_argument(
        "--no-keys", action="store_true", help="do not look for keys in ~/.ssh",
    )
    parser.add_argument(
        "--no-prompt", action="store_true",
        help="never prompt for a missing password (fail instead)",
    )
    group = parser.add_argument_group("persistent sessions")
    group.add_argument(
        "--session", metavar="NAME",
        help="keep the connection alive under NAME.  The first call carries "
             "the chain and detaches a local daemon holding a remote shell; "
             "every later 'mssh --session NAME CMD' runs CMD in that same "
             "shell, so the working directory, variables and any loaded "
             "state persist between calls",
    )
    group.add_argument(
        "--sessions", action="store_true", help="list live sessions and exit",
    )
    group.add_argument(
        "--stop", action="store_true",
        help="end the --session named session and close its connection",
    )
    group.add_argument(
        "--interrupt", action="store_true",
        help="send Ctrl-C to the session, as if at its keyboard",
    )
    group.add_argument(
        "--status", action="store_true",
        help="print the session's target, uptime and command count",
    )
    group.add_argument(
        "--prompt", metavar="REGEX",
        help="with --session -c: the regex marking the end of the program's "
             r"reply, e.g. '\(gdb\) $' or '>>> $'.  Without it mssh guesses, "
             "treating a --idle pause in the output as the end",
    )
    group.add_argument(
        "--stdin", action="store_true",
        help="also forward stdin when it is a terminal, so the remote command "
             "reads what you type until you end it with Ctrl-D.  A pipe or a "
             "file is forwarded without this; a terminal is not, because the "
             "Ctrl-D would then be needed by every command, 'ls' included",
    )
    group.add_argument(
        "--exec", dest="exec_channel", action="store_true",
        help="run the command on a channel of its own instead of in the "
             "session's shell.  It shares the connection but not the shell, "
             "so the session's working directory, variables and functions do "
             "NOT apply -- in exchange stdout and stderr come back separately "
             "(no pty merges them), nothing is framed, and several such "
             "commands can run at once.  Use it for the many commands that "
             "need the chain but no context",
    )
    group.add_argument(
        "--idle", type=float, default=DEFAULT_SESSION_IDLE, metavar="SEC",
        help="without --prompt, how long output must pause before it counts "
             "as finished (default: %g)" % DEFAULT_SESSION_IDLE,
    )
    group.add_argument(
        "--wait", type=float, default=DEFAULT_SESSION_WAIT, metavar="SEC",
        help="how long to wait for a command to finish; its output streams "
             "as it arrives either way, and the session survives a timeout.  "
             "0 waits indefinitely, so a command that never ends keeps "
             "printing until you Ctrl-C it (default: %g)"
             % DEFAULT_SESSION_WAIT,
    )
    group.add_argument(
        "--session-idle", type=float, default=0, metavar="SEC",
        help="end the session after SEC of no commands, so a forgotten one "
             "does not hold a connection open forever (default: 0, never)",
    )
    parser.add_argument(
        "-v", "--verbose", action="store_true", help="log each hop to stderr",
    )
    parser.add_argument(
        "-V", "--version", action="version", version="mssh " + __version__,
    )
    return parser


def main(argv=None):
    parser = build_parser()
    opts = parser.parse_args(argv)

    if opts.sessions:
        if opts.session or opts.args:
            parser.error("--sessions lists sessions and exits; it takes no "
                         "other arguments")
            return 2
        return run_session_list()

    if opts.session:
        return run_session(parser, opts)

    for flag in ("stop", "interrupt", "status"):
        if getattr(opts, flag):
            parser.error("--%s acts on a session; name it with --session NAME"
                         % flag)
            return 2
    if opts.prompt is not None:
        parser.error("--prompt only applies to --session -c")
        return 2
    if opts.exec_channel:
        parser.error("--exec runs a command in a session's connection; name "
                     "the session with --session NAME (without a session, a "
                     "plain -c already runs on its own channel)")
        return 2

    if not opts.args:
        parser.error("no target given; pass [user[:password]@]host[:port] "
                     "(mssh --help for the full syntax)")
        return 2

    # One positional is a login target; several mean a copy, and then the
    # target is whichever host the remote paths name.
    opts.paths = opts.args if len(opts.args) > 1 else []
    plan = None

    if not opts.paths:
        # A lone argument that carries a path is a half-written copy.  Say so,
        # rather than letting parse_endpoint complain about the path looking
        # like a port.  --copy-id is the usual culprit: its optional argument
        # silently eats the source.
        try:
            lone_ep, _ = split_copy_arg(opts.args[0])
        except ValueError:
            lone_ep = None
        if lone_ep is not None:
            extra = ""
            if opts.copy_id:
                extra = (" (--copy-id took %r as its public key; put it "
                         "after the paths, or use --copy-id=FILE)"
                         % opts.copy_id)
            parser.error("%s names a remote file, so this is a copy, but "
                         "only one path was given -- a copy needs SOURCE "
                         "and DEST%s" % (opts.args[0], extra))
            return 2

    try:
        jumps = [parse_endpoint(spec) for spec in opts.jump]
        if opts.paths:
            plan = plan_copy(opts.paths)
            target = plan[3]
        else:
            target = parse_endpoint(opts.args[0])
    except ValueError as exc:
        parser.error(str(exc))
        return 2

    # --copy-id with no argument: fall back to a standard public key.
    if opts.copy_id == "":
        found = _default_pubkey()
        if found is None:
            parser.error(
                "no public key found in ~/.ssh. Generate one with:\n"
                "    ssh-keygen -t ed25519\n"
                "  (press Enter at each prompt for a passwordless key), "
                "or pass --copy-id <file>"
            )
            return 2
        opts.copy_id = found

    # Reject the impossible combinations before opening any connection.
    if opts.paths:
        if opts.command:
            parser.error("-c and a file copy are mutually exclusive")
            return 2
        if opts.copy_id:
            parser.error("--copy-id installs a key and exits; it cannot also "
                         "copy files")
            return 2
    elif opts.recursive or opts.preserve:
        parser.error("-r/-p only apply to a file copy; pass SOURCE and DEST")
        return 2

    _setup_paramiko_logging(opts)

    clients = []
    try:
        clients, tgt = build_chain(jumps, target, opts)
        # --copy-id is a setup action, not a login: installing the key on
        # every hop is the whole job, so stop before any shell or command.
        if opts.copy_id:
            return 0
        if opts.paths:
            return run_copy(tgt, plan, opts)
        if opts.command:
            return run_command(tgt, opts.command, opts)
        return run_interactive(tgt, opts)
    except KeyboardInterrupt:
        sys.stderr.write("\nmssh: interrupted\n")
        return 130
    finally:
        close_all(clients)


if __name__ == "__main__":
    sys.exit(main())
