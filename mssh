# interactive shell
# --------------------------------------------------------------------------

def term_size():
    try:
        import fcntl
        import struct
        import termios
        packed = fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ,
                             struct.pack("HHHH", 0, 0, 0, 0))
        rows, cols = struct.unpack("HHHH", packed)[:2]
        if rows and cols:
            return cols, rows
    except Exception:
        pass
    try:
        import shutil
        size = shutil.get_terminal_size((80, 24))
        return size.columns, size.lines
    except Exception:
        return 80, 24


def posix_shell(chan):
    """Bridge the local tty and the remote channel until either closes."""
    import termios
    import tty

    stdin_fd = sys.stdin.fileno()
    old_attrs = termios.tcgetattr(stdin_fd)

    resized = [False]

    def on_winch(signum, frame):
        resized[0] = True

    old_winch = None
    try:
        old_winch = signal.signal(signal.SIGWINCH, on_winch)
    except (ValueError, AttributeError, OSError):
        pass

    try:
        tty.setraw(stdin_fd)
        tty.setcbreak(stdin_fd)
        chan.settimeout(0.0)

        while True:
            if resized[0]:
                resized[0] = False
                cols, rows = term_size()
                try:
                    chan.resize_pty(width=cols, height=rows)
                except Exception:
                    pass

            try:
                ready, _, _ = select.select([chan, stdin_fd], [], [], 0.2)
            except select.error:
                continue
            except InterruptedError:
                continue

            if chan in ready:
                try:
                    data = chan.recv(65536)
                except socket.timeout:
                    data = b""
                except Exception:
                    break
                if len(data) == 0:
                    break
                os.write(sys.stdout.fileno(), data)

            if stdin_fd in ready:
                try:
                    data = os.read(stdin_fd, 4096)
                except OSError:
                    break
                if len(data) == 0:
                    try:
                        chan.shutdown_write()
                    except Exception:
                        pass
                    break
                try:
                    chan.sendall(data)
                except Exception:
                    break
    finally:
        termios.tcsetattr(stdin_fd, termios.TCSADRAIN, old_attrs)
        if old_winch is not None:
            try:
                signal.signal(signal.SIGWINCH, old_winch)
            except Exception:
                pass


def pipe_shell(chan):
    """Non-tty fallback: pump stdin/stdout without raw mode."""
    def reader():
        while True:
            try:
                data = chan.recv(65536)
            except Exception:
                break
            if not data:
                break
            sys.stdout.buffer.write(data)
            sys.stdout.flush()

    thread = threading.Thread(target=reader)
    thread.daemon = True
    thread.start()

    try:
        while True:
            data = sys.stdin.buffer.read(4096)
            if not data:
                break
            chan.sendall(data)
        chan.shutdown_write()
    except Exception:
        pass
    thread.join(timeout=2)


def run_interactive(client, opts):
    transport = client.get_transport()
    chan = transport.open_session(timeout=opts.timeout)

    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    if interactive:
        cols, rows = term_size()
        chan.get_pty(term=os.environ.get("TERM", "xterm-256color"),
                     width=cols, height=rows)
    chan.invoke_shell()

    if interactive:
        posix_shell(chan)
    else:
        pipe_shell(chan)

    status = 0
    try:
        if chan.exit_status_ready():
            status = chan.recv_exit_status()
    except Exception:
        pass
    chan.close()
    return status


def run_command(client, command, opts):
    transport = client.get_transport()
    chan = transport.open_session(timeout=opts.timeout)
    if opts.force_tty:
        cols, rows = term_size()
        chan.get_pty(term=os.environ.get("TERM", "xterm-256color"),
                     width=cols, height=rows)
    chan.exec_command(command)

    if opts.force_tty and sys.stdin.isatty() and sys.stdout.isatty():
        # The remote pty echoes and handles line editing, so the local tty has
        # to stay out of the way -- the same bridge an interactive login uses.
        posix_shell(chan)
    else:
        pump_command(chan)

    status = chan.recv_exit_status()
    chan.close()
    return status


def stdin_fd():
    """The fd to forward to the remote, or None if there is nothing to read."""
    try:
        fd = sys.stdin.fileno()
    except (AttributeError, ValueError, IOError):
        return None
    try:
        os.fstat(fd)
    except OSError:
        return None
    return fd


def pump_command(chan):
    """Forward stdin to the remote command and its output back, until it exits.

    stdin matters more than it looks: anything that reads input -- `-c cat`, a
    prompt, a pipeline fed from a local file -- hangs forever if we only drain
    the channel, which is what ssh(1) would never do.
    """
    chan.settimeout(0.0)
    out = sys.stdout.buffer
    err = sys.stderr.buffer
    infd = stdin_fd()

    while True:
        got = False
        if chan.recv_ready():
            data = chan.recv(65536)
            if data:
                out.write(data)
                out.flush()
                got = True
        if chan.recv_stderr_ready():
            data = chan.recv_stderr(65536)
            if data:
                err.write(data)
                err.flush()
                got = True
        if got:
            continue

        if chan.exit_status_ready() and not chan.recv_ready() \
                and not chan.recv_stderr_ready():
            break

        watch = [chan] if infd is None else [chan, infd]
        try:
            ready, _, _ = select.select(watch, [], [], 0.1)
        except (select.error, InterruptedError):
            continue

        if infd is not None and infd in ready:
            try:
                data = os.read(infd, 65536)
            except OSError:
                data = b""
            if data:
                try:
                    chan.sendall(data)
                except Exception:
                    break
            else:
                # Local EOF: close the remote's stdin so it can finish, then
                # stay in the loop to collect whatever it still prints.
                infd = None
                try:
                    chan.shutdown_write()
                except Exception:
                    pass


