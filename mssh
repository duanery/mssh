def term_size():
    try:
        import fcntl
        import struct
        import termios
        packed = fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ,
                             struct.pack("HHHH", 0, 0, 0, 0))
        rows, cols = struct.unpack("HHHH", packed)[:2]
        if rows and cols:
            return cols, rows
    except Exception:
        pass
    try:
        import shutil
        size = shutil.get_terminal_size((80, 24))
        return size.columns, size.lines
    except Exception:
        return 80, 24


def stdin_fd():
    """The fd to forward to the remote, or None if there is nothing to read."""
    try:
        fd = sys.stdin.fileno()
    except (AttributeError, ValueError, IOError):
        return None
    try:
        os.fstat(fd)
    except OSError:
        return None
    return fd


def _both_ends_are_tty():
    """True when this process's stdin and stdout are both terminals.

    The test for whether a remote program can be given a terminal to drive.
    Both ends matter and for different reasons: stdin is what the keystrokes
    come from and what raw mode is set on, stdout is what the program's cursor
    motion has to land on.  With either one redirected a pty would only damage
    the result -- 'mssh --session s --exec -t top > log' would fill the file
    with escape sequences, and nothing would be typing at it.
    """
    try:
        return sys.stdin.isatty() and sys.stdout.isatty()
    except (AttributeError, ValueError, IOError):
        return False


def _terminal_pty():
    """The local terminal settings used by direct and session requests."""
    cols, rows = term_size()
    return {"term": os.environ.get("TERM", "xterm-256color"),
            "cols": cols, "rows": rows}


def _request_pty(chan, settings):
    """Apply the same defaults to local and wire-protocol PTY settings."""
    chan.get_pty(term=settings.get("term") or "xterm-256color",
                 width=int(settings.get("cols") or 80),
                 height=int(settings.get("rows") or 24))


class _RawTerminal(object):
    """Hold the local terminal in raw mode for as long as a remote one runs.

    Only the client does this.  Once the remote program has a pty, that pty is
    the line discipline -- it echoes, it edits, it turns ^C into a signal -- so
    a local terminal still doing the same work would do all of it twice: every
    keystroke echoed locally and again by the remote, a Ctrl-C killing mssh
    instead of reaching the program, and a line held back until Enter when the
    program wanted the key itself.

    Nothing of this belongs in the daemon.  It is detached, its own standard
    descriptors are /dev/null, and the terminal in question is this process's.
    """

    def __init__(self, fd):
        self.fd = fd
        self.saved = None

    def __enter__(self):
        if self.fd is None:
            return self
        import termios
        import tty
        try:
            self.saved = termios.tcgetattr(self.fd)
            tty.setraw(self.fd)
            tty.setcbreak(self.fd)
        except Exception:
            self.saved = None
        if self.saved is not None:
            _RAW["depth"] += 1
        return self

    def __exit__(self, *_exc):
        if self.saved is None:
            return False
        import termios
        try:
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)
        except Exception:
            pass
        _RAW["depth"] -= 1
        self.saved = None
        return False


# Non-zero while the terminal above is raw, which anything mssh prints on its
# own account has to know: with the line discipline gone, a '\n' moves down
# without returning to the left margin.
_RAW = {"depth": 0}


class _WindowWatcher(object):
    """Watch terminal resizing for a direct channel or a daemon request.

    The size is sent once with the request, which is right until the window is
    dragged: from then on the remote program is drawing to the old one, and a
    full-screen program -- an editor, top, anything using curses -- paints over
    the wrong rectangle and stays wrong until it is restarted.  SIGWINCH is the
    only notice there is, so it has to be carried across while the command runs.

    Direct connections resize their channel through a callback. For a session
    it goes down the connection the command is already using. That socket is
    open for the command's whole life and the daemon's loop watches it;
    a second connection would have to identify which command it meant.

    The handler marks a pending resize and writes a byte to a pipe; it never
    resizes or sends a control message itself. The flag lets a busy output
    loop check for a resize without an extra select call. The pipe still
    wakes a blocked select: PEP 475 retries it after a handler returns, so
    a flag alone would go unread until the command happened to print.
    """

    def __init__(self, enabled=True, on_resize=None):
        self.enabled = enabled
        self.on_resize = on_resize
        self.rfd = self.wfd = None
        self.previous = None
        self.last = None
        self.pending = False

    def fileno(self):
        return self.rfd

    def __enter__(self):
        if not self.enabled:
            return self
        self.rfd, self.wfd = os.pipe()
        os.set_blocking(self.rfd, False)
        os.set_blocking(self.wfd, False)

        def on_winch(_signum, _frame):
            self.pending = True
            try:
                os.write(self.wfd, b"w")
            except OSError:
                pass          # the pipe is full: a wakeup is already pending

        try:
            self.previous = signal.signal(signal.SIGWINCH, on_winch)
        except (ValueError, AttributeError, OSError):
            self.previous = None
        self.last = term_size()
        return self

    def pump(self, conn=None):
        """Drain the wakeup, then resize directly or send a session control."""
        if not self.enabled or not self.pending:
            return
        # Clear before draining: a signal during this operation must leave
        # its new flag set, including when the pipe is already full.
        self.pending = False
        try:
            while os.read(self.rfd, 4096):
                pass
        except (BlockingIOError, OSError):
            pass
        size = term_size()
        if size == self.last:
            return                        # a SIGWINCH that changed nothing
        self.last = size
        try:
            if self.on_resize is not None:
                self.on_resize(*size)
                return
            conn.sendall(json.dumps({"op": "resize", "cols": size[0],
                                     "rows": size[1]}).encode("utf-8") + b"\n")
        except Exception:
            # A resize is cosmetic.  The command is still running and its
            # output is still arriving; losing one is not worth ending over,
            # and a socket that is really gone is noticed where it matters --
            # in the loop reading the status.
            pass

    def __exit__(self, *_exc):
        if self.previous is not None:
            try:
                signal.signal(signal.SIGWINCH, self.previous)
            except Exception:
                pass
            self.previous = None
        for fd in (self.rfd, self.wfd):
            if fd is not None:
                try:
                    os.close(fd)
                except OSError:
                    pass
        self.rfd = self.wfd = None
        self.pending = False
        return False


def pump(chan, is_tty=False, initial=b""):
    """Bridge local stdin/stdout/stderr and the remote channel until it closes.

    Local stdin is forwarded to the channel, chan.recv() is written to stdout
    and chan.recv_stderr() to stderr.  stdin matters more than it looks:
    anything that reads input -- `-c cat`, a prompt, a pipeline fed from a
    local file -- hangs forever if we only drain the channel, which is what
    ssh(1) would never do.

    With is_tty the local terminal is put in raw mode so keystrokes reach the
    remote pty unwrapped, and SIGWINCH keeps the remote pty sized to the
    window.  A pty merges the remote's stderr into stdout, so the stderr
    stream only ever carries data in the non-tty case.

    Input is held in a buffer rather than handed to sendall(): the channel is
    non-blocking here, so a remote that is slow to read makes send() raise
    socket.timeout, and sendall() would have swallowed an unknowable number
    of bytes before doing so.
    """
    out = sys.stdout.buffer
    err = sys.stderr.buffer
    if initial:
        out.write(initial)
        out.flush()
    chan.settimeout(0.0)
    infd = stdin_fd()

    pending = b""                     # read locally, not yet on the channel
    sent_eof = False                  # the remote's stdin has been closed

    def resize(cols, rows):
        chan.resize_pty(width=cols, height=rows)

    with _RawTerminal(infd if is_tty else None), \
            _WindowWatcher(enabled=is_tty, on_resize=resize) as watcher:
        while True:
            # Check before draining output as well as after select: a busy
            # remote stream must not postpone terminal resizing indefinitely.
            if watcher.pending:
                watcher.pump()

            # Drain whatever the remote has already sent, then wait.  Any
            # error here -- a dropped connection most of all -- ends the
            # session quietly; a terminal bridge has no business printing
            # a traceback over the output it was carrying.
            got = False
            try:
                if chan.recv_ready():
                    data = chan.recv(65536)
                    if not data:
                        break
                    out.write(data)
                    out.flush()
                    got = True
                if chan.recv_stderr_ready():
                    data = chan.recv_stderr(65536)
                    if data:
                        err.write(data)
                        err.flush()
                        got = True
            except Exception:
                break
            if got:
                continue

            # Push whatever input is still in hand.  The channel is
            # non-blocking, so send() returns short and raises socket.timeout
            # once the remote's window is full -- which says the remote is
            # slow to read, not that anything is wrong.  sendall() cannot be
            # used here at all: it would raise that same timeout after
            # sending an unknowable amount, and there would be no way to tell
            # what still needs sending.
            stalled = False
            while pending:
                try:
                    sent = chan.send(pending)
                except socket.timeout:
                    stalled = True
                    break
                except Exception:
                    pending, infd = b"", None
                    break
                if sent == 0:            # the remote closed its input
                    pending, infd = b"", None
                    break
                pending = pending[sent:]
            if not pending and infd is None and not sent_eof:
                # Local EOF, and the last of it is on its way: close the
                # remote's stdin so it can finish, then stay in the loop to
                # collect whatever it still prints -- stdin ending does not
                # mean the remote has.
                sent_eof = True
                try:
                    chan.shutdown_write()
                except Exception:
                    pass

            if not pending and chan.exit_status_ready() \
                    and not chan.recv_ready() and not chan.recv_stderr_ready():
                break

            watch = [chan]
            # Stop reading local input while the channel will not take it:
            # the backlog belongs in the pipe or the terminal we are reading
            # from, not in this process.
            if infd is not None and not stalled:
                watch.append(infd)
            if watcher.fileno() is not None:
                watch.append(watcher.fileno())
            # Nothing wakes us when the remote's window reopens -- the
            # channel's fileno() is an event pipe for arriving data, not for
            # sending room -- so a stalled send is retried on a short tick
            # rather than waited for.
            try:
                ready, _w, _x = select.select(watch, [], [],
                                              0.01 if stalled else 0.2)
            except (select.error, InterruptedError):
                continue

            if watcher.fileno() is not None and watcher.fileno() in ready:
                watcher.pump()

            if infd is not None and infd in ready:
                try:
                    data = os.read(infd, 65536)
                except OSError:
                    data = b""
                if data:
                    pending += data
                else:
                    infd = None          # the local side is done


def _rc_command(transport, command, timeout, data=b""):
    """Run a bounded, private command channel, draining both output streams."""
    chan = transport.open_session(timeout=timeout)
    deadline = time.monotonic() + max(timeout, 1.0)
    output = bytearray()
    pending = memoryview(data)
    eof = False
    out_eof = err_eof = False
    try:
        chan.exec_command(command)
        chan.settimeout(0.0)
        while time.monotonic() < deadline:
            if pending:
                try:
                    sent = chan.send(pending[:65536])
                except socket.timeout:
                    sent = None
                if sent == 0:
                    raise RuntimeError("the upload channel closed its input")
                if sent:
                    pending = pending[sent:]
            elif not eof:
                chan.shutdown_write()
                eof = True
            while not out_eof and chan.recv_ready():
                chunk = chan.recv(65536)
                if not chunk:
                    out_eof = True
                    break
                output.extend(chunk)
                if len(output) > 65536:
                    raise RuntimeError("unexpected initialization channel output")
            while not err_eof and chan.recv_stderr_ready():
                if not chan.recv_stderr(65536):
                    err_eof = True
                    break
            if chan.exit_status_ready() and (out_eof or not chan.recv_ready()) \
                    and (err_eof or not chan.recv_stderr_ready()):
                return bytes(output), chan.recv_exit_status()
            time.sleep(0.01)
        raise RuntimeError("initialization command timed out")
    finally:
        chan.close()


def _remote_temp_path(kind):
    """One naming and randomness policy for remote session artifacts."""
    if kind not in ("in", "rc"):
        raise ValueError("unknown remote temporary file kind: %s" % kind)
    suffix = "".join(secrets.choice(
        "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")
        for _ in range(16))
    return "/tmp/.mssh-%s-%s" % (kind, suffix)


def _upload_rcfile(transport, content, timeout):
    """Create one private temporary file, without a containing directory."""
    path = _remote_temp_path("rc")
    # Open exclusively before installing cleanup, so a collision is neither
    # overwritten nor removed.  This command owns a shell separate from the user.
    upload = (
        'umask 077; set -C; f=%s; exec 3> "$f" || exit 1; '
        'trap \'rm -f "$f"\' 0; '
        'cat >&3 || exit 1; exec 3>&-; printf "%%s\\n" "$f"; trap - 0'
        % shlex.quote(path)
    )
    out, status = _rc_command(transport, upload, timeout, content)
    if status != 0 or out != path.encode("ascii") + b"\n":
        raise RuntimeError("could not upload --rcfile to a private temporary file")
    return out.rstrip(b"\n").decode("ascii")


def _source_rcfile(transport, chan, content, timeout, banner_sink=None,
                   remote_path=None):
    """Source a retained session file, or upload and remove a one-off script."""
    if content is None and remote_path is None:
        return b""
    old_timeout = chan.gettimeout() if hasattr(chan, "gettimeout") else None
    try:
        retained = remote_path is not None
        if not retained:
            remote_path = _upload_rcfile(transport, content, timeout)
        token = os.urandom(16).hex()
        pattern = re.compile(
            b"\x1e" + token.encode("ascii") + rb":([0-9]+):([0-9]+)\x1f\r?\n")
        # Bash records a line before executing it.  Delete only our own entry,
        # before sourced code or a prompt hook can flush it to HISTFILE.
        history = (
            'if [ -n "${BASH_VERSION-}" ]; then '
            'case "$(builtin history 1 2>/dev/null)" in '
            '*%s*) builtin history -d "$((HISTCMD - 1))" 2>/dev/null ;; '
            'esac; fi; ' % token
        )
        line = (
            " " + history + ". %s </dev/null >/dev/null 2>&1; "
            "__mssh_rc_status=$?; "
            "%s; "
            "__mssh_rc_cleanup=$?; "
            "command printf '\\036%%s:%%s:%%s\\037\\n' '%s' "
            "\"$__mssh_rc_status\" \"$__mssh_rc_cleanup\"; "
            "unset __mssh_rc_status __mssh_rc_cleanup\n"
            % (shlex.quote(remote_path),
               ":" if retained else
               "command rm -f %s 2>/dev/null" % shlex.quote(remote_path), token)
        ).encode("ascii")
        deadline = time.monotonic() + max(timeout, 1.0)
        chan.settimeout(0.05)
        while line:
            if time.monotonic() >= deadline:
                raise RuntimeError("--rcfile initialization timed out")
            try:
                sent = chan.send(line)
            except socket.timeout:
                continue
            if not sent:
                raise RuntimeError("the shell closed during --rcfile initialization")
            line = line[sent:]
        tail = b""
        banner = bytearray()
        token_bytes = token.encode("ascii")
        while time.monotonic() < deadline:
            if chan.recv_stderr_ready():
                chan.recv_stderr(65536)
            try:
                chunk = chan.recv(65536)
            except socket.timeout:
                continue
            if not chunk:
                raise RuntimeError("the shell exited during --rcfile initialization")
            tail += chunk
            while b"\n" in tail:
                raw, tail = tail.split(b"\n", 1)
                raw += b"\n"
                match = pattern.search(raw)
                if match:
                    status = int(match.group(1))
                    if status:
                        raise RuntimeError("--rcfile returned exit status %d" % status)
                    if int(match.group(2)):
                        raise RuntimeError("could not remove the remote --rcfile")
                    before = raw[:match.start()]
                    if before and token_bytes not in before:
                        if banner_sink is not None:
                            banner_sink(before)
                        else:
                            banner.extend(before)
                    return bytes(banner) + tail
                # Keep partial lines buffered so a split token cannot leak.
                if token_bytes not in raw:
                    if banner_sink is not None:
                        banner_sink(raw)
                    else:
                        banner.extend(raw)
        raise RuntimeError("--rcfile initialization timed out")
    finally:
        chan.settimeout(old_timeout)


def run_interactive(client, opts):
    transport = client.get_transport()
    chan = transport.open_session(timeout=opts.timeout)

    interactive = _both_ends_are_tty()
    if interactive:
        _request_pty(chan, _terminal_pty())
    chan.invoke_shell()

    def show_banner(data):
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()

    try:
        initial = _source_rcfile(transport, chan,
                                 getattr(opts, "rcfile_data", None), opts.timeout,
                                 banner_sink=show_banner)
        pump(chan, is_tty=interactive, initial=initial)
        status = 0
        try:
            if chan.exit_status_ready():
                status = chan.recv_exit_status()
        except Exception:
            pass
        return status
    except RuntimeError as exc:
        raise SystemExit("mssh: %s" % exc)
    finally:
        chan.close()


def run_command(client, command, opts):
    transport = client.get_transport()
    chan = transport.open_session(timeout=opts.timeout)
    if opts.force_tty:
        _request_pty(chan, _terminal_pty())
    chan.exec_command(command)

    if opts.force_tty and _both_ends_are_tty():
        # The remote pty echoes and handles line editing, so the local tty has
        # to stay out of the way -- the same bridge an interactive login uses.
        pump(chan, is_tty=True)
    else:
        pump(chan)

    status = chan.recv_exit_status()
    chan.close()
    return status


