try:
    # Paramiko's cryptography dependency emits an import-time
    # CryptographyDeprecationWarning on Pythons the core team no longer
    # supports.  That is environmental noise the user cannot act on, not an
    # mssh problem, so keep the console clean while it loads.
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        import paramiko
except ImportError:  # pragma: no cover
    sys.stderr.write(
        "mssh: paramiko is required.\n"
        "      install it with:  pip3 install paramiko\n"
    )
    sys.exit(3)


# Process start, used for the +elapsed column in verbose output.
_START_TIME = time.time()

DEFAULT_PORT = 22
DEFAULT_TIMEOUT = 20

# What may be a host name.  The user part of an endpoint is optional, so a
# bare word is a whole endpoint and these are what keep a shell command from
# parsing as one: no spaces, no '/', no shell metacharacters.  A trailing dot
# (a fully qualified name) and '_' (common on LANs, though not strictly legal)
# are both allowed, since resolvers accept them.
HOST_RE = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._-]*\Z")
# Inside brackets: an IPv6 literal, optionally with a %zone suffix naming an
# interface ('[fe80::1%eth0]'), which may be any interface name.
HOST6_RE = re.compile(r"\A[0-9A-Fa-f:.]+(%[A-Za-z0-9._-]+)?\Z")

# Standard key names, best algorithm first. Single source of truth for
# both "which key would we use" and "do we have any key at all".
# ed25519 leads: it is the modern default and, unlike RSA, still works
# against old servers that only accept SHA-1 ssh-rsa signatures (paramiko
# 5 dropped SHA-1 signing, so an RSA key silently fails against those).
DEFAULT_KEY_NAMES = ("id_ed25519", "id_ecdsa", "id_rsa")

# Cap on outstanding SFTP read requests during a download.  Paramiko's
# default is unlimited, which for a 500 MiB file queues ~15000 32 KiB reads
# up front; an interrupt then has to drain all of them before the channel
# can close, so Ctrl-C appears to hang.  OpenSSH's own sftp uses 64.
MAX_PREFETCH = 64

# Persistent sessions.  A session name becomes a file name, so keep it to
# characters that cannot escape the session directory.  \Z, not $: '$' also
# matches before a trailing newline, so 'evil\n' would slip through.
SESSION_NAME_RE = re.compile(r"\A[A-Za-z0-9_][A-Za-z0-9._-]{0,63}\Z")

# How long a client waits for one command's output before giving up (the
# session survives; --interrupt clears it), and how long the framing falls
# back to "no new bytes for this long" when --prompt was not given.
DEFAULT_SESSION_WAIT = 30.0
DEFAULT_SESSION_IDLE = 0.4

# --reconnect waits longer after each failed attempt, up to this, so a run of
# attempts covers a long outage without hammering a machine that is booting.
# 2s, 4s, 8s, 16s, then 30s apart -- and apart is the word: this is the gap
# between attempts, not a period, so an attempt that has to time out (up to
# -o SEC per hop) adds its own cost rather than eating into the next wait.
# Attempts never overlap and never pile up, and N of them span at least the
# sum of the gaps -- eight minutes for N=20 -- plus however long N failures
# take, which is the right way round for an outage.
SESSION_RECONNECT_CAP = 30.0


# --------------------------------------------------------------------------
# endpoint parsing
# --------------------------------------------------------------------------

class Endpoint(object):
    """One SSH endpoint: user, host, port and optional password."""

    __slots__ = ("user", "host", "port", "password", "raw")

    def __init__(self, user, host, port, password, raw):
        self.user = user
        self.host = host
        self.port = port
        self.password = password
        self.raw = raw

    def __str__(self):
        return "%s@%s:%d" % (self.user, self.host, self.port)

    def masked(self):
        return "%s@%s:%d%s" % (
            self.user, self.host, self.port,
            ":***" if self.password is not None else "",
        )


def local_user():
    """The user to log in as when an endpoint does not name one.

    getpass.getuser() honours $LOGNAME/$USER before the passwd database, which
    is what ssh(1) effectively does too, and matters when mssh runs under
    sudo or in a container whose uid has no passwd entry.
    """
    try:
        return getpass.getuser()
    except Exception:
        # No environment and no passwd entry: nothing sensible to default to.
        raise ValueError(
            "cannot tell who you are, so the user cannot be defaulted; "
            "write the endpoint as user@host"
        )


def valid_host(host, bracketed=False):
    """True if ``host`` can be a host name at all.

    With the user now optional, a bare word is a valid endpoint, so this is
    what tells a hostname apart from a shell command: 'echo hi' and
    'cd /var/log && ls' must not parse as hosts, or a mistyped session send
    would try to connect to them.  Deliberately permissive about what a name
    may contain and strict about what it may not -- spaces and shell
    metacharacters.
    """
    if not host:
        return False
    if bracketed:
        # An IPv6 literal, optionally with a %zone suffix.
        return HOST6_RE.match(host) is not None
    return HOST_RE.match(host) is not None


def parse_endpoint(spec):
    """Parse '[user[:password]@]host[:port]' into an Endpoint.

    The credential part is split from the host part on the LAST '@', so a
    password may itself contain '@' and ':'.  The port, when given, must be
    numeric -- unlike the old trailing-password format there is no ambiguity
    between a port and a password.  With no '@' at all the whole spec is the
    host and the user is the local one, as with ssh(1).
    """
    if not spec:
        raise ValueError("empty endpoint")

    if "@" in spec:
        # Split on the LAST '@': the host part never contains '@', but a
        # password may.
        cred, _, hostpart = spec.rpartition("@")

        # Credentials: user[:password]; the password is the remainder, so ':'
        # inside it is fine.
        user, sep, password = cred.partition(":")
        if not user:
            # '@host' is a typo, not a request for the default: a user who
            # wants the default writes no '@' at all.
            raise ValueError(
                "missing user before '@' in %r; drop the '@' to log in as "
                "%s" % (spec, local_user())
            )
        if not sep:
            password = None
        elif password == "":
            # 'user:@host' -- an explicit but empty password means "ask me".
            password = None
    else:
        user, password, hostpart = local_user(), None, spec

    if not hostpart:
        raise ValueError("missing host in %r" % spec)

    # Host: bare, or a bracketed IPv6 literal, each with an optional :port.
    bracketed = hostpart.startswith("[")
    if bracketed:
        end = hostpart.find("]")
        if end < 0:
            raise ValueError("unterminated '[' in %r" % spec)
        host = hostpart[1:end]
        tail = hostpart[end + 1:]
        if not tail:
            portstr = None
        elif tail.startswith(":"):
            portstr = tail[1:]
        else:
            raise ValueError("junk after ']' in %r" % spec)
    else:
        if hostpart.count(":") > 1:
            # Most likely the old user@host:port:password layout.
            raise ValueError(
                "too many ':' in host part of %r; the format is "
                "[user[:password]@]host[:port] -- move the password before "
                "the '@' (bracket IPv6 as user@[::1]:port)" % spec
            )
        host, sep, rest = hostpart.partition(":")
        portstr = rest if sep else None

    if not host:
        raise ValueError("missing host in %r" % spec)
    if not valid_host(host, bracketed):
        raise ValueError(
            "%r is not a host name; the format is "
            "[user[:password]@]host[:port]" % host
        )

    port = DEFAULT_PORT
    if portstr is not None:
        if not portstr.isdigit():
            raise ValueError(
                "port must be numeric in %r, got %r; the format is "
                "[user[:password]@]host[:port] -- if that was a password, "
                "move it before the '@'" % (spec, portstr)
            )
        port = int(portstr)
        if not 0 < port < 65536:
            raise ValueError("port out of range in %r" % spec)

    return Endpoint(user, host, port, password, spec)


# --------------------------------------------------------------------------
# connection chain
# --------------------------------------------------------------------------

def _identities_tried(opts):
    """The credentials paramiko just offered, in the order it offered them.

    Paramiko reports a bare "authentication failed" no matter how many keys
    it walked through, which makes a wrong-key mistake hard to see. We feed
    it the same inputs, so we can name them.
    """
    tried = []
    if opts.identity:
        for path in opts.identity:
            tried.append(os.path.expanduser(path))
    if not opts.no_agent:
        sock = os.environ.get("SSH_AUTH_SOCK")
        if sock:
            n = _agent_key_count()
            if n:
                tried.append("ssh-agent (%d key%s via %s)"
                             % (n, "" if n == 1 else "s", sock))
    if not opts.no_keys:
        # Paramiko's own discovery order, which is not DEFAULT_KEY_NAMES'.
        ssh_dir = os.path.expanduser("~/.ssh")
        for name in ("id_rsa", "id_ecdsa", "id_ed25519"):
            path = os.path.join(ssh_dir, name)
            if os.path.isfile(path):
                tried.append(path)
    return tried


def _agent_key_count():
    try:
        agent = paramiko.Agent()
        try:
            return len(agent.get_keys())
        finally:
            agent.close()
    except Exception:
        return 0


def _identity_summary(opts):
    """Compact 'which key failed' text for a single-line message."""
    tried = _identities_tried(opts)
    if not tried:
        return ""
    if len(tried) <= 3:
        return ", ".join(tried)
    return "%s and %d more" % (", ".join(tried[:3]), len(tried) - 3)


def _log_identities(opts, label):
    """Verbose-only: the full offer order, and how to pin one key down."""
    tried = _identities_tried(opts)
    if not tried:
        verbose(opts, "%s: no key material offered (password auth only)" % label)
        return
    verbose(opts, "%s: offered %d credential(s), in paramiko's order:"
            % (label, len(tried)))
    for i, item in enumerate(tried, 1):
        verbose(opts, "%s:   %d. %s" % (label, i, item))
    if not opts.identity:
        verbose(opts, "%s: these were auto-discovered; use -i KEYFILE to "
                      "offer just one" % label)


def _new_client(opts):
    """An SSHClient with this run's host-key policy applied."""
    client = paramiko.SSHClient()

    if opts.known_hosts:
        try:
            client.load_host_keys(os.path.expanduser(opts.known_hosts))
        except IOError:
            pass
    else:
        client.load_system_host_keys()

    if opts.strict:
        client.set_missing_host_key_policy(paramiko.RejectPolicy())
    else:
        client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
    return client


def _can_prompt(opts):
    """True if we may still ask the user for a password interactively."""
    if opts.no_prompt:
        return False
    if sys.stdin.isatty():
        return True
    # getpass reads /dev/tty, which still works with stdin redirected.
    try:
        with open("/dev/tty"):
            return True
    except (IOError, OSError):
        return False


# Set the first time a password is typed at a prompt rather than coming from
# the command line or a key.  A session daemon reads it to decide whether it
# may reconnect: it detaches from the terminal, so a credential that only
# exists because somebody was there to type it cannot be had a second time.
_PROMPTED = {"password": False}


def _prompt_password(endpoint, opts, label):
    if not _can_prompt(opts):
        raise SystemExit(
            "mssh: %s: no usable key and no password for %s, and there is no "
            "terminal to ask on (drop --no-prompt, or put the password in the "
            "endpoint as user:password@host)" % (label, endpoint)
        )
    try:
        password = getpass.getpass("password for %s: " % endpoint)
    except (EOFError, KeyboardInterrupt):
        raise SystemExit("\nmssh: aborted")
    if password:
        _PROMPTED["password"] = True
    return password or None


def connect_hop(endpoint, sock_factory=None, opts=None, index=0, total=1):
    """Open one SSH connection, optionally tunnelled through the previous hop.

    ``sock_factory`` is a callable returning a fresh channel to this hop, or
    None for the first hop.  It is a factory rather than a plain socket
    because a failed authentication burns the channel, and we may need a
    second attempt to ask for a password.
    """
    label = "hop %d/%d" % (index + 1, total)
    password = endpoint.password

    if password is None and not opts.identity and not _has_usable_key(opts):
        # No key material at all, so a key attempt would only waste a round
        # trip. Ask up front instead.
        password = _prompt_password(endpoint, opts, label)

    asked = False
    while True:
        sock = sock_factory() if sock_factory is not None else None
        client = _new_client(opts)

        kwargs = dict(
            hostname=endpoint.host,
            port=endpoint.port,
            username=endpoint.user,
            password=password,
            sock=sock,
            timeout=opts.timeout,
            banner_timeout=opts.timeout,
            auth_timeout=opts.timeout,
            allow_agent=not opts.no_agent,
            look_for_keys=not opts.no_keys,
            compress=opts.compress,
        )
        if opts.identity:
            paths = [os.path.expanduser(p) for p in opts.identity]
            for path in paths:
                if not os.path.exists(path):
                    raise SystemExit("mssh: identity file not found: %s" % path)
            kwargs["key_filename"] = paths
            # If any key is encrypted, get the passphrase up front. Otherwise
            # paramiko silently skips the key and the hop just looks like a
            # plain auth failure, which sends you debugging the wrong thing.
            phrase = _identity_passphrase(paths, opts)
            if phrase is not None:
                kwargs["passphrase"] = phrase

        verbose(opts, "%s: connecting to %s" % (label, endpoint.masked()))
        started = time.time()
        try:
            client.connect(**kwargs)
        except paramiko.AuthenticationException:
            # Compute the hint while the transport is still around.
            hint = _auth_hint(client, opts)
            client.close()
            # Key or agent auth failed and we never had a password: fall back
            # to asking, the way ssh(1) does. This is also what lets
            # --copy-id bootstrap a hop whose authorized_keys is still empty.
            if password is None and not asked and _can_prompt(opts):
                asked = True
                which = _identity_summary(opts)
                sys.stderr.write(
                    "mssh: %s: key auth failed%s, trying password\n"
                    % (label, " (%s)" % which if which else "")
                )
                _log_identities(opts, label)
                password = _prompt_password(endpoint, opts, label)
                if password is not None:
                    continue
            if not asked:
                _log_identities(opts, label)
            raise SystemExit("mssh: %s: authentication failed for %s%s"
                             % (label, endpoint, hint))
        except paramiko.BadHostKeyException as exc:
            raise SystemExit("mssh: %s: host key mismatch for %s: %s" % (label, endpoint, exc))
        except paramiko.SSHException as exc:
            # "Invalid key" here is usually the legacy-RSA problem, not a
            # corrupt key file, so attach the same hint.
            extra = _auth_hint(client, opts) if "key" in str(exc).lower() else ""
            raise SystemExit("mssh: %s: ssh error to %s: %s%s"
                             % (label, endpoint, exc, extra))
        except socket.timeout:
            raise SystemExit("mssh: %s: timed out connecting to %s" % (label, endpoint))
        except (socket.error, OSError) as exc:
            raise SystemExit("mssh: %s: cannot reach %s: %s" % (label, endpoint, exc))

        transport = client.get_transport()
        if transport is not None and opts.keepalive > 0:
            transport.set_keepalive(opts.keepalive)

        verbose(opts, "%s: connected to %s in %.3fs" % (label, endpoint, time.time() - started))
        return client


def _key_loaders():
    """Available paramiko key classes, best algorithm first.

    Mirrors DEFAULT_KEY_NAMES' ordering. DSSKey was removed in paramiko 5,
    hence the hasattr filter rather than a plain tuple.
    """
    names = ("Ed25519Key", "ECDSAKey", "RSAKey", "DSSKey")
    return [getattr(paramiko, n) for n in names if hasattr(paramiko, n)]


def _is_encrypted_key(path):
    """True if the private key file needs a passphrase to load."""
    for loader in _key_loaders():
        try:
            loader.from_private_key_file(path)
            return False            # loaded fine, not encrypted
        except paramiko.PasswordRequiredException:
            return True             # definitely encrypted
        except Exception:
            continue                # wrong key type, try the next loader
    return False


_PASSPHRASE_CACHE = {}


def _identity_passphrase(paths, opts):
    """Passphrase for the first encrypted -i key, prompting once per file."""
    for path in paths:
        if path in _PASSPHRASE_CACHE:
            return _PASSPHRASE_CACHE[path]
        if not _is_encrypted_key(path):
            continue
        if opts.no_prompt:
            raise SystemExit(
                "mssh: identity %s is passphrase-protected and --no-prompt "
                "is set; use ssh-agent or an unencrypted key" % path
            )
        try:
            phrase = getpass.getpass("passphrase for %s: " % path)
        except (EOFError, KeyboardInterrupt):
            raise SystemExit("\nmssh: aborted")
        _PASSPHRASE_CACHE[path] = phrase
        return phrase
    return None


def _rsa_only_identities(opts):
    """RSA key files among the identities we would actually offer."""
    if opts.identity:
        paths = [os.path.expanduser(p) for p in opts.identity]
    else:
        ssh_dir = os.path.expanduser("~/.ssh")
        paths = [os.path.join(ssh_dir, n) for n in DEFAULT_KEY_NAMES]
        paths = [p for p in paths if os.path.exists(p)]
    if not paths:
        return []
    rsa = []
    for path in paths:
        try:
            with open(path, "rb") as handle:
                head = handle.read(120)
        except IOError:
            continue
        # Any non-RSA key in play means SHA-1 is not the bottleneck.
        if b"OPENSSH PRIVATE KEY" in head:
            # Modern container: inspect the actual type.
            try:
                paramiko.Ed25519Key.from_private_key_file(path)
                return []          # ed25519 available, no RSA problem
            except paramiko.PasswordRequiredException:
                return []
            except Exception:
                pass
        if b"RSA PRIVATE KEY" in head or b"OPENSSH PRIVATE KEY" in head:
            rsa.append(path)
    return rsa


def _auth_hint(client, opts):
    """Explain the paramiko-5 + legacy-server RSA trap when it applies.

    Servers older than OpenSSH 7.8 accept only SHA-1 "ssh-rsa" signatures
    and do not advertise server-sig-algs. Paramiko 5 removed SHA-1 signing
    entirely, so an RSA key that works fine with the ssh(1) client fails
    here with a bare "authentication failed". Point at ed25519, which both
    sides do support.
    """
    try:
        transport = client.get_transport()
        banner = (transport.remote_version or "") if transport else ""
    except Exception:
        banner = ""

    if not _server_lacks_sha2(banner):
        return ""
    if not _rsa_only_identities(opts):
        return ""

    return (
        "\n  the server is %s, which only accepts legacy SHA-1 'ssh-rsa'\n"
        "  signatures; paramiko %s cannot produce those, so your RSA key\n"
        "  cannot be used here even though ssh(1) accepts it.\n"
        "  Use an ed25519 key instead:\n"
        "      ssh-keygen -t ed25519\n"
        "  then install it on every hop with --copy-id and the same -j\n"
        "  chain (ssh-copy-id cannot reach a host behind jumps),\n"
        "  and re-run mssh (add -i ~/.ssh/id_ed25519 if needed)."
        % (banner or "an old OpenSSH", paramiko.__version__)
    )


def _server_lacks_sha2(banner):
    """True for OpenSSH older than 7.8, which predates rsa-sha2-*."""
    match = re.search(r"OpenSSH[_-](\d+)\.(\d+)", banner or "")
    if not match:
        return False
    major, minor = int(match.group(1)), int(match.group(2))
    return (major, minor) < (7, 8)


def _has_usable_key(opts):
    """Rough guess at whether key/agent auth could work without a password."""
    if opts.identity:
        return True
    if not opts.no_agent and os.environ.get("SSH_AUTH_SOCK"):
        return True
    if not opts.no_keys:
        ssh_dir = os.path.expanduser("~/.ssh")
        for name in DEFAULT_KEY_NAMES:
            if os.path.exists(os.path.join(ssh_dir, name)):
                return True
    return False


def _default_pubkey():
    """First plausible public key in ~/.ssh, for a bare --copy-id."""
    ssh_dir = os.path.expanduser("~/.ssh")
    for name in DEFAULT_KEY_NAMES:
        path = os.path.join(ssh_dir, name + ".pub")
        if os.path.exists(path):
            return path
    return None


def read_pubkey(path):
    """Read and sanity-check a public key file, returning one line."""
    path = os.path.expanduser(path)
    if not os.path.exists(path):
        raise SystemExit("mssh: public key not found: %s" % path)
    try:
        with open(path, "r") as handle:
            content = handle.read()
    except IOError as exc:
        raise SystemExit("mssh: cannot read %s: %s" % (path, exc))

    lines = [ln.strip() for ln in content.splitlines() if ln.strip()]
    if not lines:
        raise SystemExit("mssh: %s is empty" % path)

    # Check for a private key first: it is the dangerous mistake, and it is
    # also multi-line, so this must precede the "several keys" check.
    if "PRIVATE KEY" in content or lines[0].startswith("-----"):
        raise SystemExit(
            "mssh: %s looks like a PRIVATE key -- pass the .pub file instead "
            "(e.g. %s.pub). Never copy a private key to a remote host." % (path, path)
        )
    if len(lines) > 1:
        raise SystemExit("mssh: %s holds several keys; point --copy-id at one"
                         % path)

    key = lines[0]
    if not key.split()[0].startswith(("ssh-", "ecdsa-", "sk-")):
        raise SystemExit("mssh: %s is not a valid public key line" % path)
    return key


def install_pubkey(client, endpoint, pubkey, opts, label, path=""):
    """Append pubkey to the remote authorized_keys, idempotently.

    Runs a small shell snippet remotely: it creates ~/.ssh with the right
    modes, skips the write if the key is already present, and keeps a
    timestamped backup the first time it touches the file.
    """
    # Single-quote the key for the remote shell; keys have no quotes, but
    # be strict anyway rather than trusting the input.
    quoted = "'" + pubkey.replace("'", "'\\''") + "'"
    script = (
        'set -e; '
        'KEY=%s; '
        'DIR="$HOME/.ssh"; FILE="$DIR/authorized_keys"; '
        'mkdir -p "$DIR"; chmod 700 "$DIR"; '
        'touch "$FILE"; chmod 600 "$FILE"; '
        'if grep -qxF "$KEY" "$FILE" 2>/dev/null; then '
        '  echo MSSH_ALREADY_PRESENT; '
        'else '
        '  cp -p "$FILE" "$FILE.mssh-bak.$(date +%%Y%%m%%d%%H%%M%%S)" '
        '    2>/dev/null || true; '
        '  printf "%%s\\n" "$KEY" >> "$FILE"; '
        '  echo MSSH_KEY_ADDED; '
        'fi'
    ) % quoted

    transport = client.get_transport()
    chan = transport.open_session(timeout=opts.timeout)
    try:
        chan.exec_command(script)
        out = b""
        err = b""
        while True:
            if chan.recv_ready():
                out += chan.recv(65536)
                continue
            if chan.recv_stderr_ready():
                err += chan.recv_stderr(65536)
                continue
            if chan.exit_status_ready():
                break
            select.select([chan], [], [], 0.1)
        # Drain anything buffered after exit.
        while chan.recv_ready():
            out += chan.recv(65536)
        while chan.recv_stderr_ready():
            err += chan.recv_stderr(65536)
        status = chan.recv_exit_status()
    finally:
        chan.close()

    text = out.decode("utf-8", "replace")
    if status != 0 or "MSSH_" not in text:
        detail = err.decode("utf-8", "replace").strip() or "exit %d" % status
        sys.stderr.write("mssh: %s: could not install key (%s) on %s: %s\n"
                         % (label, path, endpoint, detail))
        return False

    if "MSSH_ALREADY_PRESENT" in text:
        sys.stderr.write("mssh: %s: key (%s) already present on %s\n"
                         % (label, path, endpoint))
    else:
        sys.stderr.write("mssh: %s: key (%s) installed on %s\n"
                         % (label, path, endpoint))
    return True


def _tunnel_factory(client, hop, nxt, opts, index, total):
    """Return a callable that opens a fresh channel from `hop` to `nxt`.

    connect_hop may need more than one channel: a failed auth attempt
    leaves the channel unusable, so each retry asks for a new one.
    """
    def open_channel():
        transport = client.get_transport()
        opened = time.time()
        try:
            chan = transport.open_channel(
                "direct-tcpip",
                dest_addr=(nxt.host, nxt.port),
                src_addr=("127.0.0.1", 0),
                timeout=opts.timeout,
            )
        except paramiko.SSHException as exc:
            raise SystemExit(
                "mssh: hop %d: %s refused to forward to %s:%d: %s"
                % (index + 1, hop, nxt.host, nxt.port, exc)
            )
        verbose(opts, "hop %d/%d: tunnel %s -> %s:%d open in %.3fs"
                % (index + 1, total, hop, nxt.host, nxt.port,
                   time.time() - opened))
        return chan

    return open_channel


def build_chain(jumps, target, opts):
    """Connect through every jump host, return (clients, target_client)."""
    clients = []
    factory = None
    hops = jumps + [target]
    pubkey = read_pubkey(opts.copy_id) if opts.copy_id else None
    pubkey_path = os.path.expanduser(opts.copy_id) if opts.copy_id else None

    try:
        for i, hop in enumerate(hops):
            client = connect_hop(hop, sock_factory=factory, opts=opts,
                                 index=i, total=len(hops))
            clients.append(client)

            if pubkey is not None:
                install_pubkey(client, hop, pubkey, opts,
                               "hop %d/%d" % (i + 1, len(hops)),
                               path=pubkey_path)

            if i + 1 < len(hops):
                factory = _tunnel_factory(client, hop, hops[i + 1], opts,
                                          i, len(hops))
    except BaseException:
        close_all(clients)
        raise

    verbose(opts, "chain established: %d hop(s) in %.3fs total"
            % (len(hops), time.time() - _START_TIME))
    return clients, clients[-1]


def close_all(clients):
    for client in reversed(clients):
        try:
            client.close()
        except Exception as exc:
            _session_log("chain.close_failed", logging.WARNING, exc=exc)


