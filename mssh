def _setup_logging(opts):
    # One shared handler serializes traceback output across daemon threads.
    count = opts.verbose or 0
    level = (logging.CRITICAL + 1 if count == 0 else
             logging.WARNING if count == 1 else
             logging.INFO if count == 2 else logging.DEBUG)
    handler = logging.StreamHandler(sys.stderr)
    handler.setLevel(level)
    handler.addFilter(_SessionLogFilter())
    handler.setFormatter(logging.Formatter(
        fmt="[%(asctime)s.%(msecs)03d] %(levelname)s "
            "pid=%(process)d thread=%(threadName)s %(context)s "
            "%(name)s: %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S",
    ))
    for name in ("paramiko", "mssh.session"):
        logger = logging.getLogger(name)
        logger.handlers = [handler]
        logger.setLevel(level)
        logger.disabled = not opts.verbose
        logger.propagate = False


def verbose(opts, message):
    if (opts.verbose or 0) > 0:
        now = datetime.datetime.now()
        stamp = now.strftime("%H:%M:%S.") + "%03d" % (now.microsecond // 1000)
        elapsed = time.time() - _START_TIME
        sys.stderr.write("[%s +%7.3fs] mssh: %s\n" % (stamp, elapsed, message))
        sys.stderr.flush()


