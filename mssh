def split_copy_arg(arg):
    """Split a copy argument into (endpoint_or_None, path).

    A remote file is written the way a login target is, with ':' and the
    path appended:  [user[:password]@]host[:port]:path.  The path may be
    absolute or relative to the remote home directory, and a trailing ':'
    with nothing after it means that home directory, as in scp.

        root@10.0.0.9:/var/log/syslog      absolute
        10.0.0.9:/var/log/syslog           as the local user
        root@10.0.0.9:logs/today.log       relative to ~
        root@10.0.0.9:36001:/var/log/x     with a port
        root@10.0.0.9:                     the home directory itself

    A local path is told apart the way scp tells one: what sits before the
    first ':' has to be able to be a host name.  So './x' and '/tmp/a:b' and
    './mail@archive/x' stay local -- '/' cannot appear in a host name -- while
    'notes:2024.txt' does not: with the user optional that reads as host
    'notes', exactly as it does under scp, and a local file of that name has
    to be written './notes:2024.txt'.  Any other file name a host name cannot
    spell is local too, so an odd name is a path rather than a usage error.

    Three things cannot be written here at all, and each raises ValueError
    naming the way round it.  A password containing '/', because a host name
    has no '/' and that is what tells a local path from a credential.  A
    remote path that is all digits: 'h:8900' is host h on port 8900, as it is
    everywhere else in mssh, so as a copy argument it carries no path -- write
    'h:8900:8900' for that file, or './h:8900' for a local one.  And an empty
    port field, 'h::8900', which is either a port left out or a path beginning
    with ':' and says nothing about which -- write 'h:./:8900' for the path.
    """
    cred, sep, hostpart = arg.rpartition("@")
    if sep:
        if not cred or "/" in cred:
            # No user name, or a '/' before the '@': a local path that happens
            # to contain '@', like ./mail@archive/x.
            return None, arg
    # With no '@' at all, rpartition has already left the whole argument in
    # hostpart and cred empty, which is what we want: host[:port]:path with
    # the user defaulted.

    # Skip a bracketed IPv6 literal, whose own ':'s are not separators.
    start = 0
    bracketed = hostpart.startswith("[")
    if bracketed:
        end = hostpart.find("]")
        if end < 0:
            raise ValueError("unterminated '[' in %r" % arg)
        start = end + 1

    colon = hostpart.find(":", start)
    if colon < 0:
        # No ':' anywhere: a local path ('./x', 'x'), or a login target with
        # no path appended ('root@h').  Either way there is no remote path
        # here, and the caller reads arg as a plain path.
        return None, arg

    host, rest = hostpart[:colon], hostpart[colon + 1:]

    # Settle whether this is a remote argument at all before reading the rest
    # of it.  A host part that cannot be a host name means the ':' belonged to
    # a local file name ('./x:y', '/tmp/a:b', ':leading'), which goes back as
    # a plain path -- an odd file name is not a usage error.  Deciding it here
    # keeps the complaints below for arguments that really do name a host.
    if bracketed:
        named_host = colon == end + 1 and valid_host(host[1:end], True)
    else:
        named_host = valid_host(host)
    if not named_host:
        return None, arg

    head, tail_sep, tail = rest.partition(":")

    if tail_sep and not head:
        # 'h::8900'.  The field a port would go in is empty, and that is not
        # a spelling mssh can read: it is either the port left out by mistake
        # or a path that really begins with ':', and the argument says nothing
        # about which.  Both are writable, just not like this.
        raise ValueError(
            "%r leaves the field before the second ':' empty, where the port "
            "goes; that is either a missing port or a path starting with "
            "':', and nothing here says which -- write %r for the path, or "
            "fill the port in (%s:PORT:%s)"
            % (arg, "%s:./%s" % (host, rest), host, tail)
        )

    if head.isdigit():
        # A numeric field is the port.  What follows it, if anything, is the
        # path; on its own it is just a login target with no path.
        if not tail_sep:
            # '10.0.0.9:8900' is host and port, the way it is everywhere else
            # in mssh -- not the remote file named '8900', and not a local
            # file with a ':' in its name.  So it is a usable endpoint but
            # carries no path, which as a copy argument is incomplete: say so
            # instead of silently picking one of the three readings.  A lone
            # argument never reaches this message; main() catches it and logs
            # in to that port.
            raise ValueError(
                "%r names host %s on port %s, with no path to copy; append "
                "':' and a path (%r), or './%s' for a local file of that "
                "name" % (arg, host, head, arg + ":/tmp/", arg)
            )
        host = "%s:%s" % (host, head)
        path = tail or "."
    else:
        # Everything after the first ':' is the path, colons included, so a
        # remote name like 'h:/tmp/a:b' survives whole.  (A *local* '/tmp/a:b'
        # never reaches here -- '/tmp/a' is not a host name, so the check
        # above sent it back as a path.)
        path = rest or "."

    spec = cred + "@" + host if sep else host
    try:
        return parse_endpoint(spec), path
    except ValueError:
        # The host name passed, so what is left to reject is the credential
        # part -- ':pw@h:/tmp' has no user before the ':'.  Read it as a local
        # path with a ':' in it; plan_copy then reports "no remote path",
        # which names the fix.
        return None, arg


def plan_copy(args):
    """Turn 'SOURCE... DEST' into (direction, sources, dest, endpoint).

    ``direction`` is "up" or "down"; ``sources`` and ``dest`` are bare paths
    with the endpoint stripped off, and ``endpoint`` is the remote host they
    all refer to.  Raises ValueError on any combination we cannot serve, so
    main() can reject it before opening a connection.
    """
    if len(args) < 2:
        raise ValueError(
            "file copy needs SOURCE and DEST, e.g. "
            "./app.tar root@10.0.0.9:/tmp/"
        )

    split = [split_copy_arg(a) for a in args]
    src_marks, (dest_ep, dest) = split[:-1], split[-1]

    for _, path in src_marks:
        if not path:
            raise ValueError("empty source path")
    if not dest:
        raise ValueError("empty destination path")

    remote = [ep for ep, _ in split if ep is not None]
    if not remote:
        raise ValueError(
            "no remote path among %s; write the remote side as "
            "[user@]host:/path" % ", ".join(args)
        )

    # One target per copy: every remote argument has to name the same host,
    # and a password given on either side counts for the whole connection.
    target = remote[0]
    for ep in remote[1:]:
        if (ep.user, ep.host, ep.port) != (target.user, target.host,
                                           target.port):
            raise ValueError(
                "all remote paths must be on the same host, got %s and %s"
                % (target, ep)
            )
        if target.password is None and ep.password is not None:
            target.password = ep.password

    remote_srcs = sum(1 for ep, _ in src_marks if ep is not None)
    if dest_ep is not None:
        if remote_srcs == len(src_marks):
            raise ValueError(
                "cannot copy remote to remote: every path is on %s"
                % target.host
            )
        if remote_srcs:
            raise ValueError("cannot mix local and remote sources")
        direction = "up"
    else:
        if remote_srcs != len(src_marks):
            raise ValueError("cannot mix local and remote sources")
        direction = "down"

    return direction, [p for _, p in src_marks], dest, target


def open_target_sftp(client):
    """An SFTP session on the target, or a clear exit if there is none."""
    try:
        return client.open_sftp()
    except paramiko.SSHException as exc:
        raise SystemExit(
            "mssh: target has no sftp subsystem (%s); sshd needs a\n"
            "      'Subsystem sftp' line. For a single file you can use:\n"
            "  mssh TARGET -c 'cat > /remote/path' < ./local/path" % exc
        )
    except (socket.error, OSError) as exc:
        raise SystemExit("mssh: cannot start sftp on the target: %s" % exc)


def _human(size):
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if size < 1024 or unit == "TiB":
            if unit == "B":
                return "%d B" % size
            return "%.1f %s" % (size, unit)
        size /= 1024.0


class _Interrupted(Exception):
    """Ctrl-C during a transfer, raised at a safe chunk boundary."""

    def __init__(self, path=None, done=0):
        Exception.__init__(self, "interrupted")
        self.path = path
        self.done = done


# Ctrl-C cannot simply raise during an SFTP transfer.  The default handler
# fires at an arbitrary bytecode boundary, which in practice is halfway
# through reading a packet; paramiko then closes the remote file politely on
# the way out, reads the rest of that packet as a header, and dies with
# "Garbage packet received" -- an exception that *replaces* the
# KeyboardInterrupt, so main() never sees it.  Even when the stream survives,
# that close is synchronous and waits for every outstanding prefetch reply,
# which for a large file over a slow chain means downloading the remainder
# before exiting.  So the handler only records the request, and the transfer
# callback acts on it between chunks.
_ABORT = {"requested": False}


def _install_abort_handler():
    """Make SIGINT set a flag instead of raising.

    Returns a callable that restores the previous handlers.
    """
    previous = None

    def on_sigint(signum, frame):
        if _ABORT["requested"]:
            # Asked twice: the transfer is not responding, so stop being
            # polite and let the interrupt through even if the unwind is
            # untidy.  run_copy turns the fallout back into a clean exit.
            try:
                signal.signal(signal.SIGINT, signal.default_int_handler)
            except Exception:
                pass
            raise KeyboardInterrupt
        _ABORT["requested"] = True
        sys.stderr.write("\nmssh: interrupting transfer...\n")
        sys.stderr.flush()

    _ABORT["requested"] = False

    # Closing the channel strands paramiko's prefetch thread on a dead
    # socket, and threading prints its traceback by default.  That death is
    # the intended consequence of the teardown, not news, so drop it -- but
    # only while an abort is in flight, and only for background threads.
    old_hook = getattr(threading, "excepthook", None)

    def thread_hook(args):
        if _ABORT["requested"]:
            return
        if old_hook is not None:
            old_hook(args)

    if old_hook is not None:
        threading.excepthook = thread_hook

    try:
        previous = signal.signal(signal.SIGINT, on_sigint)
    except (ValueError, OSError, AttributeError):
        return lambda: None

    def restore():
        try:
            signal.signal(signal.SIGINT, previous)
        except Exception:
            pass
        if old_hook is not None:
            threading.excepthook = old_hook

    return restore


def _transfer_callback(sftp, label):
    """Paramiko transfer callback: checks for Ctrl-C, then draws progress.

    Paramiko calls this every 32 KiB, which makes it the natural place to
    notice an abort request -- it is a chunk boundary, so the packet stream
    is intact and we can tear the channel down deliberately.
    """
    try:
        show = sys.stderr.isatty()
    except Exception:
        show = False

    state = {"start": time.time(), "last": 0.0}
    name = os.path.basename(label) or label

    def callback(done, total):
        if _ABORT["requested"]:
            if show:
                sys.stderr.write("\n")
                sys.stderr.flush()
            # Kill the channel before unwinding.  Paramiko's file close is
            # synchronous and would otherwise wait for every outstanding
            # prefetch reply; on a dead channel it raises EOFError instead,
            # which paramiko swallows itself.
            try:
                sftp.sock.close()
            except Exception:
                pass
            raise _Interrupted(label, done)

        if not show:
            return
        now = time.time()
        # Redraw at most ~8x/s, but never skip the final frame.
        if now - state["last"] < 0.125 and 0 < done < total:
            return
        state["last"] = now
        elapsed = now - state["start"]
        pct = (100.0 * done / total) if total else 100.0
        # Below half a second the rate is dominated by timer noise -- a
        # 2 TiB/s first frame is worse than no number at all.
        rate = "%s/s" % _human(done / elapsed) if elapsed >= 0.5 else ""
        sys.stderr.write("\r\033[K%s  %s / %s  %3.0f%%  %s"
                         % (name, _human(done), _human(total), pct, rate))
        if total and done >= total:
            sys.stderr.write("\n")
        sys.stderr.flush()

    return callback


def _remote_isdir(sftp, path):
    try:
        return statmod.S_ISDIR(sftp.stat(path).st_mode)
    except IOError:
        return False


def _remote_isfile(sftp, path):
    """Does ``path`` already exist remotely?  Decides whether to set a mode."""
    try:
        sftp.stat(path)
        return True
    except IOError:
        return False


def local_umask():
    """This process's umask, for filtering a copied file's mode.

    Read from /proc where possible: the portable way to query a umask is
    umask(0) followed by umask(old), which briefly sets it to 0 -- a race
    against anything else creating a file in the meantime.

    Used for both directions.  scp filters by the *receiving* side's umask,
    and on upload that is the remote's, which SFTP gives us no way to ask
    for.  The local one is the best available answer and the same number in
    the overwhelming majority of cases (both sides 022); where it differs,
    the result is still sane -- a mode the user's own environment considers
    appropriate -- and -p is there for anyone who wants the exact bits.
    """
    try:
        with open("/proc/self/status") as fh:
            for line in fh:
                if line.startswith("Umask:"):
                    return int(line.split()[1], 8)
    except (IOError, OSError, ValueError, IndexError):
        pass
    # No /proc (or an unexpected format): fall back to the racy dance, which
    # is still better than guessing.
    current = os.umask(0o022)
    os.umask(current)
    return current


def _copy_mode(source_mode, umask):
    """The mode a freshly copied file or directory should get.

    Mirrors what open(2)/mkdir(2) do for scp on the receiving side: the
    source's permission bits filtered by the umask, with
    setuid/setgid/sticky carried through untouched, as scp carries them.

    Only applied to something this copy created.  An existing file or
    directory keeps its own mode -- overwriting a 0600 config on the target
    must not widen it because our copy happened to be 0644, and scp behaves
    the same way (measured, in both directions).
    """
    return (source_mode & ~umask & 0o777) | (source_mode & 0o7000)


def _apply_local_attrs(path, attrs):
    """Copy mode and mtime from a remote stat onto a local path (-p)."""
    try:
        if attrs.st_mode is not None:
            os.chmod(path, statmod.S_IMODE(attrs.st_mode))
        if attrs.st_mtime is not None:
            atime = attrs.st_atime if attrs.st_atime is not None \
                else attrs.st_mtime
            os.utime(path, (atime, attrs.st_mtime))
    except OSError as exc:
        sys.stderr.write("mssh: cannot preserve attributes on %s: %s\n"
                         % (path, exc))


def _apply_remote_attrs(sftp, path, st):
    """Copy mode and mtime from a local stat onto a remote path (-p)."""
    try:
        sftp.chmod(path, statmod.S_IMODE(st.st_mode))
        sftp.utime(path, (st.st_atime, st.st_mtime))
    except IOError as exc:
        sys.stderr.write("mssh: cannot preserve attributes on :%s: %s\n"
                         % (path, exc))


def _remote_mkdir(sftp, path, mode=None):
    """Create ``path`` remotely, at ``mode`` if given.

    ``mode`` is forced writable and searchable by us for the duration: a
    0555 source directory cannot be filled after it is created, so the
    narrowing happens once the contents are in (upload_path does it).
    """
    if _remote_isdir(sftp, path):
        return None
    try:
        if mode is None:
            sftp.mkdir(path)
        else:
            sftp.mkdir(path, mode | 0o700)
    except IOError as exc:
        # A parallel creation or an existing dir is fine; anything else is not.
        if not _remote_isdir(sftp, path):
            raise SystemExit("mssh: cannot create remote directory :%s: %s"
                             % (path, exc))
        return None
    try:
        return statmod.S_IMODE(sftp.stat(path).st_mode)
    except IOError:
        return None


def _check_abort():
    """Raise if Ctrl-C arrived.

    Called where no transfer callback would fire: paramiko skips the callback
    for a zero-byte file, so a tree of tiny files needs its own check.
    """
    if _ABORT["requested"]:
        raise _Interrupted()


def upload_path(sftp, local, remote, opts):
    """Copy a local file or tree to ``remote`` (which is the final name)."""
    _check_abort()
    st = os.stat(local)                      # follows symlinks, like scp
    mode = statmod.S_IMODE(st.st_mode)

    if statmod.S_ISDIR(st.st_mode):
        if not opts.recursive:
            raise SystemExit("mssh: omitting directory %s (use -r)" % local)
        created = _remote_mkdir(sftp, remote, mode)
        for name in sorted(os.listdir(local)):
            upload_path(sftp, os.path.join(local, name),
                        remote.rstrip("/") + "/" + name, opts)
        # Attributes last: writing the contents bumps the directory mtime,
        # and a read-only source directory can only be narrowed once it is
        # full.  Only a directory we created ourselves is touched -- an
        # existing one keeps its own mode, as it does under scp.
        if opts.preserve:
            _apply_remote_attrs(sftp, remote, st)
        elif created is not None:
            want = _copy_mode(mode, local_umask())
            if want != created:
                try:
                    sftp.chmod(remote, want)
                except IOError as exc:
                    sys.stderr.write("mssh: cannot set mode on :%s: %s\n"
                                     % (remote, exc))
        return

    # Does it exist already?  If so it keeps its own mode, as under scp --
    # overwriting a 0600 config on the target must not widen it just because
    # our copy happens to be 0644.  Asked before the transfer, since the
    # transfer is what creates it.
    fresh = not opts.preserve and not _remote_isfile(sftp, remote)

    try:
        sftp.put(local, remote, callback=_transfer_callback(sftp, local))
    except _Interrupted:
        raise
    except IOError as exc:
        raise SystemExit("mssh: cannot write :%s: %s" % (remote, exc))

    # paramiko's put() sends no mode at all, so the file arrives at the
    # server's default 0666 & ~its umask and an executable source lands
    # non-executable -- the reported bug.  Set it afterwards.
    if opts.preserve:
        _apply_remote_attrs(sftp, remote, st)
    elif fresh:
        want = _copy_mode(mode, local_umask())
        try:
            sftp.chmod(remote, want)
        except IOError as exc:
            sys.stderr.write("mssh: cannot set mode on :%s: %s\n"
                             % (remote, exc))


def download_path(sftp, remote, local, opts):
    """Copy a remote file or tree to ``local`` (which is the final name)."""
    _check_abort()
    try:
        attrs = sftp.stat(remote)            # follows symlinks, like scp
    except IOError as exc:
        raise SystemExit("mssh: cannot read :%s: %s" % (remote, exc))

    if attrs.st_mode is not None and statmod.S_ISDIR(attrs.st_mode):
        if not opts.recursive:
            raise SystemExit("mssh: omitting remote directory :%s (use -r)"
                             % remote)
        created = False
        if not os.path.isdir(local):
            try:
                # Writable while we fill it; narrowed below, as on upload.
                os.makedirs(local, statmod.S_IMODE(attrs.st_mode) | 0o700)
                created = True
            except OSError as exc:
                raise SystemExit("mssh: cannot create %s: %s" % (local, exc))
        for entry in sorted(sftp.listdir_attr(remote),
                            key=lambda a: a.filename):
            download_path(sftp, remote.rstrip("/") + "/" + entry.filename,
                          os.path.join(local, entry.filename), opts)
        if opts.preserve:
            _apply_local_attrs(local, attrs)
        elif created:
            try:
                want = _copy_mode(statmod.S_IMODE(attrs.st_mode),
                                  local_umask())
                if want != statmod.S_IMODE(os.stat(local).st_mode):
                    os.chmod(local, want)
            except OSError as exc:
                sys.stderr.write("mssh: cannot set mode on %s: %s\n"
                                 % (local, exc))
        return

    # As on upload: an existing file keeps its own mode, so only a file this
    # copy creates gets one.  Asked before the transfer creates it.
    fresh = not opts.preserve and not os.path.exists(local)

    try:
        sftp.get(remote, local,
                 callback=_transfer_callback(sftp, remote),
                 max_concurrent_prefetch_requests=MAX_PREFETCH)
    except _Interrupted:
        # A half-written file is worse than none: it looks complete to every
        # tool that follows.  Drop it and name it, so nothing silently uses it.
        try:
            os.unlink(local)
            sys.stderr.write("mssh: removed partial %s\n" % local)
        except OSError:
            pass
        raise
    except IOError as exc:
        raise SystemExit("mssh: cannot write %s: %s" % (local, exc))

    # paramiko's get() opens the local file with a plain open(), so the mode
    # comes from our umask alone and a downloaded script arrived
    # non-executable.  Set it afterwards, mirroring the upload side.
    if opts.preserve:
        _apply_local_attrs(local, attrs)
    elif fresh and attrs.st_mode is not None:
        want = _copy_mode(statmod.S_IMODE(attrs.st_mode), local_umask())
        try:
            os.chmod(local, want)
        except OSError as exc:
            sys.stderr.write("mssh: cannot set mode on %s: %s\n"
                             % (local, exc))


def run_copy(client, plan, opts):
    """Serve the SOURCE... DEST form over one SFTP session on the target.

    ``plan`` is the tuple main() already got from plan_copy, so the
    arguments are parsed and validated before any connection is opened.
    """
    direction, sources, dest, _ = plan

    sftp = open_target_sftp(client)
    restore_sigint = _install_abort_handler()
    try:
        if direction == "up":
            for src in sources:
                if not os.path.exists(src):
                    raise SystemExit(
                        "mssh: %s: no such file or directory" % src)
            dest_is_dir = _remote_isdir(sftp, dest)
            if len(sources) > 1 and not dest_is_dir:
                raise SystemExit(
                    "mssh: :%s is not a directory, but %d sources were given"
                    % (dest, len(sources))
                )
            for src in sources:
                target = dest
                if dest_is_dir:
                    base = os.path.basename(src.rstrip("/")) or src
                    target = dest.rstrip("/") + "/" + base
                verbose(opts, "upload %s -> :%s" % (src, target))
                upload_path(sftp, src, target, opts)
        else:
            dest_is_dir = os.path.isdir(dest)
            if len(sources) > 1 and not dest_is_dir:
                raise SystemExit(
                    "mssh: %s is not a directory, but %d sources were given"
                    % (dest, len(sources))
                )
            for src in sources:
                target = dest
                if dest_is_dir:
                    base = os.path.basename(src.rstrip("/")) or src
                    target = os.path.join(dest, base)
                verbose(opts, "download :%s -> %s" % (src, target))
                download_path(sftp, src, target, opts)
    except _Interrupted as exc:
        # The channel may still be live (an abort noticed between files rather
        # than mid-chunk); close it before the polite sftp.close() in the
        # finally block can block waiting on a reply.
        try:
            sftp.sock.close()
        except Exception:
            pass
        if exc.path is not None:
            sys.stderr.write("mssh: interrupted %s at %s\n"
                             % (os.path.basename(exc.path) or exc.path,
                                _human(exc.done)))
        else:
            sys.stderr.write("mssh: interrupted\n")
        return 130
    except (paramiko.SSHException, EOFError) as exc:
        # The channel we tore down on abort can surface as a protocol error
        # while unwinding; report the interrupt, not the debris.
        if _ABORT["requested"]:
            sys.stderr.write("mssh: interrupted\n")
            return 130
        raise SystemExit("mssh: sftp error: %s" % exc)
    finally:
        restore_sigint()
        try:
            sftp.close()
        except Exception:
            pass
    return 0


# --------------------------------------------------------------------------
# persistent session
# --------------------------------------------------------------------------
#
# A plain `mssh target -c cmd` cannot help a caller that wants to keep state:
# every run is a new process, so a `cd /var/log` in one call is gone by the
# next, along with the exported variables and the chain that took seconds to
# build.  A session keeps one local daemon holding the SSH chain and one
# long-lived remote program; each later call is a short connection to that
# daemon over a unix socket, which feeds in one command and prints its output.
#
# The remote program runs behind a pty, for two reasons found by measurement:
# without one a program's stdout and stderr arrive as two unordered streams
# (error text detaches from the output it belongs to), and only a pty gives a
# working Ctrl-C -- over pipes, signalling the foreground child leaves the
# shell to run the *rest* of the command list, which is the wrong semantics.
# The pty merges stderr into stdout; the exit status, not the stream, tells
# a caller whether a command failed.  Disable newline expansion below.

# A dumb terminal keeps programs from emitting colour and cursor escapes, but
# column-aware ones (ls, ps) still format for the width we claim here.
SESSION_TERM = "dumb"
SESSION_COLS = 200
SESSION_ROWS = 50
SESSION_STTY = "stty -echo -icanon -onlcr isig intr '^C' min 1 time 0"

# Shell mode uses a login bash (or sh) so profiles load before initialization.
# The framing needs a POSIX shell; the account's $SHELL could be csh.
SESSION_SHELL = '"$(command -v bash 2>/dev/null || echo /bin/sh)" -l'

# How one command is framed in shell mode.  The naive form -- appending
# "; printf ..." to the user's line -- is broken on ordinary input: 'sleep 1 &',
# 'echo x |', a trailing '# comment', 'if true', a heredoc and any unterminated
# quote each wedge the session, because the framing is then parsed in the same
# syntactic position as the command.  Sending the command base64-encoded and
# unwrapping it remotely puts it inside an eval instead, where none of that can
# happen.  '</dev/null' is what keeps a bare 'cat' from swallowing the next
# control line.  _Session encodes its local marker as printf escapes, so an
# echoed control line cannot be mistaken for a completed frame.
# Former SESSION_FRAME: implemented in _Session.session_frame() with
# in_path=None, which redirects the command's stdin from /dev/null.

# The same frame, but with local stdin fed to the command:
# 'echo aa | mssh --session s cat' should behave like 'echo aa | ssh host cat'.
#
# The data does not travel through the pty at all.  It goes over a second SSH
# channel, into a fifo, which the session's own shell reads -- so the command
# still runs in the long-lived shell (cwd, variables and functions intact) while
# its stdin arrives out of band.  Three simpler designs were tried first and
# each is worse:
#
#   * running the command on the second channel instead, with stdin forwarded
#     natively, loses the session: open_session starts a *new* process on the
#     target, so 'cd /tmp' and every unexported variable, function, shell
#     option, open fd and background job of the live shell do not apply to it.
#     Measured: a fresh channel saw '/' and an empty $PLAIN after the session
#     shell had done 'cd /var/log; PLAIN=p'.
#   * a base64 heredoc into a temp file keeps the shell but crawls: the pty
#     carries every byte as text for the remote shell to decode, measured at
#     0.4 MiB/s against bash, and it cannot stream -- the command sees nothing
#     until the last line arrives, so 'tail -f | mssh ...' could not work.
#   * feeding the pty directly cannot work: input still reads control bytes
#     as signals -- measured, a 0x03 in the
#     data killed the program even though canonical mode is disabled.
#
# The fifo is created by the writer channel, which announces it ('echo R')
# before blocking on the open; only then is the command framed.  That ordering
# is what makes it race-free -- a reader framed against a path that does not
# exist yet fails immediately with "No such file or directory".  Opening a fifo
# for writing blocks until the reader arrives, so by the time 'rm' runs both
# ends hold the inode: the name goes away at once while the pipe itself lives
# until both sides close.  Nothing is left on the target even if the daemon is
# killed mid-command.
# Former SESSION_FRAME_IN: implemented in _Session.session_frame() with
# in_path set to the remote fifo path.

# The writer channel's program.  'mkfifo -m 600' before anything else, so the
# path is never briefly world-writable; the readiness byte then tells the daemon
# the fifo exists.  'exec cat' replaces the shell so the channel's EOF closes
# fd 3 directly, which is what the reader sees as end of input.
SESSION_WRITER = ('mkfifo -m 600 %(path)s 2>/dev/null && echo R && '
                  'exec 3> %(path)s && rm -f %(path)s && exec cat >&3\n')
SESSION_WRITER_READY = b"R"
# A fifo per command, never one reused path.  Measured, sharing one path
# misroutes data: when a command times out its reader stays queued on the fifo,
# so the *next* command's stdin was delivered to the abandoned reader instead --
# cmd2's payload landed in cmd1's output file while cmd2 read nothing.  A unique
# path per send makes that impossible.  mkfifo costs ~5ms.

# Resynchronisation after an interrupt or a timeout: the marker carries a
# one-shot token instead of a status, so it cannot be confused with the frame
# of the command that was abandoned, however late that one arrives.
SESSION_SETUP = (
    "unset PS1 PS2 PROMPT_COMMAND; "
    "unset TMOUT 2>/dev/null || :; "
    "\n"
)

# Only the tail of the buffer is tested against --prompt: a prompt is short,
# and scanning megabytes of output on every poll would be quadratic.
SESSION_TAIL = 4096

# How long the daemon's loop sleeps when no descriptor is ready.  It only
# bounds how soon --idle, --wait and an interrupt from another thread are
# noticed; data wakes the select immediately.
SESSION_TICK = 0.05

# How much output may be held for a client that is not reading, and how much
# of its stdin may be held for a remote window that is full, before the
# producing side is dropped from the select.  One pipe's worth: enough that a
# brief pause costs nothing, small enough that the pressure reaches the remote
# program rather than growing here.
SESSION_BACKLOG = 65536

# Descriptors a request may carry: the output pipe(s), then stdin.  A send
# carries two at most (stdout, stdin); an exec carries three, since its stderr
# is a pipe of its own.  The cap is the protocol, not a buffer size -- a peer
# that sends more is not speaking it, and the extras are closed rather than
# kept.
SESSION_MAX_FDS = 3

# Terminal escapes, stripped in interactive mode before --prompt is matched.
# TERM=dumb stops most of them, but not all: a coloured prompt would put
# '\x1b[0m' after the text the user's regex anchors on, and shell-integration
# markers (OSC 633) trail every prompt in some environments -- either one
# makes a correct '...$'-anchored regex silently never match.
SESSION_ESC_RE = re.compile(
    rb"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)"      # OSC ... BEL / ST
    rb"|\x1b\[[0-?]*[ -/]*[@-~]"               # CSI
    rb"|\x1b[@-Z\\-_]"                         # two-character escapes
)


class SessionGone(Exception):
    """No live daemon is listening on that session's socket."""


class _SessionDead(Exception):
    """The remote program behind the session has exited."""


def stdin_kind(fd=None):
    """What the client's stdin is: 'pipe', 'file', 'tty', 'null' or 'none'.

    The kind, not the command, is what decides whether stdin is forwarded.
    Guessing from the command line cannot work -- 'cat' reads it, 'ls' does not,
    and 'sh -c "..."' could do either -- while fstat answers for free and reads
    nothing, so a command that turns out to ignore its input costs nothing.

    'null' is told apart from 'pipe' by device number, not by name: a command
    reading /dev/null and one given no input at all are indistinguishable, so
    forwarding it would set up a channel and a fifo to deliver nothing.  That
    matters because scripts, cron jobs and agents write '</dev/null' routinely.
    """
    if fd is None:
        fd = stdin_fd()
    if fd is None:
        return "none"
    try:
        st = os.fstat(fd)
    except OSError:
        return "none"
    if statmod.S_ISFIFO(st.st_mode) or statmod.S_ISSOCK(st.st_mode):
        return "pipe"
    if statmod.S_ISREG(st.st_mode):
        return "file"
    if statmod.S_ISCHR(st.st_mode):
        try:
            if st.st_rdev == os.stat(os.devnull).st_rdev:
                return "null"
        except OSError:
            pass
        try:
            if os.isatty(fd):
                return "tty"
        except OSError:
            pass
        return "pipe"                     # some other character device
    return "pipe"


def want_stdin(opts, with_pty=False):
    """True if this send should carry the client's stdin to the remote command.

    A pipe or a regular file is forwarded: that is 'echo aa | mssh --session s
    cat' and 'mssh --session s wc -l <file', both of which mean to send data.

    A terminal is not, unless --stdin asks for it.  Forwarding it by default
    would make the ordinary interactive 'mssh --session s ls' sit waiting for
    the user to type an EOF before the command could finish.

    /dev/null and a closed stdin are never forwarded; there is nothing to send.

    with_pty inverts the terminal rule, and only that rule: the command is
    about to be given a terminal to read from, which is exactly the case the
    default is written to avoid.  It says the pty was really asked for, not
    merely that -t was typed -- with stdout redirected there is no pty, and
    forwarding the terminal anyway would leave 'mssh --session s --exec -t ls
    > out' waiting for a Ctrl-D that the user has no reason to type.
    """
    if opts.no_stdin:
        return False
    kind = stdin_kind()
    if kind == "tty":
        return bool(with_pty or opts.stdin)
    return kind in ("pipe", "file")


def session_dir():
    """Directory holding session sockets, created 0700 and checked on use.

    Always ~/.mssh/sessions, never $XDG_RUNTIME_DIR: that variable is set in
    some shells and not others (a desktop terminal has it, a cron job or an
    `ssh host` command does not), so keying off it split one user's sessions
    into two namespaces -- a session started from one shell was invisible to
    `--sessions` in another.  $HOME is the thing that actually identifies the
    user here.

    Holding one of these sockets is equivalent to being logged in on the
    target, so the directory is guarded like a private key rather than like a
    temp file: never a predictable path in /tmp, owner-only, and re-verified
    on every use rather than only at creation.
    """
    path = os.path.join(os.path.expanduser("~"), ".mssh", "sessions")

    try:
        os.makedirs(path, 0o700)
    except OSError:
        pass

    try:
        st = os.lstat(path)
    except OSError as exc:
        raise SystemExit("mssh: cannot use session directory %s: %s"
                         % (path, exc))
    if not statmod.S_ISDIR(st.st_mode):
        raise SystemExit("mssh: session directory %s is not a directory"
                         % path)
    if st.st_uid != os.getuid():
        raise SystemExit("mssh: session directory %s belongs to uid %d, not "
                         "you -- refusing to use it" % (path, st.st_uid))
    if st.st_mode & 0o077:
        os.chmod(path, 0o700)
    return path


def session_path(name):
    """Socket path for a session name, with the name validated first."""
    if not SESSION_NAME_RE.match(name or ""):
        raise SystemExit(
            "mssh: invalid session name %r; use up to 64 characters from "
            "A-Z a-z 0-9 . _ - starting with a letter, digit or _" % (name,)
        )
    return os.path.join(session_dir(), name + ".sock")


def _peer_uid(conn):
    """uid of the process on the other end of a unix socket, or None."""
    import struct
    try:
        blob = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                               struct.calcsize("3i"))
    except (AttributeError, OSError):
        return None
    _pid, uid, _gid = struct.unpack("3i", blob)
    return uid


class _ClientGone(Exception):
    """The client that asked for this command is no longer listening."""


class _BufSink(object):
    """Collects output in memory, for the setup banner and for drains.

    The same sink interface as _FdSink, so one loop serves both: the only
    difference is where the bytes end up.
    """

    wfd = None
    backlog = 0

    def __init__(self):
        self.chunks = []

    def write(self, data):
        if data:
            self.chunks.append(data)

    def flush(self):
        return True

    def drain(self):
        pass

    def value(self):
        return b"".join(self.chunks)


class _FdSink(object):
    """Output bytes to the client's pipe, buffering whatever will not fit.

    The descriptor is the write end of a pipe the client created and handed
    over with its request, so the command's output never passes through JSON:
    it is copied from the channel to this fd and read straight off the other
    end.  Nothing frames it, so nothing has to encode it.

    The fd is non-blocking because this is the only thread: a write that
    blocked -- a client paused in a pager, a terminal that stopped scrolling --
    would stop the loop reading the channel, the client's stdin and the request
    socket alike.  What will not fit is held here instead, and the loop stops
    reading the channel once too much has piled up, so the backpressure reaches
    the remote program through the SSH window rather than growing in the
    daemon.
    """

    def __init__(self, fd):
        self.wfd = fd
        self.buf = b""
        self.gone = False

    @property
    def backlog(self):
        return len(self.buf)

    def write(self, data):
        if data and not self.gone:
            self.buf += data
            self.flush()

    def flush(self):
        """Push what the pipe will take.  False once the reader is gone."""
        while self.buf and not self.gone:
            try:
                sent = os.write(self.wfd, self.buf)
            except BlockingIOError:
                break                     # the pipe is full; select on it
            except OSError as exc:
                _session_log("output.write_failed", logging.DEBUG,
                             exc=exc, fd=self.wfd)
                # The client died or closed its end.  Drop what is left: there
                # is nobody to hand it to, and the command still frames on its
                # own marker.
                self.gone = True
                self.buf = b""
                break
            self.buf = self.buf[sent:]
        return not self.gone

    def drain(self, limit=30.0):
        """Block until the last of the output is in the pipe.

        Called once, after the command has ended and before the descriptor is
        closed: whatever the pipe was too full to take is still the command's
        output, and closing on it would truncate the tail of a command whose
        client reads slowly.  Blocking is safe here only because nothing else
        is left to watch -- the frame is closed and the lock is about to go.
        """
        deadline = time.time() + limit
        while self.buf and not self.gone and self.flush():
            if not self.buf:
                break
            remaining = deadline - time.time()
            if remaining <= 0:
                break                     # a client that never reads again
            try:
                if not select.select([], [self.wfd], [], remaining)[1]:
                    break
            except (select.error, InterruptedError) as exc:
                _session_log("output.drain_select_failed", logging.DEBUG,
                             exc=exc, fd=self.wfd)
                continue


class _ShellFramer(object):
    """Shell mode: everything up to our frame marker is the command's output.

    One line is held back, because the framing printf writes a newline of its
    own that is not part of the command's output: when the marker comes
    straight after a line, that line was the command's last and its newline was
    the frame's, so emitting it earlier would append a newline the command
    never printed.

    The hold is released after --idle of quiet, which is what lets an
    interactive filter work.  Without that release the holdback was unbounded:
    'mssh --session s --stdin cat' showed nothing at all until Ctrl-D, because
    each typed line sat here waiting for the next one.  A held line is safe to
    release once the output goes quiet, since a real frame marker follows its
    line immediately -- far inside --idle -- so anything still held after a
    pause had a newline of its own.
    """

    def __init__(self, session):
        self.session = session
        self.tail = b""
        self.held = None
        self.last_data = time.time()

    def feed(self, data, sink):
        """Hand this chunk to the sink.  (status, False) at the marker."""
        session = self.session
        self.last_data = time.time()
        self.tail += data
        lines = self.tail.split(b"\n")
        self.tail = lines.pop()
        for raw in lines:
            line = session._clean(raw)
            status = session._marker_status(line)
            if status is None:
                if self.held is not None:
                    sink.write(self.held + b"\n")
                self.held = line
                continue
            if self.held:
                # A last line that had no newline of its own.
                sink.write(self.held)
            self.held = None
            return (status, False)
        return None

    def idle(self, sink, now):
        """Release what a pause proves was complete.  Never ends the frame."""
        if now - self.last_data < self.session.idle:
            return None
        if self.held is not None:
            # Nothing followed it, so its newline was real: hand it over
            # rather than waiting for a line that may never come.
            sink.write(self.held + b"\n")
            self.held = None
        if self.tail and not self.session.mark.startswith(
                self.tail.rstrip(b"\r")):
            # A partial line that has gone quiet: a prompt, a progress bar, a
            # status line.  Release it once it cannot be the start of the
            # marker, so a command that asks a question is not held back.
            sink.write(self.session._clean(self.tail))
            self.tail = b""
        return None

    def flush(self, sink, newline=True):
        """Hand over the leftovers when no marker is going to come."""
        if self.held is not None:
            sink.write(self.held + b"\n" if newline else self.held)
            self.held = None
        if self.tail:
            sink.write(self.session._clean(self.tail))
            self.tail = b""

    def on_abort(self, sink):
        # Ctrl-C destroyed the whole command list, the framing printf
        # included, so no marker is coming; resynchronise instead.  The held
        # line keeps its own newline here, since the frame never printed one.
        self.flush(sink, newline=False)
        self.session._resync()
        return (130, False)


class _InteractiveFramer(object):
    """Interactive mode: a reply ends at --prompt, or at a pause without one.

    --prompt is matched against one line at a time -- the trailing partial line
    first, since that is where an interactive program leaves its prompt, then
    whole lines, for the rarer program that ends its prompt with a newline.
    Matching the whole buffer instead would frame early on output that merely
    quoted something prompt-shaped.
    """

    def __init__(self, session):
        self.session = session
        self.tail = b""
        self.last_data = time.time()

    def feed(self, data, sink):
        session = self.session
        self.last_data = time.time()
        self.tail += data
        lines = self.tail.split(b"\n")
        self.tail = lines.pop()
        for raw in lines:
            line = session._clean(raw)
            if session.prompt_re is not None:
                match = session._prompt_at_end(line)
                if match is not None:
                    if match:
                        sink.write(match)
                    return (None, False)
            sink.write(line + b"\n")
        if session.prompt_re is not None:
            match = session._prompt_at_end(session._clean(self.tail))
            if match is not None:
                if match:
                    sink.write(match)
                return (None, False)
        return None

    def idle(self, sink, now):
        session = self.session
        if session.prompt_re is not None:
            return None
        if now - self.last_data < session.idle:
            return None
        # No --prompt: fall back to "nothing new for a while".  This is a
        # heuristic, which is why --prompt exists.
        if self.tail:
            sink.write(session._clean(self.tail))
            self.tail = b""
            return None
        return (None, False)

    def flush(self, sink, newline=True):
        if self.tail:
            sink.write(self.session._clean(self.tail))
            self.tail = b""

    def on_abort(self, sink):
        self.flush(sink)
        # Deliver Ctrl-C, then drain the program's replacement prompt so the
        # next command frames cleanly without closing the primary channel.
        self.session._resync()
        return (130, False)


def _close_session_channel(chan):
    """Close a session channel without stranding its transport on EBADF.

    Channel.fileno() creates an OS pipe for select() and installs its
    notifications on both receive buffers. The transport thread calls
    BufferedPipe.feed(), which signals that pipe when remote data arrives.

    In affected Paramiko versions, Channel.close() calls PosixPipe.close(),
    which closes the file descriptors before setting its _closed flag. During
    that interval, a concurrent feed() can call PosixPipe.set(), observe
    _closed as False, and write to an already closed descriptor. The resulting
    OSError escapes into Transport.run(), ending the shared SSH connection,
    not just the SFTP/exec channel being cancelled.

    Replace both receive notifications before closing the channel. Each
    BufferedPipe.set_event() holds the same buffer lock as feed()/read(),
    so it waits for any existing notification to finish; future notifications
    use an ordinary Event with no OS descriptor to close. This is a local
    compatibility workaround, not a global Paramiko patch or error suppression.
    It does not address the client's separate SFTP prefetch cancellation.
    """
    if isinstance(chan, paramiko.Channel):
        # Match fileno()/_set_closed(): channel lock, then buffer locks.
        # Both stdout and stderr can signal the same pipe, so detach both.
        # Use real Events: set_event(None) is not supported by Paramiko.
        with chan.lock:
            chan.in_buffer.set_event(threading.Event())
            chan.in_stderr_buffer.set_event(threading.Event())
        # Channel.close() acquires the non-reentrant channel lock itself.
        # Keep its normal EOF/CLOSE packets, waiter notifications and pipe
        # cleanup; only the buffers' notification destinations have changed.
        # The caller must not resume polling/using this channel after closing.
    # Test channels and other adapters retain their own close semantics.
    chan.close()


class _ExecJob(object):
    """One tracked shell command, exec/login, SFTP transfer, or local forward.

    Independent exec/login/SFTP channels are closed on targeted interruption.
    Shell jobs instead flag their pump, keeping the shared shell channel alive.
    Forward jobs override abort() to close their listener and connections.
    """

    def __init__(self, chan, kind="exec", command="", token=None, default=False):
        self.chan = chan
        self.kind = kind
        self.command = command
        self.started = time.time()
        self.id = None
        # Match a client's Ctrl-C to its own exec/login request, even when
        # other jobs are running and the client has not fetched --jobs.
        self.token = token
        self.default = default
        self.aborted = False

    def abort(self):
        self.aborted = True
        if self.default:
            # The primary channel survives cancellation. Its owning pump
            # sends Ctrl-C and resynchronizes before the next request.
            return
        _session_log("channel.abort", chan=self.chan)
        try:
            _close_session_channel(self.chan)
        except Exception as exc:
            _session_log("channel.abort_failed", logging.ERROR,
                         chan=self.chan, exc=exc)


def parse_local_forward(spec):
    """Parse the four SSH -L forms; slash-containing fields are socket paths."""
    if not isinstance(spec, str) or not spec:
        raise ValueError("-L expects a TCP or Unix socket forwarding specification")
    fields, field, bracketed, escaped, closed_bracket = [], "", False, False, False
    for char in spec:
        if closed_bracket and char != ":":
            raise ValueError("unexpected characters after bracket in -L")
        if escaped:
            field += char
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == "[" and not field and not bracketed:
            bracketed = True
        elif char == "]" and bracketed:
            if "/" not in field:
                try:
                    ipaddress.IPv6Address(field.split("%", 1)[0])
                except ValueError:
                    raise ValueError("invalid IPv6 address in -L: %r" % field)
            bracketed = False
            closed_bracket = True
        elif char == ":" and not bracketed:
            fields.append(field)
            field = ""
            closed_bracket = False
        else:
            field += char
    if escaped or bracketed:
        raise ValueError("unterminated escape or bracket in -L")
    fields.append(field)

    local_socket = remote_socket = None
    if len(fields) == 2 and "/" in fields[0] and "/" in fields[1]:
        local_socket, remote_socket = fields
    elif len(fields) == 2 and "/" in fields[1]:
        bind, port = "localhost", fields[0]
        remote_socket = fields[1]
    elif len(fields) == 3 and "/" in fields[0]:
        local_socket, host, hostport = fields
    elif len(fields) == 3 and "/" in fields[2]:
        bind, port, remote_socket = fields
    elif len(fields) in (3, 4):
        bind, port, host, hostport = (
            ["localhost"] + fields if len(fields) == 3 else fields)
    else:
        raise ValueError("-L expects [bind:]port:host:hostport, "
                         "[bind:]port:remote_socket, local_socket:host:hostport "
                         "or local_socket:remote_socket")

    settings = {}
    for key, path in (("local_socket", local_socket), ("remote_socket", remote_socket)):
        if path is not None:
            if "\x00" in path or any(ord(char) < 32 for char in path):
                raise ValueError("invalid Unix socket path in -L")
            settings[key] = os.path.abspath(path) if key == "local_socket" else path
    addresses = []
    if local_socket is None:
        addresses.append(bind)
    if remote_socket is None:
        addresses.append(host)
        if host in ("", "*"):
            raise ValueError("-L requires a destination host")
    for value in addresses:
        if ":" in value:
            try:
                ipaddress.IPv6Address(value.split("%", 1)[0])
            except ValueError:
                raise ValueError("invalid IPv6 address in -L: %r" % value)
        if value not in ("", "*") and not valid_host(
                value, bracketed=":" in value):
            raise ValueError("invalid host in -L: %r" % value)
    for key, value in (("port", port if local_socket is None else None),
                       ("hostport", hostport if remote_socket is None else None)):
        if value is not None:
            if not re.fullmatch("[0-9]+", value) or not 1 <= int(value) <= 65535:
                raise ValueError("-L ports must be between 1 and 65535")
            settings[key] = int(value)
    if local_socket is None:
        settings["bind"] = bind
    if remote_socket is None:
        settings["host"] = host
    return settings


def _local_forward_spec(settings):
    """Serialize parsed settings before sending client-relative paths to a daemon."""
    def field(value):
        return str(value).replace("\\", "\\\\").replace(":", "\\:") \
            .replace("[", "\\[").replace("]", "\\]")

    local = [settings["local_socket"]] if "local_socket" in settings else [
        settings["bind"], settings["port"]]
    remote = [settings["remote_socket"]] if "remote_socket" in settings else [
        settings["host"], settings["hostport"]]
    local_fields = [field(value) for value in local]
    remote_fields = [field(value) for value in remote]
    # Keep TCP-only specs compatible with existing daemons, whose parser
    # accepts bracketed IPv6 but not backslash-escaped address colons.
    if "local_socket" not in settings and ":" in settings["bind"]:
        local_fields[0] = "[%s]" % settings["bind"]
    if "remote_socket" not in settings and ":" in settings["host"]:
        remote_fields[0] = "[%s]" % settings["host"]
    return ":".join(local_fields + remote_fields)


class _StreamLocalChannel(paramiko.Channel):
    """Close a late OPEN_SUCCESS after its streamlocal opener has timed out."""

    open_abandoned = False

    def _unlink(self):
        super(_StreamLocalChannel, self)._unlink()
        if self.open_abandoned:
            # Transport shutdown unlinks even unopened channels. Channel's
            # base implementation skips closed ones, so release our retained
            # pending-open event as well when no response can arrive anymore.
            self.transport._channels.delete(self.chanid)
            self.transport.channel_events.pop(self.chanid, None)

    def _set_remote_channel(self, chanid, window_size, max_packet_size):
        super(_StreamLocalChannel, self)._set_remote_channel(
            chanid, window_size, max_packet_size)
        if self.open_abandoned:
            from paramiko.common import cMSG_CHANNEL_CLOSE

            # Paramiko invokes this in the transport thread under its lock.
            # Cancellation already closed the local buffers, but could not
            # send CLOSE without this remote ID. Do not call Channel.close():
            # it skips already-closed channels, and its _send_user_message()
            # can wait for rekeying that this very transport thread must drive.
            self.active = False
            message = paramiko.Message()
            message.add_byte(cMSG_CHANNEL_CLOSE)
            message.add_int(chanid)
            try:
                # An abandoned open can outlive its transport; a send failure
                # here would escape into Transport.run() and tear down the
                # whole connection. The remote socket dies with that
                # connection, so dropping the CLOSE is the correct outcome.
                self.transport._send_message(message)
            except Exception:
                pass
            self.transport._channels.delete(self.chanid)


def _open_streamlocal_channel(transport, path, timeout):
    """Open OpenSSH's direct-streamlocal channel using Paramiko's channel lifecycle.

    Transport.open_channel() accepts extension names but only encodes address
    fields for TCP/X11. OpenSSH PROTOCOL section 2.4 requires a socket path,
    an empty reserved string and a zero reserved integer. Keep this adapter
    local to streamlocal opens, using the same transport lock, channel map,
    event and SSHException handling as Paramiko 3.x/5.x open_channel().
    """
    from paramiko.common import cMSG_CHANNEL_OPEN

    with transport.lock:
        if not transport.is_active():
            raise paramiko.SSHException("SSH session not active")
        chanid = transport._next_channel()
        chan = _StreamLocalChannel(chanid)
        event = threading.Event()
        # Paramiko's channel map holds weak references. Retain an abandoned
        # pending open until SUCCESS/FAILURE (or transport shutdown), so a late
        # SUCCESS still has a channel that can send the matching remote CLOSE.
        event.channel = chan
        window = transport.default_window_size
        packet = transport.default_max_packet_size
        message = paramiko.Message()
        message.add_byte(cMSG_CHANNEL_OPEN)
        message.add_string("direct-streamlocal@openssh.com")
        message.add_int(chanid)
        message.add_int(window)
        message.add_int(packet)
        message.add_string(path)
        message.add_string("")
        message.add_int(0)
        transport._channels.put(chanid, chan)
        transport.channel_events[chanid] = event
        transport.channels_seen[chanid] = True
        chan._set_transport(transport)
        chan._set_window(window, packet)
    sent = False
    try:
        transport._send_user_message(message)
        sent = True
        deadline = time.monotonic() + timeout
        while not event.is_set():
            if not transport.is_active():
                raise transport.get_exception() or paramiko.SSHException(
                    "Unable to open streamlocal channel")
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise paramiko.SSHException("Timeout opening streamlocal channel")
            event.wait(min(remaining, 0.1))
        result = transport._channels.get(chanid)
        if result is None or not transport.is_active():
            raise transport.get_exception() or paramiko.SSHException(
                "Unable to open streamlocal channel")
        return result
    except BaseException:
        # Open responses and cancellation are serialized by transport.lock.
        # SSH has no cancel-open request: deleting a pending channel would
        # discard a late SUCCESS and leave its remote socket open indefinitely.
        # Keep only pending opens until the peer answers; established channels
        # use normal close outside the transport lock.
        with transport.lock:
            pending = sent and transport.is_active() and not chan.active \
                and chanid in transport.channel_events
            if pending:
                chan.open_abandoned = True
                with chan.lock:
                    chan._set_closed()
            else:
                transport.channel_events.pop(chanid, None)
        if not pending:
            _close_session_channel(chan)
            chan._unlink()
            transport._channels.delete(chanid)
        raise


def _forward_address(host, port):
    return "%s:%d" % ("[%s]" % host if ":" in host else host, port)


def parse_dynamic_forward(spec):
    """Parse SSH -D [bind_address:]port using the same TCP bind rules as -L."""
    if not isinstance(spec, str) or not re.fullmatch(
            r"(?:(\[[^\]]+\]|[^:]*):)?[0-9]+", spec):
        raise ValueError("-D expects [bind_address:]port")
    try:
        settings = parse_local_forward(spec + ":localhost:1")
    except ValueError as exc:
        raise ValueError(str(exc).replace("-L", "-D"))
    return {"bind": settings["bind"], "port": settings["port"], "dynamic": True}


class _SocksRequest(object):
    """One bounded SOCKS4/4a or SOCKS5 CONNECT handshake, not a data relay.

    Field widths below are bytes; all two-byte ports use network byte order.
    TCP may split or combine messages, so _read() consumes exact field sizes
    and leaves any application data following CONNECT for the stream relay.
    """

    def __init__(self, conn, timeout):
        self.conn = conn
        self.deadline = time.monotonic() + max(timeout, 1.0)
        self.version = None
        self.replied = False

    def _read(self, size):
        data = bytearray()
        while len(data) < size:
            remaining = self.deadline - time.monotonic()
            if remaining <= 0:
                raise socket.timeout("SOCKS handshake timed out")
            self.conn.settimeout(remaining)
            chunk = self.conn.recv(size - len(data))
            if not chunk:
                raise EOFError("client closed during SOCKS handshake")
            data.extend(chunk)
        return bytes(data)

    def _string(self, limit):
        data = bytearray()
        for _ in range(limit + 1):
            byte = self._read(1)
            if byte == b"\x00":
                return bytes(data)
            data.extend(byte)
        raise ValueError("SOCKS string exceeds length limit")

    def reply(self, code=0):
        if self.replied or self.version is None:
            return
        self.replied = True
        # SOCKS5: VER(1)=5 | REP(1) | RSV(1)=0 | ATYP(1)=1 |
        #         BND.ADDR(4)=0.0.0.0 | BND.PORT(2)=0
        # REP: 0 success, 1 general failure, 2 denied, 4 host unreachable,
        #      7 command unsupported, 8 address type unsupported.
        # SOCKS4/4a: VN(1)=0 | CD(1)=90 granted/91 rejected |
        #            DSTPORT(2)=0 | DSTIP(4)=0.0.0.0
        # This proxy has no local socket bound to the destination: the target
        # SSH server opens it. Return an unspecified BND.ADDR/BND.PORT, just as
        # SSH dynamic forwarding does, and send success only after channel open.
        packet = bytes((5, code, 0, 1)) + b"\x00" * 6 if self.version == 5 \
            else bytes((0, 90 if code == 0 else 91)) + b"\x00" * 6
        self.conn.sendall(packet)

    def _reject(self, code, message):
        self.reply(code)
        raise ValueError(message)

    def destination(self):
        version = self._read(1)[0]
        if version == 5:
            # Method negotiation (RFC 1928):
            # client: VER(1)=5 | NMETHODS(1) | METHODS(NMETHODS)
            # server: VER(1)=5 | METHOD(1), 0=no authentication, 255=no match.
            # The request below follows only after selecting method 0.
            count = self._read(1)[0]
            methods = self._read(count)
            if not count or 0 not in methods:
                self.conn.sendall(b"\x05\xff")
                raise ValueError("SOCKS5 requires the no-authentication method")
            self.conn.sendall(b"\x05\x00")
            self.version = 5
            # CONNECT request:
            # VER(1)=5 | CMD(1)=1 | RSV(1)=0 | ATYP(1) |
            # DST.ADDR(variable) | DST.PORT(2)
            # ATYP=1: IPv4(4); ATYP=4: IPv6(16);
            # ATYP=3: name length(1) followed by that many bytes, no NUL.
            # CMD=2 is BIND and CMD=3 is UDP ASSOCIATE; neither is supported.
            version, command, reserved, address_type = self._read(4)
            if version != 5 or reserved != 0:
                self._reject(1, "invalid SOCKS5 request header")
            if command != 1:
                self._reject(7, "SOCKS5 only supports CONNECT")
            if address_type == 1:
                host = socket.inet_ntop(socket.AF_INET, self._read(4))
            elif address_type == 4:
                host = socket.inet_ntop(socket.AF_INET6, self._read(16))
            elif address_type == 3:
                length = self._read(1)[0]
                host = self._read(length).decode("ascii")
                if not host or not valid_host(host):
                    self._reject(4, "invalid SOCKS5 destination name")
            else:
                self._reject(8, "unsupported SOCKS5 address type")
            port = int.from_bytes(self._read(2), "big")
        elif version == 4:
            # SOCKS4 has no method negotiation:
            # VN(1)=4 | CD(1)=1 CONNECT | DSTPORT(2) | DSTIP(4) |
            # USERID(variable) | NUL(1)
            # SOCKS4a uses DSTIP=0.0.0.x (x != 0) and appends
            # DOMAIN(variable) | NUL(1) after USERID's NUL.
            # CD=2 (BIND) is unsupported. USERID is consumed, not authenticated.
            self.version = 4
            if self._read(1)[0] != 1:
                self._reject(7, "SOCKS4 only supports CONNECT")
            port = int.from_bytes(self._read(2), "big")
            address = self._read(4)
            # Consume USERID without logging it. SOCKS4a signals that a domain
            # follows with 0.0.0.x (x != 0); never resolve that name locally.
            self._string(1024)
            if address[:3] == b"\x00\x00\x00" and address[3] != 0:
                host = self._string(255).decode("ascii")
                if not host or not valid_host(host):
                    self._reject(4, "invalid SOCKS4a destination name")
            else:
                host = socket.inet_ntop(socket.AF_INET, address)
        else:
            raise ValueError("unsupported SOCKS version")
        if not port:
            self._reject(1, "SOCKS destination port must be between 1 and 65535")
        return host, port


class _LocalForwardJob(_ExecJob):
    """One persistent listener job, owning every accepted socket and channel."""

    def __init__(self, session, settings):
        super(_LocalForwardJob, self).__init__(None, "forward")
        self.session = session
        self.dynamic = settings.get("dynamic", False)
        self.remote_socket = settings.get("remote_socket")
        self.destination = None if self.dynamic else self.remote_socket or (
            settings["host"], settings["hostport"])
        self.socket_path = settings.get("local_socket")
        self.socket_identity = None
        self.listeners = []
        self.connections = {}
        self.lock = threading.Lock()
        self.closed = threading.Event()
        self.worker = None
        bind = settings.get("bind")
        addresses = [(socket.AF_UNIX, socket.SOCK_STREAM, 0, "", self.socket_path)] \
            if self.socket_path else socket.getaddrinfo(
            None if bind in ("", "*") else bind, settings["port"],
            socket.AF_UNSPEC, socket.SOCK_STREAM, 0,
            socket.AI_PASSIVE if bind in ("", "*") else 0)
        seen = set()
        try:
            for family, socktype, protocol, _name, address in addresses:
                if address in seen:
                    continue
                seen.add(address)
                listener = None
                try:
                    listener = socket.socket(family, socktype, protocol)
                    if family != socket.AF_UNIX:
                        listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                    if family == socket.AF_INET6:
                        listener.setsockopt(socket.IPPROTO_IPV6,
                                            socket.IPV6_V6ONLY, 1)
                    listener.bind(address)
                    if family == socket.AF_UNIX:
                        # Never unlink an existing pathname before bind. Track
                        # the inode we created so teardown preserves replacements.
                        st = os.lstat(address)
                        self.socket_identity = (st.st_dev, st.st_ino)
                        os.chmod(address, 0o600)
                    listener.listen(128)
                    listener.setblocking(False)
                except OSError as exc:
                    if listener is not None:
                        listener.close()
                    # Default loopback/wildcard still works on IPv4-only
                    # hosts. Port conflicts must fail, not silently expose
                    # only some of the requested bind addresses.
                    if family == socket.AF_INET6 and bind in ("localhost", "", "*") \
                            and exc.errno in (errno.EAFNOSUPPORT, errno.EADDRNOTAVAIL,
                                              errno.ENOPROTOOPT):
                        continue
                    raise
                self.listeners.append(listener)
            if not self.listeners:
                raise ValueError("forward bind address has no usable addresses")
        except BaseException:
            for listener in self.listeners:
                listener.close()
            self._unlink_socket()
            raise
        self.command = "%s -> %s" % (
            self.socket_path or _forward_address(bind or "*", settings["port"]),
            "SOCKS4/5" if self.dynamic else
            self.remote_socket or _forward_address(*self.destination))

    def _unlink_socket(self):
        if self.socket_identity is None:
            return
        try:
            st = os.lstat(self.socket_path)
            if statmod.S_ISSOCK(st.st_mode) and \
                    (st.st_dev, st.st_ino) == self.socket_identity:
                os.unlink(self.socket_path)
        except FileNotFoundError:
            pass
        except OSError as exc:
            _session_log("forward.socket_unlink_failed", logging.WARNING,
                         self.session, exc=exc, job=self.id)

    def start(self):
        # Registration makes the job visible before this call. An interrupt
        # must not join a thread that is constructed but not yet started, or
        # let an already-cancelled job start accepting connections afterward.
        with self.lock:
            if self.aborted:
                return
            worker = threading.Thread(target=self._accept,
                                      name="forward-%s" % self.id)
            worker.daemon = True
            worker.start()
            self.worker = worker

    def abort(self):
        with self.lock:
            closing = self.aborted
            if not closing:
                self.aborted = True
                listeners = list(self.listeners)
                connections = list(self.connections.items())
        if closing:
            # Concurrent interrupts acknowledge only after resources close.
            # The acceptor's finally must not wait: the closing thread may
            # already be joining that acceptor.
            if threading.current_thread() is not self.worker:
                self.closed.wait()
            return
        # Do not hold the ownership lock while closing: workers need it to
        # release channels, including opens which finish after cancellation.
        try:
            for listener in listeners:
                # close() alone may leave a listening FD alive while another
                # thread's select holds it. shutdown wakes that select and
                # stops accepting before the interrupt is acknowledged.
                try:
                    listener.shutdown(socket.SHUT_RDWR)
                except OSError:
                    pass
                listener.close()
            for conn, chan in connections:
                try:
                    conn.shutdown(socket.SHUT_RDWR)
                except OSError:
                    pass
                conn.close()
                if chan is not None:
                    try:
                        _close_session_channel(chan)
                    except Exception as exc:
                        _session_log("forward.close_failed", logging.WARNING,
                                     self.session, chan, exc, job=self.id)
        finally:
            self._unlink_socket()
            with self.session.execs_lock:
                self.session.execs.discard(self)
            self.closed.set()
        if self.worker is not None and self.worker is not threading.current_thread():
            self.worker.join(1)
        _session_log("forward.stopped", session=self.session, job=self.id)

    def _accept(self):
        try:
            while not self.aborted and not self.session.stopping.is_set():
                ready, _, _ = select.select(self.listeners, [], [], SESSION_TICK)
                for listener in ready:
                    try:
                        conn, origin = listener.accept()
                    except BlockingIOError:
                        continue
                    with self.lock:
                        if self.aborted or self.session.stopping.is_set():
                            conn.close()
                            return
                        # Register before starting the worker so --interrupt
                        # also owns connections waiting for SSH channel open.
                        self.connections[conn] = None
                    worker = threading.Thread(
                        target=self._connect, args=(conn, origin),
                        name="forward-%s-connection" % self.id)
                    worker.daemon = True
                    try:
                        worker.start()
                    except BaseException:
                        with self.lock:
                            self.connections.pop(conn, None)
                        conn.close()
                        raise
        except Exception as exc:
            _session_log("forward.accept_failed",
                         logging.DEBUG if self.aborted else logging.ERROR,
                         self.session, exc=exc, job=self.id)
        finally:
            self.abort()

    def _connect(self, conn, origin):
        chan = None
        request = None
        try:
            transport = self.session.transport
            if self.aborted:
                return
            destination = self.destination
            if self.dynamic:
                request = _SocksRequest(conn, self.session.timeout)
                destination = request.destination()
                # Handshake reads exactly its fields: bytes pipelined after
                # CONNECT remain in the socket for the shared stream relay.
            if self.aborted:
                return
            if not transport.is_active():
                raise paramiko.SSHException("SSH session not active")
            if self.remote_socket:
                chan = _open_streamlocal_channel(
                    transport, self.remote_socket, self.session.timeout)
            else:
                # AF_UNIX accept() has no IP/port origin to put in direct-tcpip.
                source = origin[:2] if not self.socket_path else ("127.0.0.1", 0)
                chan = transport.open_channel(
                    "direct-tcpip", destination, source,
                    timeout=self.session.timeout)
            with self.lock:
                if self.aborted:
                    return
                # fileno() installs Paramiko's receive notifications once.
                # Create them before publishing the channel to abort(), so
                # the relay cannot reinstall pipe notifications after
                # _close_session_channel() has detached them for safe close.
                chan.fileno()
                self.connections[conn] = chan
            if request is not None:
                conn.settimeout(max(self.session.timeout, 1.0))
                request.reply()
                self.session.last = time.time()
            _session_log("forward.connected", session=self.session,
                         chan=chan, job=self.id)
            self._relay(conn, chan, transport)
        except Exception as exc:
            if request is not None and not self.aborted:
                # SSH exposes only a coarse channel-open error, not the
                # target's errno. Preserve administrative denial distinctly;
                # do not claim DNS/refusal details we cannot reliably know.
                code = 2 if isinstance(exc, paramiko.ChannelException) and \
                    exc.code == paramiko.OPEN_FAILED_ADMINISTRATIVELY_PROHIBITED else 1
                try:
                    request.reply(code)
                except OSError:
                    pass
            # Refused destinations are per-connection failures, not reasons
            # to terminate or reconnect the session's shared SSH transport.
            _session_log("forward.connection_failed",
                         logging.DEBUG if self.aborted else logging.WARNING,
                         self.session, chan, exc, job=self.id)
        finally:
            with self.lock:
                self.connections.pop(conn, None)
            conn.close()
            if chan is not None:
                try:
                    _close_session_channel(chan)
                except Exception as exc:
                    _session_log("forward.close_failed", logging.WARNING,
                                 self.session, chan, exc, job=self.id)

    def _relay(self, conn, chan, transport):
        """Bound both directions and preserve independent stream half-closes."""
        conn.setblocking(False)
        chan.settimeout(0.0)
        to_remote = to_local = b""
        local_eof = remote_eof = False
        remote_shutdown = local_shutdown = False
        while not self.aborted and not self.session.stopping.is_set():
            if not transport.is_active():
                return
            if to_remote:
                try:
                    sent = chan.send(to_remote)
                    if sent == 0:
                        return
                    to_remote = to_remote[sent:]
                except socket.timeout:
                    pass
            if to_local:
                try:
                    sent = conn.send(to_local)
                    if sent == 0:
                        return
                    to_local = to_local[sent:]
                except BlockingIOError:
                    pass
            if local_eof and not to_remote and not remote_shutdown:
                chan.shutdown_write()
                remote_shutdown = True
            if remote_eof and not to_local and not local_shutdown:
                conn.shutdown(socket.SHUT_WR)
                local_shutdown = True
            if local_shutdown and remote_shutdown:
                return
            readers = []
            if not local_eof and len(to_remote) < SESSION_BACKLOG:
                readers.append(conn)
            if not remote_eof and len(to_local) < SESSION_BACKLOG:
                readers.append(chan)
            ready, _, _ = select.select(
                readers, [conn] if to_local else [], [], SESSION_TICK)
            if self.aborted:
                return
            if conn in ready:
                try:
                    data = conn.recv(min(65536, SESSION_BACKLOG - len(to_remote)))
                    to_remote += data
                    local_eof = not data
                    if data:
                        self.session.last = time.time()
                except BlockingIOError:
                    pass
            # TCP/streamlocal channels have no command exit status. EOF is
            # separate from CLOSE, and unread buffered data must go first.
            if not remote_eof and len(to_local) < SESSION_BACKLOG:
                if chan.recv_ready():
                    data = chan.recv(min(65536, SESSION_BACKLOG - len(to_local)))
                    to_local += data
                    remote_eof = not data
                    if data:
                        self.session.last = time.time()
                elif chan.eof_received or chan.closed:
                    remote_eof = True


_SESSION_LOG_CONTEXT = threading.local()
_SESSION_LOG_NAME = None
_SESSION_LOG_ENABLED = False


class _SessionLogFilter(logging.Filter):
    """Attach daemon context to both mssh and third-party log records."""

    def filter(self, record):
        # Request context is thread-local; transport threads have only the
        # session name, while concurrent request workers keep their own IDs.
        fields = ["session=%s" % (_SESSION_LOG_NAME or "-")]
        for key in ("request", "op", "channel"):
            value = getattr(_SESSION_LOG_CONTEXT, key, None)
            if value is not None:
                fields.append("%s=%s" % (key, value))
        # mssh events add state snapshots; Paramiko records lack this field.
        details = getattr(record, "session_details", "")
        if details:
            fields.append(details)
        record.context = " ".join(fields)
        # Paramiko logs socket errors inside an except block without exc_info.
        # Capture here, before Transport.run stores or clears the exception.
        if record.name.startswith("paramiko") and record.levelno >= logging.ERROR \
                and record.exc_info is None and sys.exc_info()[0] is not None:
            record.exc_info = sys.exc_info()
        return True


def _session_log(event, level=logging.INFO, session=None, chan=None,
                 exc=None, **fields):
    """Daemon-only structured events; never log commands or protocol payloads."""
    if not _SESSION_LOG_ENABLED:
        return
    logger = logging.getLogger("mssh.session")
    # Skip state inspection and formatting for events below the threshold.
    if not logger.isEnabledFor(level):
        return
    if chan is not None:
        fields["channel"] = getattr(chan, "chanid", hex(id(chan)))
        fields["closed"] = getattr(chan, "closed", None)
        fields["eof_in"] = getattr(chan, "eof_received", None)
        fields["eof_out"] = getattr(chan, "eof_sent", None)
    saved = None
    if session is not None:
        transport = session.transport
        fields["transport"] = hex(id(transport))
        try:
            fields["active"] = transport.is_active() if transport else False
            sock = getattr(transport, "sock", None)
            fields["transport_fd"] = sock.fileno() if sock else None
            # get_exception() clears this value; diagnostics must not.
            saved = getattr(transport, "saved_exception", None)
        except Exception:
            # State inspection can race with teardown. Keep logging the
            # original failure even when the transport cannot be inspected.
            fields["transport_state"] = "unavailable"
    # Stable field ordering makes concurrent events easier to compare.
    details = " ".join("%s=%r" % (key, value)
                       for key, value in sorted(fields.items()))
    # Use the supplied exception's traceback, not the caller's current
    # except block; callers may report an exception after catching it.
    info = (type(exc), exc, exc.__traceback__) if exc is not None else None
    logger.log(level, event, exc_info=info, extra={"session_details": details})
    # A transport-thread failure may be the cause of a later channel error.
    # Report both, but do not print the same exception object twice.
    if isinstance(saved, BaseException) and saved is not exc:
        logger.log(level, "transport.saved_exception",
                   exc_info=(type(saved), saved, saved.__traceback__),
                   extra={"session_details": details})


class _Session(object):
    """One live remote program behind a pty, framed into request/response.

    Output is streamed, not buffered: a command that runs for minutes and
    prints as it goes (a poller, a tail, a build) must show its lines while it
    runs, not all at once when --wait expires.  So framing works a line at a
    time and every completed line is handed straight to the client.

    One command is one trip round a single select loop (_pump), in the thread
    that asked for it.  The channel, the client's stdin descriptor, the output
    pipe and the request socket are all watched together there, because each
    of them can block and none of them may stop the others: a full output pipe
    must not stop stdin arriving, and a slow producer on stdin must not stop
    output being handed over.  An earlier design ran stdin in a thread of its
    own and polled the channel with a 50 ms blocking recv; this does the same
    work in one place, and wakes the moment anything is ready rather than at
    the next tick.

    The same object also runs commands that do *not* use the shell: --exec
    opens a channel of its own, with no pty, and copies its two streams to
    two pipes (exec_run / _pump_exec).  Those take neither the lock nor the
    pty, so any number of them run at once, alongside whatever the shell is
    doing; they live here only because they share the transport and because
    --interrupt has to be able to reach them.
    """

    def __init__(self, chan, mark, mode, prompt_re, idle, target, command,
                 transport=None, timeout=DEFAULT_TIMEOUT):
        self.chan = chan
        self.mark = mark.encode("utf-8")
        self.mode = mode                  # "shell" or "interactive"
        self.prompt_re = prompt_re        # compiled bytes pattern, or None
        self.idle = idle
        self.target = target
        self.command = command
        # Kept to open the stdin writer channel; the session's own channel
        # cannot carry it, since the pty would read the data as keystrokes.
        self.transport = transport
        self.timeout = timeout
        self.lock = threading.Lock()
        self.started = time.time()
        self.last = self.started
        self.served = 0
        self.dead = None
        # One request owns the primary channel in either mode. A timeout or
        # abandoned client leaves this job pending until resynchronization;
        # cancellation belongs to that job, never to a later request.
        self.default_job = None
        # Commands running on channels of their own (--exec).  They do not
        # touch the pty and do not take the lock, so several run at once and
        # --interrupt --job has to be able to find them.
        self.execs = set()
        self.execs_lock = threading.Lock()
        self.job_sequence = 0
        # Everything --reconnect needs, all of it inert until arm() fills it
        # in: a session that was never armed behaves exactly as it did before
        # the option existed.  state_lock guards this group alone -- it is
        # taken for a moment at a time and never while the pty lock is held,
        # so it cannot queue behind a command.
        self.name = None
        self.chain = []                   # the chain's clients, ours to close
        self.jumps = []
        self.reconnect_opts = None
        self.setup_wait = DEFAULT_SESSION_WAIT
        self.retries = 0                  # --reconnect N, 0 for not at all
        self.prompted = False             # a password was typed, not given
        self.state_lock = threading.Lock()
        self.broken = None                # why the link is down, or None
        self.reconnecting = False
        self.attempt = 0
        self.exhausted = False            # a whole run of attempts failed
        self.reconnects = 0
        self.last_error = ""              # what the last attempt died of
        self.notice = None                # owed to the next command
        self.stopping = threading.Event()
        self.rcfile_data = None
        self.rcfile_path = None
        self.rcfile_paths = set()

    @property
    def pending(self):
        with self.execs_lock:
            return self.default_job is not None

    def _new_job(self, chan, kind, command, token=None, default=False):
        job = _ExecJob(chan, kind, command, token=token, default=default)
        with self.execs_lock:
            self.job_sequence += 1
            job.id = self.job_sequence
        return job

    def _register_job(self, job):
        with self.execs_lock:
            stopping = self.stopping.is_set()
            if not stopping:
                self.execs.add(job)
        if stopping:
            job.abort()
            raise _SessionDead("session is stopping")

    def add_forwards(self, specs, start=True, dynamic_specs=None):
        """Bind an entire request before registering any persistent jobs."""
        if dynamic_specs is None:
            dynamic_specs = []
        if not isinstance(specs, list) or not isinstance(dynamic_specs, list) \
                or not (specs or dynamic_specs):
            raise ValueError("-L/-D require a nonempty list of forwarding specifications")
        settings = [parse_local_forward(spec) for spec in specs]
        settings.extend(parse_dynamic_forward(spec) for spec in dynamic_specs)
        jobs = []
        try:
            for item in settings:
                jobs.append(_LocalForwardJob(self, item))
            with self.execs_lock:
                if self.stopping.is_set():
                    raise _SessionDead("session is stopping")
                for job in jobs:
                    self.job_sequence += 1
                    job.id = self.job_sequence
                    self.execs.add(job)
            if start:
                for job in jobs:
                    job.start()
            self.last = time.time()
            return jobs
        except BaseException:
            for job in jobs:
                job.abort()
            raise

    def close_channels(self):
        """Stop accepting jobs before closing their channels outside the lock."""
        self.stopping.set()
        with self.execs_lock:
            jobs = list(self.execs)
            if self.default_job is not None:
                jobs.append(self.default_job)
        # Channel teardown wakes relay workers, which remove themselves from
        # execs. Never hold execs_lock while closing. Late registrations see
        # stopping and close their own channel instead of missing this snapshot.
        for job in jobs:
            job.abort()
        try:
            _close_session_channel(self.chan)
        except Exception as exc:
            _session_log("daemon.shell_close_failed", logging.WARNING,
                         self, self.chan, exc)

    def interrupt_job(self, job_id=None, token=None):
        """Cancel one job; no selector means the current primary request."""
        default_request = job_id is None and token is None
        with self.execs_lock:
            if token is not None:
                job = next((item for item in self.execs if item.token == token), None)
            elif default_request:
                job = self.default_job
            else:
                job = next((item for item in self.execs if item.id == job_id), None)
                if self.default_job is not None and self.default_job.id == job_id:
                    job = self.default_job
            if job is not None and job.default:
                job.abort()
        if job is None and default_request:
            return False
        if job is not None and job.default:
            if self.lock.acquire(False):
                try:
                    with self.execs_lock:
                        if self.default_job is not job:
                            if default_request:
                                return False
                            raise ValueError("job %s is no longer running" % job_id)
                    self._resync()
                finally:
                    self.lock.release()
            return True
        if job is None or getattr(job.chan, "closed", False):
            raise ValueError("job %s is not running" %
                             (job_id if token is None else "for this request"))
        job.abort()
        return True

    def jobs_snapshot(self):
        """Copy job metadata without waiting for the persistent shell lock."""
        with self.execs_lock:
            jobs = list(self.execs)
            if self.default_job is not None:
                jobs.append(self.default_job)
            rows = [
                {"id": job.id, "kind": job.kind, "command": job.command,
                 "channel": getattr(job.chan, "chanid", None),
                 "started": job.started,
                 "default": job.default,
                 "forward_type": "socks" if getattr(job, "dynamic", False) else
                                 "local" if job.kind == "forward" else None,
                 "state": "stopping" if job.aborted else
                          "pending" if job is self.default_job and
                          not self.lock.locked() else "running"}
                for job in jobs if not getattr(job.chan, "closed", False)]
        return sorted(rows, key=lambda row: row["id"])

    # -- channel i/o ------------------------------------------------------

    def _write(self, text):
        """Send to the program's input, whatever timeout was left on the channel.

        sendall() is wrong here.  The channel outlives every command, and the
        loops that use it leave their own timeout on it -- _pump sets 0.0 and
        _await_token 0.05 -- so a later write finds a non-blocking channel and
        gets socket.timeout the moment the remote's window is full.  That is
        not a dead session, only a slow one, and sendall() gives no way to
        tell how much went out before it gave up.  Send in a loop against a
        deadline of our own instead, which behaves the same under every
        timeout the channel might be carrying.
        """
        data = text.encode("utf-8")
        deadline = time.time() + max(self.timeout, 1.0)
        while data:
            try:
                sent = self.chan.send(data)
            except socket.timeout:
                if time.time() >= deadline:
                    raise _SessionDead(
                        "write timed out: the remote program is not reading "
                        "its input")
                time.sleep(0.01)
                continue
            except Exception as exc:
                _session_log("shell.write_failed", logging.ERROR, self,
                             self.chan, exc)
                raise _SessionDead("write failed: %s" % exc)
            if sent == 0:
                raise _SessionDead("the remote program closed its input")
            data = data[sent:]

    def _recv(self):
        try:
            data = self.chan.recv(65536)
        except socket.timeout:
            return None
        except Exception as exc:
            _session_log("shell.read_failed", logging.ERROR, self,
                         self.chan, exc)
            raise _SessionDead("read failed: %s" % exc)
        if data == b"":
            raise _SessionDead("the remote program exited")
        return data

    # -- framing ----------------------------------------------------------

    def _marker_command(self, token=None):
        """Print a locally owned marker without exposing it in input echoes."""
        escaped = "".join("\\%03o" % byte for byte in self.mark)
        payload = '"$?"' if token is None else shlex.quote(token)
        return "command printf '\\n%s%%s\\n' %s\n" % (escaped, payload)

    def session_frame(self, line, in_path=None):
        """Run a command in this shell and report its status with our marker."""
        blob = base64.b64encode(line.encode("utf-8")).decode("ascii")
        source = "/dev/null" if in_path is None else shlex.quote(in_path)
        return ('eval "$(echo %s | base64 -d)" < %s; '
                % (blob, source)) + self._marker_command()

    def _clean(self, line):
        """One line, as the caller should see it."""
        if line.endswith(b"\r"):
            line = line[:-1]
        if self.mode == "interactive":
            line = SESSION_ESC_RE.sub(b"", line)
        return line

    def _marker_payload(self, line):
        """Whatever follows the marker on this line, or None if not a marker."""
        if not line.startswith(self.mark):
            return None
        return line[len(self.mark):]

    def _marker_status(self, line):
        """The exit status if this line is our frame marker, else None.

        A marker whose digits did not survive gives -1 rather than None: it
        still frames the command, we just cannot say how it ended.  Treating
        it as output instead would leak the marker to the caller and leave the
        session one frame out of step.
        """
        payload = self._marker_payload(line)
        if payload is None:
            return None
        return int(payload) if payload.isdigit() else -1

    # -- the loop ---------------------------------------------------------

    def _pump(self, framer, sink, deadline, in_fd=None, in_chan=None,
              conn=None, job=None):
        """Drive one command to its end.  Returns (status, timed_out).

        Everything that can block is watched here together, in one thread:

          chan     the remote program's output, framed into the sink
          in_fd    the client's stdin, copied to the writer channel
          sink.wfd the client's output pipe, when it is full and we have more
          conn     the request socket, which says nothing but tells us by
                   going readable that the client has gone

        The channel is dropped from the read set while the sink has a backlog,
        and stdin is dropped while the writer channel has one, so neither side
        is read faster than it can be handed on -- the pressure travels back to
        the remote program through the SSH window instead of piling up here.

        select() is given a tick rather than the whole remaining time because
        --idle, --wait and an interrupt from another thread are all deadlines
        no descriptor will wake us for.
        """
        self.chan.settimeout(0.0)
        if in_chan is not None:
            in_chan.settimeout(0.0)
        pending_in = b""                  # read from stdin, not yet sent on
        in_done = in_fd is None           # no more stdin will come

        while True:
            if not sink.flush():
                raise _ClientGone("the client stopped reading")

            # Push whatever stdin we are holding; a timeout means the remote
            # window is full, so the rest waits for the next turn.
            while pending_in and in_chan is not None:
                try:
                    sent = in_chan.send(pending_in)
                except socket.timeout:
                    break
                except Exception as exc:
                    _session_log("stdin.send_failed", logging.DEBUG,
                                 self, in_chan, exc)
                    # The remote reader is gone -- the command ignored its
                    # stdin, or ended early.  Drop the rest, as a pipe does.
                    pending_in, in_fd, in_done = b"", None, True
                    break
                if sent == 0:
                    pending_in, in_fd, in_done = b"", None, True
                    break
                pending_in = pending_in[sent:]
            if in_done and not pending_in and in_chan is not None:
                # End of input -- a real EOF, or the client going away.  The
                # channel's EOF is what the remote command's read() sees as 0.
                try:
                    in_chan.shutdown_write()
                except Exception as exc:
                    _session_log("stdin.eof_failed", logging.DEBUG,
                                 self, in_chan, exc)
                in_chan = None

            rset = [] if sink.backlog >= SESSION_BACKLOG else [self.chan]
            if in_fd is not None and len(pending_in) < SESSION_BACKLOG:
                rset.append(in_fd)
            if conn is not None:
                rset.append(conn)
            wset = [sink.wfd] if sink.backlog and sink.wfd is not None else []

            timeout = SESSION_TICK
            if deadline != float("inf"):
                timeout = max(0.0, min(timeout, deadline - time.time()))
            try:
                ready, _w, _x = select.select(rset, wset, [], timeout)
            except (select.error, InterruptedError) as exc:
                _session_log("shell.select_failed", logging.DEBUG,
                             self, exc=exc)
                ready = []

            if conn is not None and conn in ready:
                # Nothing follows the request on this socket, so the only
                # thing readable can be the end of it: the client is gone.
                # Without this watch a killed client would leave the command
                # waiting on a descriptor that stays readable forever.
                try:
                    alive = bool(conn.recv(65536))
                except (socket.error, OSError) as exc:
                    _session_log("shell.control_read_failed", logging.DEBUG,
                                 exc=exc)
                    alive = False
                if not alive:
                    raise _ClientGone("the client hung up")

            if in_fd is not None and in_fd in ready:
                try:
                    data = os.read(in_fd, 65536)
                except OSError as exc:
                    _session_log("stdin.read_failed", logging.DEBUG,
                                 exc=exc, fd=in_fd)
                    data = b""
                if data:
                    pending_in += data
                else:
                    in_fd, in_done = None, True   # the producer is done

            if self.chan in ready:
                data = self._recv()
                if data:
                    done = framer.feed(data, sink)
                    if done is not None:
                        # Completion wins over a concurrent cancellation:
                        # this marker/prompt already ended this exact job.
                        with self.execs_lock:
                            if job is not None and self.default_job is job:
                                self.default_job = None
                        sink.flush()
                        return done

            if job is not None and job.aborted:
                return framer.on_abort(sink)

            now = time.time()
            done = framer.idle(sink, now)
            if done is not None:
                with self.execs_lock:
                    if job is not None and self.default_job is job:
                        self.default_job = None
                return done
            if now >= deadline:
                framer.flush(sink)
                return (None, True)

    def _resync(self):
        """Stop whatever is running and get the shell back to a known state.

        The obvious alternative -- wait for the abandoned command's own marker
        to turn up -- does not work: a command that never ends (a poller, a
        tail -f) never produces one, and waiting for it wedges every later
        command.  So the leftover is interrupted, and a marker carrying a
        one-shot token is requested.  The token is what makes this
        unambiguous: however many stale markers are still in flight, this
        drains past all of them and stops at exactly the right place.
        """
        if self.mode == "interactive":
            self._write("\x03")
            self._drain_interactive()
            return

        for attempt in range(2):
            token = os.urandom(6).hex().encode("ascii")
            if attempt == 0:
                self._write("\x03")
                # The Ctrl-C makes the pty discard whatever input is queued
                # behind it, and a write issued in the same breath is part of
                # that queue: measured, the resync line reached the shell as
                # 'rintf ...', its first byte eaten.  Let the interrupt land.
                time.sleep(0.3)
            self._write(self._marker_command(token.decode("ascii")))
            if self._await_token(token, 20 if attempt == 0 else 10):
                with self.execs_lock:
                    self.default_job = None
                return
        # The shell never answered. Leave the default job so the next command
        # tries to resynchronise again rather than framing on a stale marker.

    def _await_token(self, token, limit):
        """Read until a marker line carries this token.  True if it came."""
        tail = b""
        deadline = time.time() + limit
        self.chan.settimeout(0.05)
        while time.time() < deadline:
            try:
                data = self._recv()
            except _SessionDead as exc:
                _session_log("shell.resync_failed", logging.WARNING,
                             self, self.chan, exc)
                return False
            if not data:
                continue
            tail += data
            lines = tail.split(b"\n")
            tail = lines.pop()
            for raw in lines:
                if self._marker_payload(self._clean(raw)) == token:
                    return True
        return False

    def _prompt_at_end(self, line):
        """Text before the prompt if this line ends with one, else None."""
        found = None
        for found in self.prompt_re.finditer(line[-SESSION_TAIL:]):
            pass
        if found is None or line[-SESSION_TAIL:][found.end():].strip():
            return None
        return line[:len(line) - (min(len(line), SESSION_TAIL) - found.start())]

    # -- stdin forwarding -------------------------------------------------

    def open_stdin_writer(self):
        """Start the channel that will feed one command's stdin.

        Returns (channel, remote fifo path).  The channel's program creates the
        fifo and prints one byte before it blocks opening it, and this waits for
        that byte: the command must not be framed against a path that does not
        exist yet, which fails at once with "No such file or directory".
        """
        if self.transport is None:
            raise _SessionDead("no transport for a stdin channel")
        path = _remote_temp_path("in")
        chan = self.transport.open_session(timeout=self.timeout)
        chan.exec_command(SESSION_WRITER % {"path": path})

        chan.settimeout(max(self.timeout, 1.0))
        seen = b""
        while SESSION_WRITER_READY not in seen:
            try:
                data = chan.recv(64)
            except socket.timeout:
                break
            except Exception as exc:
                _session_log("stdin.channel_failed", logging.ERROR,
                             self, chan, exc)
                _close_session_channel(chan)
                raise _SessionDead("stdin channel failed: %s" % exc)
            if not data:
                break
            seen += data
        if SESSION_WRITER_READY not in seen:
            # No readiness byte: mkfifo is missing, /tmp is read-only, or the
            # target refused the channel.  Say which, since the alternative is
            # a command that mysteriously reports a missing file.
            err = b""
            try:
                if chan.recv_stderr_ready():
                    err = chan.recv_stderr(200)
            except Exception as exc:
                _session_log("stdin.stderr_failed", logging.DEBUG, self, chan, exc)
            _close_session_channel(chan)
            raise _SessionDead(
                "could not set up a stdin channel on the target (mkfifo in "
                "/tmp must work)%s" % (": %s" % err.decode("utf-8", "replace").strip()
                                       if err.strip() else "")
            )
        return chan, path

    @staticmethod
    def close_stdin_writer(chan):
        """Shut the writer channel down, which is what the remote sees as EOF."""
        if chan is None:
            return
        try:
            chan.shutdown_write()
        except Exception as exc:
            _session_log("stdin.shutdown_failed", logging.DEBUG, chan=chan, exc=exc)
        try:
            _close_session_channel(chan)
        except Exception as exc:
            _session_log("stdin.close_failed", logging.WARNING, chan=chan, exc=exc)

    # -- a command on a channel of its own --------------------------------

    def exec_run(self, line, wait, out_sink, err_sink, in_fd=None, conn=None,
                 pty=None, control=b"", shell=False, rcfile_data=None,
                 job_token=None):
        """Run one command on a new channel, outside the session's shell.

        Nothing here touches the session's pty: a fresh channel is opened, the
        command runs on it with no terminal at all, and its two streams are
        copied to two sinks.  That means no framing -- there is no marker to
        look for, because the channel's own exit status says when the command
        ended and which code it ended with -- and no carriage returns to strip,
        because no line discipline ever saw the bytes.  stdout and stderr stay
        apart for the same reason.

        pty is the exception, and it is the client's decision alone: a dict of
        term/cols/rows asks the server for a terminal on this channel, for the
        programs that refuse to run without one.  The terminal then belongs to
        the client's own -- it is the client that put its tty in raw mode and
        whose window size came with the request -- so nothing here translates
        or inspects the bytes either way.  With a pty the server merges stderr
        into stdout, so the stderr sink stays empty; that is the terminal's
        doing, not ours.

        shell asks for no command at all, which is a login: a shell is started
        on this new channel instead, the way 'ssh host' with no command does
        it.  It is a new channel for the same reason as everything else here --
        the session's own shell cannot be borrowed, since the framing wrapped
        around every command is what makes that shell a session.

        What is given up is the session itself: open_session starts a new
        process on the target, so the shell's working directory, variables,
        functions and background jobs do not apply.  Only the chain is shared.
        Because the pty lock is not taken, several of these run at once, and
        one may run while the session's shell is busy with something else.

        A command that ends any way but normally -- a timeout, an interrupt, a
        client that walked away -- is killed rather than abandoned: the finally
        below closes the channel, and the server ends the command with it.
        That is the opposite of a shell command, which has no channel of its
        own to close and so keeps running on the pty until something stops it;
        there is nothing here for a later command to collide with, so there is
        no reason to leave one running with nobody watching.
        """
        if self.transport is None:
            raise _SessionDead("no transport for a command channel")
        try:
            chan = self.transport.open_session(timeout=self.timeout)
        except Exception as exc:
            _session_log("exec.open_failed", logging.ERROR, self, exc=exc)
            raise _SessionDead("could not open a channel: %s" % exc)

        _SESSION_LOG_CONTEXT.channel = getattr(chan, "chanid", None)
        _session_log("exec.opened", session=self, chan=chan)
        job = self._new_job(chan, "login" if shell else "exec",
                            "login shell" if shell else line, token=job_token)
        self._register_job(job)
        self.served += 1
        try:
            if pty:
                try:
                    _request_pty(chan, pty)
                except Exception as exc:
                    _session_log("exec.pty_failed", logging.ERROR, self, chan, exc)
                    raise _SessionDead("the server refused a terminal for "
                                       "the command: %s" % exc)
            chan.settimeout(0.0)
            try:
                if shell:
                    chan.invoke_shell()

                    def show_banner(data):
                        out_sink.write(data)
                        out_sink.drain()

                    initial = _source_rcfile(
                        self.transport, chan,
                        rcfile_data, self.timeout, banner_sink=show_banner,
                        remote_path=self.rcfile_path if rcfile_data is None else None)
                    out_sink.write(initial)
                else:
                    chan.exec_command(line)
            except Exception as exc:
                _session_log("exec.start_failed", logging.ERROR, self, chan, exc)
                raise _SessionDead("could not start the %s: %s"
                                   % ("shell" if shell else "command", exc))
            return self._pump_exec(job, out_sink, err_sink, time.time() + wait,
                                   in_fd=in_fd, conn=conn, control=control)
        finally:
            with self.execs_lock:
                self.execs.discard(job)
            try:
                _session_log("exec.closing", session=self, chan=chan)
                _close_session_channel(chan)
            except Exception as exc:
                _session_log("exec.close_failed", logging.ERROR, self, chan, exc)
            _session_log("exec.closed", session=self, chan=chan)
            self.last = time.time()

    def _pump_exec(self, job, out_sink, err_sink, deadline, in_fd=None,
                   conn=None, control=b""):
        """Drive one --exec command to its end.  Returns (status, timed_out).

        The same shape as _pump: one select over everything that can block,
        in the thread that asked for it.  The differences are all consequences
        of there being no pty -- the client's stdin goes straight down this
        channel rather than through a fifo, stderr is a stream of its own, and
        the end is the channel's exit status rather than a printed marker.

        The one thing that does come back up the request socket is a resize:
        with --exec -t the client is sitting in a window that can be dragged
        while the command runs, and the remote pty has to be told or a
        full-screen program keeps painting the old rectangle.  Those lines
        arrive on the connection this command already owns, read here, in the
        turn of the loop that noticed them -- the client has one connection
        per command and this loop is awake for its whole length, so there is
        nothing to look the channel up by and no second connection to make.

        control is what came in behind the request line, for the window that
        was dragged before the request had finished being read.  It is the
        same bytes from the same socket, so it goes through the same parser
        rather than being treated as a case of its own.
        """
        chan = job.chan
        pending_in = b""
        in_done = in_fd is None
        in_closed = False
        out_eof = err_eof = False
        while b"\n" in control:
            one, control = control.split(b"\n", 1)
            self._exec_control(chan, one)

        while True:
            # A control worker may have closed this channel since the last
            # tick. Do not send stdin or recreate its select pipe afterward.
            if job.aborted:
                return (130, False)
            for sink in (out_sink, err_sink):
                if not sink.flush():
                    raise _ClientGone("the client stopped reading")

            # Push whatever stdin we are holding; a timeout means the remote
            # window is full, so the rest waits for the next turn.
            while pending_in:
                try:
                    sent = chan.send(pending_in)
                except socket.timeout:
                    break
                except Exception as exc:
                    _session_log("relay.send_failed", logging.DEBUG,
                                 self, chan, exc)
                    pending_in, in_fd, in_done = b"", None, True
                    break
                if sent == 0:
                    pending_in, in_fd, in_done = b"", None, True
                    break
                pending_in = pending_in[sent:]
            if in_done and not pending_in and not in_closed:
                # End of input: the channel's EOF is what the remote command's
                # read() sees as 0.
                in_closed = True
                try:
                    chan.shutdown_write()
                except Exception as exc:
                    _session_log("relay.eof_failed", logging.DEBUG,
                                 self, chan, exc)

            backed_up = (out_sink.backlog >= SESSION_BACKLOG
                         or err_sink.backlog >= SESSION_BACKLOG)
            rset = [] if backed_up else [chan]
            if in_fd is not None and len(pending_in) < SESSION_BACKLOG:
                rset.append(in_fd)
            if conn is not None:
                rset.append(conn)
            wset = [s.wfd for s in (out_sink, err_sink)
                    if s.backlog and s.wfd is not None]

            timeout = SESSION_TICK
            if deadline != float("inf"):
                timeout = max(0.0, min(timeout, deadline - time.time()))
            try:
                ready, _w, _x = select.select(rset, wset, [], timeout)
            except (select.error, InterruptedError) as exc:
                _session_log("relay.select_failed", logging.DEBUG,
                             self, chan, exc)
                ready = []

            if job.aborted:
                return (130, False)

            if conn is not None and conn in ready:
                try:
                    data = conn.recv(65536)
                except (socket.error, OSError) as exc:
                    _session_log("relay.control_read_failed", logging.DEBUG, exc=exc)
                    data = b""
                if not data:
                    raise _ClientGone("the client hung up")
                # Anything the client does send while its command runs is a
                # control line.  Only whole ones are acted on; the rest waits
                # for the bytes that finish it.
                control += data
                while b"\n" in control:
                    one, control = control.split(b"\n", 1)
                    self._exec_control(chan, one)
                if len(control) > 65536:
                    # Not a control line: nothing in the protocol is that
                    # long, so it is a client talking to the wrong daemon.
                    raise _ClientGone("the client sent a request that is not "
                                      "one")

            if in_fd is not None and in_fd in ready:
                try:
                    data = os.read(in_fd, 65536)
                except OSError as exc:
                    _session_log("relay.input_read_failed", logging.DEBUG,
                                 exc=exc, fd=in_fd)
                    data = b""
                if data:
                    pending_in += data
                else:
                    in_fd, in_done = None, True   # the producer is done

            if not backed_up:
                # Both streams share one channel and one window, so neither is
                # read ahead of the other: drain whatever has arrived of each.
                try:
                    if not out_eof:
                        out_eof = self._drain_stream(
                                chan.recv_ready, chan.recv, out_sink)
                    if not err_eof:
                        err_eof = self._drain_stream(
                                chan.recv_stderr_ready, chan.recv_stderr,
                                err_sink)
                except socket.timeout:
                    pass
                except Exception as exc:
                    _session_log("relay.read_failed",
                                 logging.DEBUG if job.aborted else logging.ERROR,
                                 self, chan, exc)
                    if not job.aborted:
                        raise _SessionDead("read failed: %s" % exc)

            if job.aborted:
                # --interrupt closed the channel under us; there is no pty to
                # type a Ctrl-C into, so that is the only way to stop it.
                return (130, False)

            # Both streams have to be quiet before the status is taken: the
            # exit status arrives on the channel while output may still be
            # buffered in it, and returning on the status alone truncates the
            # tail of a command that printed right before exiting.
            quiet = ((out_eof or not chan.recv_ready())
                     and (err_eof or not chan.recv_stderr_ready()))
            if not backed_up and quiet and chan.exit_status_ready():
                try:
                    status = chan.recv_exit_status()
                except Exception as exc:
                    _session_log("relay.exit_status_failed", logging.WARNING,
                                 self, chan, exc)
                    status = -1
                return (status if status is not None and status >= 0
                        else -1, False)

            if time.time() >= deadline:
                return (None, True)

    @staticmethod
    def _drain_stream(ready, read, sink):
        """Copy what has arrived on one of a channel's streams.  True at EOF.

        Read until the stream has nothing more for now, rather than once per
        turn: one select wakeup can cover several packets, and leaving them
        for the next turn would hold output back by a tick each time.
        """
        while ready():
            data = read(65536)
            if not data:
                return True
            sink.write(data)
        return False

    @staticmethod
    def _exec_control(chan, line):
        """Act on one JSON line the client sent while its command runs.

        Only a resize so far, and nothing here may fail the command: a line
        that cannot be parsed, names something unknown, or is refused by the
        server is dropped.  The command is still running and its output is
        still arriving, and a window that did not get resized is worth less
        than the command it would have ended.
        """
        line = line.strip()
        if not line:
            return
        try:
            msg = json.loads(line.decode("utf-8"))
        except Exception as exc:
            _session_log("control.decode_failed", logging.DEBUG, chan=chan, exc=exc)
            return
        if not isinstance(msg, dict) or msg.get("op") != "resize":
            return
        try:
            chan.resize_pty(width=int(msg.get("cols") or 0),
                            height=int(msg.get("rows") or 0))
        except Exception as exc:
            _session_log("control.resize_failed", logging.DEBUG, chan=chan, exc=exc)

    # -- operations -------------------------------------------------------

    def run(self, line, wait, sink, in_path=None, in_fd=None, in_chan=None,
            conn=None):
        """Run one command to its end.  Returns (status, timed_out).

        Output goes to the sink as it is produced, which for a client command
        is the pipe it handed over with its request.

        in_path is the remote fifo the writer channel has already created, and
        in_fd/in_chan are the two ends this loop copies between; all three are
        None to leave the command reading /dev/null.  They only apply in shell
        mode -- an interactive program owns the pty, so its input is the
        command line itself.

        conn is the request socket, watched only so a client that goes away
        does not leave the command running with nobody to hand its output to.

        The pty lock is held for the command's whole life, since two commands
        interleaved on one pty would each read the other's output.
        """
        with self.lock:
            if self.stopping.is_set():
                raise _SessionDead("session is stopping")
            # The request may have passed resolve() before waiting for this
            # lock. Do not recreate a job on the old shell while reconnecting.
            if self.transport is not None and self.link_down():
                raise _SessionDead("the connection to %s dropped" % self.target)
            if self.pending:
                # A previous command timed out and may still be running.  It
                # has to be stopped before this one starts, or its output would
                # be mixed into ours and its marker would frame us early.
                self._resync()
                if self.pending:
                    raise _SessionDead("the default job could not be resynchronized")
            job = self._new_job(self.chan, self.mode, line, default=True)
            with self.execs_lock:
                self.default_job = job
            self.served += 1
            try:
                if self.mode == "shell":
                    self._write(self.session_frame(line, in_path))
                    framer = _ShellFramer(self)
                else:
                    self._write(line.rstrip("\r\n") + "\n")
                    framer = _InteractiveFramer(self)
                status, timed_out = self._pump(
                    framer, sink, time.time() + wait,
                    in_fd=in_fd, in_chan=in_chan, conn=conn, job=job)
                if not timed_out and not job.aborted:
                    with self.execs_lock:
                        if self.default_job is job:
                            self.default_job = None
            except _SessionDead:
                # A fatal channel failure cannot leave work to resynchronize.
                # Timeouts and abandoned clients on a live shell still can,
                # so those paths deliberately retain their pending job.
                with self.execs_lock:
                    if self.default_job is job:
                        self.default_job = None
                raise
            finally:
                self.last = time.time()
            return status, timed_out

    def _drain_interactive(self):
        """Discard what an abandoned interactive command left behind.

        There is no marker to aim at here -- an arbitrary program has no exit
        codes to report -- so this reads until the output stops, which is the
        same heuristic --prompt exists to replace during normal operation.
        """
        self.chan.settimeout(0.05)
        quiet_for = max(self.idle, 0.2)
        last_data = time.time()
        deadline = time.time() + 10
        while time.time() < deadline:
            try:
                data = self._recv()
            except _SessionDead as exc:
                _session_log("shell.interactive_drain_failed", logging.DEBUG,
                             self, self.chan, exc)
                break
            if data:
                last_data = time.time()
            elif time.time() - last_data >= quiet_for:
                break
        with self.execs_lock:
            self.default_job = None

    def setup(self, wait):
        """Bring the program to a known state; return its banner.

        The same loop as a real command, with the output collected here rather
        than written to a client: nobody is connected yet.
        """
        sink = _BufSink()
        if self.mode == "interactive":
            limit = wait if self.prompt_re is not None else max(self.idle * 4, 1.0)
            self._pump(_InteractiveFramer(self), sink, time.time() + limit)
            return sink.value()

        # Initialization is not a client request. In particular, a failed
        # reconnect must not leave an "echo ready" job on the restored channel.
        self._write(SESSION_SETUP)
        self._write(self.session_frame("echo ready"))
        status, timed_out = self._pump(_ShellFramer(self), sink,
                                       time.time() + wait)
        out = sink.value()
        if timed_out or status is None:
            raise SystemExit(
                "mssh: the remote shell never answered; it may not be a "
                "POSIX shell (got %r)" % out[-200:]
            )
        if b"ready" not in out:
            raise SystemExit(
                "mssh: the remote shell cannot decode base64 -- a 'base64' "
                "command is required on the target for session mode (got %r)"
                % out[-200:]
            )
        return b""

    # -- reconnecting -----------------------------------------------------
    #
    # A chain can outlive its hops: a jump host reboots, the target reboots,
    # a firewall drops the connection.  Until --reconnect the daemon had one
    # answer for all of it -- say what happened and exit -- which is right
    # when nobody asked for anything else, and wrong for the case this was
    # written for: a target that is coming back in two minutes.
    #
    # What a reconnect can and cannot restore is the whole shape of this.
    # The chain comes back; the shell does not.  A new shell starts in the
    # home directory with an empty environment and none of the background
    # jobs, so a session that silently reconnected would answer the next
    # 'grep error messages' from the wrong directory and call it a success.
    # That is why every reconnect is announced to the first command after it,
    # on stderr, before that command runs.

    def arm(self, name, jumps, clients, opts):
        """Keep what a reconnect would need; harmless when it never happens."""
        self.name = name
        self.rcfile_data = getattr(opts, "rcfile_data", None)
        self.jumps = list(jumps)
        self.chain = clients
        self.retries = max(0, int(getattr(opts, "reconnect", 0) or 0))
        self.prompted = _PROMPTED["password"]
        self.setup_wait = opts.wait if opts.wait and opts.wait > 0 \
            else DEFAULT_SESSION_WAIT
        # The originals, minus the two things that must not happen again: a
        # prompt (there is no terminal left to answer it, so an attempt that
        # needed one must fail rather than hang) and --copy-id (the key went
        # on at startup; a reconnect is not another install).
        clone = argparse.Namespace(**vars(opts))
        clone.no_prompt = True
        clone.copy_id = None
        self.reconnect_opts = clone

    def setup_rcfile(self):
        """Upload once per new session shell; subsequent logins reuse its path."""
        if self.rcfile_data is None:
            return
        _session_log("rcfile.setup", session=self)
        path = _upload_rcfile(self.transport, self.rcfile_data, self.timeout)
        self.rcfile_paths.add(path)
        _source_rcfile(self.transport, self.chan, None, self.timeout,
                       remote_path=path)
        self.rcfile_path = path

    def cleanup_rcfiles(self):
        """Best-effort cleanup, including paths retained across reconnects."""
        if not self.rcfile_paths:
            return
        try:
            _, status = _rc_command(
                self.transport,
                "command rm -f -- " + " ".join(
                    shlex.quote(path) for path in sorted(self.rcfile_paths)),
                min(self.timeout, 5.0))
            if status:
                raise RuntimeError("remote rm returned exit status %d" % status)
        except Exception as exc:
            sys.stderr.write("mssh: could not clean up session rc files: %s\n" % exc)
            _session_log("rcfile.cleanup_failed", logging.WARNING, self, exc=exc)
        else:
            self.rcfile_paths.clear()
            self.rcfile_path = None

    def link_down(self):
        """True when the connection is gone, as against the program ending.

        The two look alike from the channel -- it is closed either way -- and
        they could not be more different: a shell that ran 'exit' is a session
        that is over, and a transport that went away is one that may well come
        back.  The transport is what tells them apart.
        """
        transport = self.transport
        if transport is None:
            return True
        try:
            return not transport.is_active()
        except Exception as exc:
            _session_log("transport.state_failed", logging.ERROR, self, exc=exc)
            return True

    def refusal(self):
        """Why this session may not reconnect, or None if it may."""
        if self.retries <= 0:
            return None                   # not asked for; not a refusal
        if self.mode != "shell":
            return ("it holds an interactive program (-c %s), whose state is "
                    "the program itself -- a reconnect would start a new one "
                    "that has none of it" % (self.command or ""))
        if self.prompted:
            return ("the chain was authenticated with a password typed at "
                    "the prompt, and this daemon is detached from that "
                    "terminal -- put the password in the endpoint "
                    "(user:password@host) or install a key to let it "
                    "reconnect")
        return None

    def failed(self, reason):
        """The link gave out under a command.  True when that ends the session.

        False means it is being dealt with instead: the session stays up,
        broken, either with a run of attempts under way or waiting for the
        next command to be told why it will not reconnect.
        """
        chan = self.chan
        _session_log("session.failed", logging.ERROR, self,
                     chan, reason=reason)
        if not self.link_down():
            return True                   # the program itself ended
        # The old transport cannot complete or resynchronize its request.
        # Clear it before reconnect backoff, including pending commands whose
        # client already left. Do not abort it: that would try Ctrl-C/resync on
        # a dead channel. Match the channel so cleanup cannot remove a request
        # belonging to a replacement shell.
        with self.execs_lock:
            if self.default_job is not None and self.default_job.chan is chan:
                self.default_job = None
        if self.retries <= 0:
            return True                   # no --reconnect: as it always was
        self.note_broken(reason)
        self.start_reconnect()            # a no-op if reconnection is refused
        return False

    def note_broken(self, reason):
        with self.state_lock:
            if self.broken is None:
                self.broken = reason
                self.attempt = 0

    def check_link(self):
        """Poll between requests.  True when the session is over for good."""
        with self.state_lock:
            if self.broken is not None:
                return False              # known, and already being dealt with
        try:
            if not self.chan.exit_status_ready():
                return False
        except Exception as exc:
            _session_log("shell.poll_failed", logging.ERROR, self,
                         self.chan, exc)
        return self.failed("the connection to %s dropped" % self.target)

    def take_notice(self):
        with self.state_lock:
            notice, self.notice = self.notice, None
        return notice

    def start_reconnect(self):
        """Begin a run of attempts in the background, if one may run at all.

        In the background because the alternative is worse in both
        directions: the client that found the break is told at once rather
        than held for the length of a reboot, and --status, --stop and the
        next command keep being answered while the attempts go on.
        """
        with self.state_lock:
            if self.reconnecting or self.broken is None:
                return
            if self.retries <= 0 or self.refusal():
                return
            self.reconnecting = True
            # Counted here rather than in the thread: the client that found
            # the break is answered immediately, and "attempt 0 of 20" would
            # be a worse answer than the truth.
            self.attempt = 1
        worker = threading.Thread(target=self._reconnect_run)
        worker.daemon = True
        worker.start()

    def _reconnect_run(self):
        try:
            for attempt in range(1, self.retries + 1):
                with self.state_lock:
                    self.attempt = attempt
                # Wait first, always: whatever just went down is not back a
                # millisecond later, and an immediate attempt would only burn
                # one of the few we have on a machine that has not begun to
                # boot.
                if self.stopping.wait(self._backoff(attempt)):
                    return
                _session_log("reconnect.attempt", session=self, attempt=attempt)
                if self.rebuild():
                    return
        except BaseException as exc:
            _session_log("reconnect.worker_failed", logging.ERROR, self, exc=exc)
            raise
        finally:
            with self.state_lock:
                self.reconnecting = False
                if self.broken is not None:
                    self.exhausted = True

    @staticmethod
    def _backoff(attempt):
        return min(2.0 * (2 ** (attempt - 1)), SESSION_RECONNECT_CAP)

    def rebuild(self):
        """One attempt: a new chain, a new shell, swapped in.  True if it took.

        The old chain is closed only once the new one is serving, so a failed
        attempt leaves the session exactly as it was -- still broken, still
        holding the descriptors it held, still able to answer --status.
        """
        opts = self.reconnect_opts
        try:
            clients, transport, chan, mark = _open_shell(
                self.jumps, self.target, opts)
        except BaseException as exc:
            _session_log("reconnect.connect_failed", logging.WARNING,
                         self, exc=exc)
            self.last_error = _one_line(exc)
            return False

        previous = (self.chain, self.chan, self.transport, self.mark,
                    self.rcfile_path)
        with self.lock:
            if self.stopping.is_set():
                close_all(clients)
                return False
            self.chain, self.chan = clients, chan
            self.transport, self.mark = transport, mark.encode("utf-8")
            with self.execs_lock:
                self.default_job = None
            try:
                self.setup(self.setup_wait)
                self.setup_rcfile()
                if self.stopping.is_set():
                    self.cleanup_rcfiles()
                    raise _SessionDead("session stopped during reconnect")
            except BaseException as exc:
                _session_log("reconnect.setup_failed", logging.WARNING,
                             self, self.chan, exc)
                # The hops answered but the shell behind them did not; put
                # back what was there and let the next attempt try again.
                self.last_error = _one_line(exc)
                (self.chain, self.chan,
                 self.transport, self.mark, self.rcfile_path) = previous
                close_all(clients)
                return False

        with self.state_lock:
            was = self.broken
            self.broken = None
            self.exhausted = False
            self.last_error = ""
            self.reconnects += 1
            self.notice = (
                "mssh: session %s reconnected to %s after %s.  This is a new "
                "shell: the working directory, the environment and any "
                "background jobs of the old one are gone."
                % (self.name, self.target, was or "a dropped connection"))
        close_all(previous[0])
        _session_log("reconnect.ready", session=self, chan=self.chan)
        return True

    def resolve(self):
        """What a command arriving on a broken session is owed.

        None when there is nothing to say and the command may run.  Otherwise
        (message, fatal), where fatal ends the session: a refusal, or the last
        attempt failing.  The run of attempts behind this is the one the break
        started; this is the extra one the spec asks for, so that a session
        that was down the whole time a script was asleep still gets a chance
        before it is given up on.
        """
        with self.state_lock:
            if self.broken is None:
                return None
            refusal = self.refusal()
            if refusal:
                return ("mssh: session %s ended: %s, and it cannot reconnect: "
                        "%s" % (self.name, self.broken, refusal), True)
            if self.reconnecting:
                return ("mssh: session %s: %s; reconnecting (attempt %d of "
                        "%d) -- try again in a moment, --status to watch it, "
                        "--stop to give up"
                        % (self.name, self.broken, self.attempt, self.retries),
                        False)
            # The run is over and the link is still down.  One more attempt
            # now, because a command arriving is new information: something
            # out there expects the target to be up.
            self.reconnecting = True
        try:
            if self.rebuild():
                return None
        finally:
            with self.state_lock:
                self.reconnecting = False
        return ("mssh: session %s ended: %s, and it could not be reconnected "
                "in %d attempts (last error: %s)"
                % (self.name, self.broken, self.retries + 1,
                   self.last_error or "unknown"), True)

    def link_state(self):
        with self.state_lock:
            if self.broken is None:
                return "up", None, self.attempt
            if self.reconnecting:
                return "reconnecting", self.broken, self.attempt
            return "down", self.broken, self.attempt


# -- wire protocol ---------------------------------------------------------
#
# One request per connection, so a wedged one cannot block the socket for
# everyone else.  The socket carries JSON and nothing else, in both directions:
# the request is one line of it and the reply is exactly one more line, with
# only --exec -t adding anything in between (the resize lines below).
#
# The command's output does not travel on the socket at all.  It goes over a
# pipe the *client* creates and whose write end it hands over with the request
# (SCM_RIGHTS), so the daemon copies the remote program's bytes straight into
# it and the client reads them straight out.  Nothing is framed, so nothing has
# to be encoded: the earlier design wrapped every line in {"out": <base64>},
# which cost a JSON encode and decode and a base64 round trip per line of a
# build's output.  A pipe also streams for free -- the bytes are readable the
# moment they are written -- which is what the stream of messages existed to
# provide.
#
# Descriptors ride with an "op": "send" request, in this order:
#
#     fds[0]   the write end of the client's output pipe   (always)
#     fds[1]   the client's own stdin, for "stdin": true   (optional)
#
# "op": "exec" is the same exchange for a command that runs on a channel of
# its own rather than in the session's shell.  It carries one descriptor more,
# because without a pty the two output streams were never merged:
#
#     fds[0]   the write end of the client's stdout pipe   (always)
#     fds[1]   the write end of the client's stderr pipe   (always)
#     fds[2]   the client's own stdin, for "stdin": true   (optional)
#
# Its reply is the same single status message, and its stdin needs no fifo:
# the command's own channel carries it natively, since no pty is in the way.
#
# "op": "sftp" borrows the transport for a dedicated SFTP subsystem channel:
#
#     fds[0]   the daemon end of a client's duplex socketpair   (always)
#
# The request may include display metadata for --jobs:
#
#     {"op": "sftp",
#      "transfer": {"kind": "put" or "get",
#                   "source": "...", "destination": "..."}}\n
#
# These fields label the job; they do not execute a copy on the daemon.
# After opening the subsystem, the daemon sends {"ok": true}\n on the
# control connection. The client then speaks binary SFTP over its socketpair
# end, using a normal SFTPClient; the daemon relays bytes in both directions.
# Neither file contents nor SFTP packets travel through the JSON connection.
# The control connection stays open so a disconnected client ends the relay.
# There is no final command-status reply on successful SFTP completion:
# closing the duplex socket/channel ends the transfer. Setup/relay failures
# may send {"error": "..."} on the control connection.
#
# "op": "jobs" needs no descriptors and returns a single snapshot:
#
#     {"op": "jobs"}\n
#     {"jobs": [{"id": N, "kind": "...", "command": "...",
#                "channel": N or null, "started": UNIX_SECONDS,
#                "default": true or false,
#                "forward_type": "local" or "socks" or null,
#                "state": "running" or "pending" or "stopping"}, ...]}\n
#
# It is answered before link resolution, like status, without taking the
# persistent shell lock or starting a reconnect. The idle primary shell or
# -c program is excluded; its current request is the default job, in either
# mode. Exec/login, SFTP channels and local forwards are included. Completed jobs
# disappear; pending primary requests can outlive their client.
# This is daemon metadata, not the remote shell's process/job table.
# The status reply keeps "jobs": N for --sessions and older clients, and
# adds "job_details": [...] from that same snapshot. "default" identifies the
# primary request; "forward_type" distinguishes -L from -D while preserving
# the existing "forward" job kind. Status also includes "last_activity"
# (UNIX_SECONDS), "idle_limit" (seconds; zero disables expiry) and "stopping"
# (boolean). These are read-only metadata: a query does not refresh activity,
# acquire the primary lock, resynchronize a pending task or trigger reconnect.
# Clients must distinguish absent details from an empty list on old daemons.
#
# "op": "forward" adds persistent local TCP/Unix listeners, with no descriptors:
#
#     {"op": "forward", "specs": ["[bind:]port:host:hostport",
#                               "[bind:]port:remote_socket",
#                               "local_socket:host:hostport",
#                               "local_socket:remote_socket", ...]}\n
#     {"ok": true, "forwards": [{"id": N, "command": "bind -> target"}, ...]}\n
#
# The daemon validates and binds the entire batch before registration.
# Failures roll back the batch without changing existing listeners.
# Each listener is one "forward" job with a null channel field; it owns
# all accepted sockets and direct-tcpip/direct-streamlocal@openssh.com channels
# until interrupted. Local relative socket paths are made absolute by the
# configuring client; remote socket paths are passed literally to the target.
# Bind never overwrites a path. Teardown unlinks only the local socket inode
# created by that job, never the remote socket or a replaced local path.
# The request client may exit immediately: no client socket owns the job.
# Forward configuration and targeted cancellation work while reconnecting.
# Listener jobs survive transport replacement; individual connections do not.
#
# "op": "dynamic_forward" adds SOCKS listeners, optionally with a -L batch:
#
#     {"op": "dynamic_forward", "dynamic_specs": ["[bind:]port", ...],
#      "specs": ["[bind:]port:host:hostport", ...]}\n
#
# Reply and atomic registration are the same as "forward". A distinct op
# prevents old daemons from silently ignoring -D fields. Each SOCKS listener
# is a "forward" job ("bind -> SOCKS4/5"), owning handshakes and connections.
# SOCKS4/4a and SOCKS5 support unauthenticated TCP CONNECT only. Requests
# select each destination; names go to the target without local resolution.
# CONNECT success follows SSH channel-open success, not just SOCKS parsing.
# Handshakes have a total timeout and bounded fields; pipelined application
# bytes remain unread until the shared relay takes over.
#
#     {"op": "interrupt"}\n
#     {"op": "interrupt", "job": N}\n
#
# --stop --job ID uses the targeted interrupt request above, never the
# session-wide stop request. This also works with existing job-aware daemons.
#
# Without a job ID only the current default job is interrupted; idle is a
# no-op. Default shell/interactive jobs are created per request and retain
# cancellation state until completion or resynchronization. Their IDs signal
# the request without closing the primary channel;
# exec/login/SFTP job IDs close only their own channel. Forward job IDs close
# their listener and all active connections. Unknown IDs fail.
# Exec/login/SFTP requests may include a random "job_token", also sent with their
# client's interrupt request, to target Ctrl-C before the client knows the ID.
# On daemon exit all job channels, listeners and the primary channel close.
#
# An exec may carry a "pty": {"term": ..., "cols": N, "rows": N} for a command
# that will not run without a terminal.  The size is the client's window and
# the raw mode that goes with it is the client's own terminal: the daemon is
# detached and has no terminal to set, so the request is all that crosses.
#
# It may also carry "shell": true, with an empty "line", which is a login --
# 'mssh host' -- and starts the target's shell on that channel rather than a
# command.  It is a key of its own rather than an empty command because an
# empty command is a command: a daemon that did not know the key would run one
# and exit, where this one starts a shell and holds the channel.
#
# That window can then be dragged while the command runs, and a resized one is
# the single thing a client sends *after* its request:
#
#     {"op": "resize", "cols": N, "rows": N}\n
#
# up the connection the command is already using, read by the loop driving that
# command and turned into a window-change on its channel.  It is not answered
# and it cannot fail the command -- an unparseable or impossible one is
# dropped.  No identifier is needed: the connection is the command.
#
# stdin is passed the same way rather than being written down the socket: the
# data is a byte stream of unknown length that must reach the remote command as
# it arrives ('tail -f | mssh --session s cat' has to work), and reading the
# producer's descriptor directly means no relay, no half-close protocol and no
# second thread.
#
# The command's end is the one thing that is still a message, because it is one
# fact rather than a stream: {"status": N, "timed_out": bool, "end": true}, or
# {"error": "..."}.  The daemon closes the output pipe *before* sending it, so
# by the time the client reads the status its output is already complete at the
# EOF on the pipe.
#
# One more line may come *before* that one, and only before it:
#
#     {"notice": "..."}\n
#
# which is mssh telling the user something about the session rather than about
# this command -- today, that the chain was rebuilt under it by --reconnect and
# the shell is therefore a new one.  It goes in front of the command instead of
# after it because it changes how the output should be read.  A client reads
# lines until one is not a notice; that line is the reply.  status, jobs, stop and
# interrupt never carry one: they are a single line each way, and a client that
# reads exactly one line is right about them.
#
# On a send the client does not half-close its end of the socket, and the
# daemon does not read from it: the socket going readable can then only mean
# the client has gone, which is how a command notices that nobody is listening
# any more.  status, jobs, stop and interrupt are a plain request, half-close, one
# reply.


def _reply(conn, payload):
    """The daemon's one JSON line, and the half-close that ends the exchange."""
    try:
        conn.sendall(json.dumps(payload).encode("utf-8") + b"\n")
        conn.shutdown(socket.SHUT_WR)
    except (socket.error, OSError) as exc:
        _session_log("protocol.reply_failed", logging.DEBUG, exc=exc)


def _notify(conn, payload):
    """A line sent ahead of the reply, leaving the exchange open.

    Send/exec clients read notices until their final status arrives. SFTP
    uses this helper for its initial {"ok": true} while keeping the control
    connection open. Status, jobs, stop and interrupt are one line each in
    both directions and are left exactly as they were.
    """
    try:
        conn.sendall(json.dumps(payload).encode("utf-8") + b"\n")
    except (socket.error, OSError) as exc:
        _session_log("protocol.notify_failed", logging.DEBUG, exc=exc)


def _reconnecting_message(session, exc):
    """What a command that the link died under is told.

    What happened to the command comes first, because that is what was
    asked; what is being done about it comes second, so that a script
    reading stderr can tell "run this again shortly" from "this session is
    over".
    """
    link, _broken, attempt = session.link_state()
    if link == "reconnecting":
        return ("mssh: session %s: %s; the connection dropped and is being "
                "rebuilt (attempt %d of %d) -- run the command again in a "
                "moment, --status to watch it, --stop to give up"
                % (session.name, _one_line(exc), attempt, session.retries))
    return ("mssh: session %s: %s; the connection dropped and cannot be "
            "rebuilt: %s" % (session.name, _one_line(exc),
                             session.refusal() or "no reconnection is armed"))


def _connect_session(name, timeout):
    import errno

    path = session_path(name)
    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    conn.settimeout(timeout)
    try:
        conn.connect(path)
    except socket.timeout:
        conn.close()
        raise SystemExit("mssh: session %s: timed out connecting to the "
                         "session daemon" % name)
    except (socket.error, OSError) as exc:
        conn.close()
        if exc.errno in (errno.ENOENT, errno.ECONNREFUSED):
            raise SessionGone(path)
        raise SystemExit("mssh: session %s: %s" % (name, exc))
    return conn


def _parse_reply(name, raw):
    """One line of the daemon's JSON, or a SystemExit naming what came back."""
    try:
        return json.loads(raw.decode("utf-8", "replace"))
    except ValueError:
        raise SystemExit("mssh: session %s: malformed reply from the session "
                         "daemon" % name)


def _is_notice(message):
    """A line that says something happened, rather than ending the command."""
    return isinstance(message, dict) and "notice" in message \
        and "status" not in message and "error" not in message


def _session_notice(text):
    """One of the daemon's out-of-band lines, on stderr.

    stderr because it is mssh talking, not the command: a notice mixed into
    stdout would end up in the file a redirected command was writing.  And
    \\r\\n while a login or an --exec -t holds this terminal raw, since with
    the line discipline gone nothing else returns the carriage and the next
    line would start under the end of this one.
    """
    end = "\r\n" if _RAW["depth"] > 0 else "\n"
    sys.stderr.write(text.rstrip("\r\n").replace("\n", end) + end)
    sys.stderr.flush()


def session_request(name, payload, timeout=None):
    """Send one request, half-close, and return the daemon's single reply.

    What --status, --stop, --interrupt, --jobs, -L and the liveness probe use:
    one line of JSON each way, nothing streamed. A command's output does not
    come back this way -- see session_send.
    """
    conn = _connect_session(name, timeout)
    buf = b""
    try:
        conn.sendall(json.dumps(payload).encode("utf-8") + b"\n")
        conn.shutdown(socket.SHUT_WR)
        while b"\n" not in buf:
            try:
                data = conn.recv(65536)
            except socket.timeout:
                raise SystemExit("mssh: session %s: the session daemon "
                                 "stopped responding" % name)
            except ConnectionResetError:
                # The daemon closed the moment its reply was out.  The request
                # was fully read long before, so nothing of ours was lost, and
                # a reset is not an error of its own.
                break
            if not data:
                break
            buf += data
    finally:
        conn.close()

    line = buf.split(b"\n", 1)[0].strip()
    if not line:
        raise SystemExit("mssh: session %s: the session daemon closed the "
                         "connection without replying" % name)
    return _parse_reply(name, line)


def _session_pipes(name, payload, outputs, send_stdin=False, watcher=None):
    """Run one command behind N pipes: copy each to its stream, return the end.

    The output does not come back over the socket.  A pipe per stream is
    created here and its write end handed to the daemon with the request, so
    the remote program's bytes are copied into it and read out of it unchanged
    -- no framing, no base64, no JSON per line.  With send_stdin the local
    stdin descriptor goes the same way and the daemon feeds the command from
    it directly.

    outputs names the local streams, in the order the daemon expects the
    descriptors: one (merged output) for a session send, two (stdout, stderr)
    for an --exec.  Every end is watched until it is finished: each pipe until
    EOF, which is what says that stream is complete, and the socket until its
    one status message arrives.  The daemon closes the pipes first, so no
    order of arrival loses anything.

    watcher is the SIGWINCH pipe of an --exec -t, watched alongside those: a
    resize has to be sent while the command runs, and this loop is the only
    place awake for its whole length.  It never ends the loop -- a window that
    was resized is not a command that is over -- so it is not in the list the
    loop drains down to nothing.

    The write side is deliberately left open, and with --exec -t it is used:
    the resize lines go up it.  A send with no watcher writes nothing after
    the request, so the socket becoming readable on the daemon's end still
    means what it always did -- this process has gone -- which is how an
    abandoned command gets noticed.
    """
    conn = _connect_session(name, None)
    pipes = []                            # [(rfd, stream)], in request order
    wfds = []
    buf = b""
    reply = None
    try:
        for stream in outputs:
            rfd, wfd = os.pipe()
            pipes.append([rfd, stream])
            wfds.append(wfd)

        line = json.dumps(payload).encode("utf-8") + b"\n"
        fds = list(wfds)
        if send_stdin:
            fd = stdin_fd()
            if fd is None:
                raise SystemExit("mssh: session %s: stdin was requested but "
                                 "there is none to pass" % name)
            fds.append(fd)
        sent = conn.sendmsg([line],
                            [(socket.SOL_SOCKET, socket.SCM_RIGHTS,
                              array.array("i", fds).tobytes())])
        if sent < len(line):
            # A request longer than the socket buffer went out in part; the
            # descriptors rode on its first byte, the rest is plain.
            conn.sendall(line[sent:])
        while wfds:                       # the daemon holds the only write end
            os.close(wfds.pop())

        conn.settimeout(None)
        watch = [rfd for rfd, _stream in pipes] + [conn]
        while watch:
            try:
                ready, _w, _x = select.select(
                    watch + ([watcher.fileno()] if watcher else []), [], [])
            except (select.error, InterruptedError):
                continue
            if watcher is not None and watcher.fileno() in ready:
                watcher.pump(conn)
            for rfd, stream in pipes:
                if rfd not in ready:
                    continue
                try:
                    data = os.read(rfd, 65536)
                except OSError:
                    data = b""
                if data:
                    stream.write(data)
                    stream.flush()
                else:
                    watch.remove(rfd)     # EOF: that stream is complete
            if conn in ready:
                try:
                    data = conn.recv(65536)
                except (socket.error, OSError):
                    data = b""
                if not data:
                    watch.remove(conn)
                    continue
                buf += data
                # Usually one line, the status.  A daemon that reconnected
                # puts a notice in front of it, which is not the end of
                # anything: print it and keep waiting for the real reply.
                while reply is None and b"\n" in buf:
                    head, buf = buf.split(b"\n", 1)
                    head = head.strip()
                    if not head:
                        continue
                    message = _parse_reply(name, head)
                    if _is_notice(message):
                        _session_notice(message["notice"])
                        continue
                    reply = message
                if reply is not None:
                    watch.remove(conn)
    finally:
        for wfd in wfds:
            os.close(wfd)
        for rfd, _stream in pipes:
            os.close(rfd)
        conn.close()

    if reply is None:
        raise SystemExit("mssh: session %s: the session daemon closed the "
                         "connection without replying" % name)
    return reply


def session_send(name, payload, send_stdin=False, watcher=None):
    """Run one command in the session's shell; its output is already merged."""
    return _session_pipes(name, payload, [sys.stdout.buffer],
                          send_stdin=send_stdin, watcher=watcher)


def session_exec(name, payload, send_stdin=False, watcher=None):
    """Run one command on a channel of its own, stdout and stderr apart.

    Two pipes rather than one: without a pty the remote command's streams are
    never merged, so they are carried separately all the way to this process's
    own stdout and stderr, which is what lets 'mssh --session s --exec cmd
    2>/dev/null' do what it says.
    """
    return _session_pipes(name, payload,
                          [sys.stdout.buffer, sys.stderr.buffer],
                          send_stdin=send_stdin, watcher=watcher)


def session_alive(name):
    try:
        session_request(name, {"op": "status"}, timeout=10.0)
        return True
    except SessionGone:
        return False


# -- daemon ----------------------------------------------------------------


def _session_lock():
    """Hold the spawn window: probe, clear a stale socket, bind.

    Without it two simultaneous first calls could both find no daemon, both
    unlink and both bind.  Once the socket is listening it is its own guard, so
    the lock is released as soon as bind() returns.

    One shared lock file rather than one per session: spawns are brief and
    rare, so serializing them all costs nothing, and a per-name file would
    litter the directory with a lock for every session ever started -- there is
    no safe moment to delete one of those, since another process may be
    holding it.
    """
    import fcntl
    fd = os.open(os.path.join(session_dir(), ".spawn.lock"),
                 os.O_CREAT | os.O_RDWR, 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def _session_listen(name):
    """Create the listening socket for a new session, 0600."""
    path = session_path(name)
    lock_fd = _session_lock()
    try:
        if session_alive(name):
            raise SystemExit(
                "mssh: session %r is already running; --status to inspect "
                "it, --stop to end it" % name
            )
        try:
            os.unlink(path)               # a stale socket from a killed daemon
        except OSError:
            pass
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        old = os.umask(0o177)
        try:
            srv.bind(path)
        finally:
            os.umask(old)
        os.chmod(path, 0o600)
        srv.listen(16)
    finally:
        os.close(lock_fd)
    return srv, path


def _ready(fd, payload):
    try:
        os.write(fd, json.dumps(payload).encode("utf-8") + b"\n")
    except OSError:
        pass
    try:
        os.close(fd)
    except OSError:
        pass


def _session_predetach():
    """Prepare the daemon-to-be, but keep the controlling terminal.

    Called in the forked child before the chain is built.  Deliberately does
    NOT setsid yet: setsid destroys the controlling terminal (measured --
    /dev/tty stops opening immediately afterwards), and the chain still has to
    be able to ask for a password.  connect_hop's getpass reads /dev/tty, so it
    works here and would fail on the far side of a setsid.

    stdin, stdout and stderr are all left alone for the same reason, plus one
    more: -v logs the chain being built, and redirecting stderr here would send
    exactly the interesting part to a file while the terminal showed only the
    last line.  _session_detach() takes all of it away once the session is up.
    """
    os.chdir("/")
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)


def _session_detach(name, opts):
    """Become a daemon for real: leave the session, drop the std fds.

    Split from _session_predetach because everything here has to happen after
    the chain is built: setsid gives up the controlling terminal, so no
    password can be asked for beyond this point.

    Under -v, stderr goes on to <session>.log.  That is decided here rather
    than by the caller because this is the only place it matters, and the log
    therefore holds only what happens after this moment -- the startup trace
    has already gone to the terminal.

    There is deliberately no second fork here.  The usual reason for one is to
    guarantee the daemon can never reacquire a controlling terminal, but it
    would have to happen after paramiko's threads exist, and forking a
    multi-threaded process is exactly what this design goes out of its way to
    avoid (Python warns about it, too).  setsid alone already detaches us; the
    session leader could only reacquire a terminal by opening one deliberately,
    which nothing here does.
    """
    sys.stdout.flush()
    sys.stderr.flush()

    os.setsid()

    null = os.open(os.devnull, os.O_RDWR)
    os.dup2(null, 0)
    os.dup2(null, 1)
    if opts.verbose:
        out = os.open(os.path.join(session_dir(), name + ".log"),
                      os.O_WRONLY | os.O_CREAT | os.O_APPEND |
                      getattr(os, "O_NOFOLLOW", 0), 0o600)
        try:
            os.fchmod(out, 0o600)
            os.dup2(out, 2)
        finally:
            os.close(out)
    else:
        os.dup2(null, 2)
    if null > 2:
        os.close(null)


def _session_serve(session, srv, path, opts):
    """Answer requests until stopped, the program dies, or idle expires.

    The chain is the session's own (session.chain), not a local variable: a
    --reconnect replaces it with a new one, and the clients closed on the way
    out have to be whichever ones are serving by then.
    """
    state = {"stop": False}

    def handle(conn):
        _SESSION_LOG_CONTEXT.request = secrets.token_hex(4)
        _session_log("request.accepted", logging.DEBUG)
        held = []            # the descriptors sent with the request, while ours
        try:
            uid = _peer_uid(conn)
            if uid is not None and uid != os.getuid():
                # Before the request is even read: a foreign uid must not get
                # as far as handing us descriptors.
                _reply(conn, {"error": "mssh: permission denied: uid %d is "
                                       "not the session owner" % uid})
                return
            conn.settimeout(30.0)
            data = b""
            while b"\n" not in data:
                chunk, ancdata, _flags, _addr = conn.recvmsg(
                        65536,
                        socket.CMSG_SPACE(SESSION_MAX_FDS
                                          * array.array("i").itemsize))
                for level, ctype, cred in ancdata:
                    if level == socket.SOL_SOCKET and ctype == socket.SCM_RIGHTS:
                        # A send carries the output pipe and, with stdin, the
                        # client's producer.  Anything beyond those is not part
                        # of the protocol: close it rather than leak it.
                        fds = array.array("i")
                        fds.frombytes(cred[:len(cred) - (len(cred) % fds.itemsize)])
                        for one in fds:
                            if len(held) < SESSION_MAX_FDS:
                                held.append(one)
                            else:
                                os.close(one)
                if not chunk:
                    break
                data += chunk
            if not data.strip():
                return
            head, rest = data.split(b"\n", 1)
            req = json.loads(head.decode("utf-8"))
            _SESSION_LOG_CONTEXT.op = req.get("op")
            _session_log("request.start", logging.DEBUG, descriptors=len(held))
            # Whatever came after the request line is not read here.  Only an
            # --exec -t sends anything more -- a resize, when the client's
            # window changed before this read drained the socket -- and that
            # belongs to the loop driving the command, so it is handed over
            # rather than dropped.
            dispatch(conn, req, held, rest)
        except Exception as exc:                          # never kill the loop
            _session_log("request.failed", logging.ERROR, session, exc=exc)
            _reply(conn, {"error": "mssh: session daemon: %s" % exc})
        except BaseException as exc:
            _session_log("request.worker_failed", logging.CRITICAL,
                         session, exc=exc)
            raise
        finally:
            for one in held:
                if one is not None:
                    try:
                        os.close(one)     # never taken over: leak nothing
                    except OSError as exc:
                        _session_log("request.fd_close_failed", logging.WARNING,
                                     exc=exc, fd=one)
            try:
                conn.close()
            except Exception as exc:
                _session_log("request.close_failed", logging.WARNING, exc=exc)
            _session_log("request.finished", logging.DEBUG)
            _SESSION_LOG_CONTEXT.__dict__.clear()

    def dispatch(conn, req, held, rest=b""):
        """Handle one request.

        rest is whatever arrived behind the request line, for the one op that
        can have any: an --exec -t whose window was resized straight away.

        held holds the descriptors that arrived with it -- for a send, the
        output pipe's write end and (with stdin) the client's own stdin; for an
        exec, stdout, stderr and the same optional stdin.  Each is taken out of
        the list by whoever becomes responsible for closing it; handle()'s
        finally closes whatever is left, so no path can leak one.  A descriptor
        kept open by mistake is not harmless: the client's producer (a 'yes'
        pipe) would be held for as long as the daemon lives.
        """
        def take(index):
            if index < len(held):
                fd, held[index] = held[index], None
                return fd
            return None

        def drop():
            for index in range(len(held)):
                fd = take(index)
                if fd is not None:
                    os.close(fd)

        op = req.get("op")
        if op not in ("send", "exec", "sftp"):
            drop()
        if op == "jobs":
            _reply(conn, {"jobs": session.jobs_snapshot()})
            return
        if op == "status":
            # Answered whatever state the link is in: a session whose target
            # is rebooting is exactly when somebody wants to look at it.
            link, broken, attempt = session.link_state()
            jobs = session.jobs_snapshot()
            _reply(conn, {
                "target": str(session.target), "command": session.command,
                "mode": session.mode, "started": session.started,
                "served": session.served, "pid": os.getpid(),
                "dead": session.dead, "running": session.lock.locked(),
                "link": link, "broken": broken, "attempt": attempt,
                "retries": session.retries, "reconnects": session.reconnects,
                "refusal": session.refusal(), "last_error": session.last_error,
                "rcfile": session.rcfile_path,
                # Keep the numeric count for --sessions and older clients.
                # Details use the same snapshot, without a second request or
                # waiting for the primary shell to finish its current command.
                "jobs": len(jobs), "job_details": jobs,
                "last_activity": session.last,
                "idle_limit": opts.session_idle,
                "stopping": session.stopping.is_set(),
            })
            return
        if op == "stop":
            _session_log("daemon.stop_requested", session=session)
            session.stopping.set()
            session.cleanup_rcfiles()
            state["stop"] = True
            _reply(conn, {"ok": True})
            return
        if op in ("forward", "dynamic_forward"):
            try:
                # Older daemons ignore unknown fields. Clients use a distinct
                # op for -D so an old server cannot silently acknowledge it.
                if op == "dynamic_forward":
                    if not req.get("dynamic_specs"):
                        raise ValueError("-D requires at least one proxy specification")
                    jobs = session.add_forwards(
                        req.get("specs", []), dynamic_specs=req.get("dynamic_specs"))
                else:
                    jobs = session.add_forwards(req.get("specs"))
            except Exception as exc:
                _session_log("forward.setup_failed", logging.WARNING,
                             session, exc=exc)
                _reply(conn, {"error": "mssh: cannot configure %s: %s" %
                              ("-L/-D" if op == "dynamic_forward" else "-L", exc)})
            else:
                _reply(conn, {"ok": True, "forwards": [
                    {"id": job.id, "command": job.command} for job in jobs]})
            return
        if op not in ("send", "exec", "interrupt", "sftp"):
            _reply(conn, {"error": "mssh: unknown request %r" % (op,)})
            return
        if session.dead:
            drop()
            _reply(conn, {"error": "mssh: session ended: %s" % session.dead})
            return

        # The link is down and this command is the first to arrive since.
        # Either it is being reconnected (say so, and let the caller try
        # again), or the run of attempts is over and this is the last one --
        # which, if it fails, is where the session finally ends.
        # Targeted cancellation also works while the SSH link is down:
        # a forward listener is local state, not a remote command.
        verdict = None if op == "interrupt" and (
            req.get("job") is not None or req.get("job_token") is not None
        ) else session.resolve()
        if verdict is not None:
            message, fatal = verdict
            drop()
            if fatal:
                die(message)
            _reply(conn, {"error": message})
            return

        if op == "sftp":
            fd = take(0)
            if fd is None:
                _reply(conn, {"error": "mssh: SFTP request needs a duplex socket"})
                return
            chan = None
            job = None
            try:
                chan = session.transport.open_session(timeout=session.timeout)
                _SESSION_LOG_CONTEXT.channel = getattr(chan, "chanid", None)
                _session_log("sftp.opened", session=session, chan=chan, relay_fd=fd)
                chan.settimeout(session.timeout)
                transfer = req.get("transfer") or {}
                kind = transfer.get("kind", "sftp")
                if kind not in ("put", "get"):
                    kind = "sftp"
                description = "%s -> %s" % (
                    transfer.get("source", ""), transfer.get("destination", ""))
                job = session._new_job(chan, kind, description,
                                       token=req.get("job_token"))
                session._register_job(job)
                session.served += 1
                chan.invoke_subsystem("sftp")
                os.set_blocking(fd, False)
                sink = _FdSink(fd)
                _notify(conn, {"ok": True})
                status, timed_out = session._pump_exec(
                    job, sink, _BufSink(), float("inf"), in_fd=fd, conn=conn)
                _session_log("sftp.finished", session=session, chan=chan,
                             status=status, timed_out=timed_out)
                sink.drain()
            except _ClientGone as exc:
                _session_log("sftp.client_gone", logging.DEBUG,
                             session, chan, exc)
            except Exception as exc:
                _session_log("sftp.failed", logging.ERROR, session, chan, exc)
                if session.link_down():
                    session.failed(str(exc))
                _reply(conn, {"error": "mssh: cannot open or relay SFTP: %s" % exc})
            finally:
                if job is not None:
                    with session.execs_lock:
                        session.execs.discard(job)
                if chan is not None:
                    _session_log("sftp.closing", session=session, chan=chan)
                    try:
                        _close_session_channel(chan)
                    except Exception as exc:
                        _session_log("sftp.close_failed", logging.ERROR,
                                     session, chan, exc)
                        raise
                    finally:
                        os.close(fd)
                    _session_log("sftp.closed", session=session, chan=chan)
                else:
                    os.close(fd)
                session.last = time.time()
            return

        if op == "interrupt":
            try:
                job_id = req.get("job")
                token = req.get("job_token")
                if job_id is not None:
                    if type(job_id) is not int or job_id < 0:
                        raise ValueError("job ID must be a nonnegative integer")
                    signalled = session.interrupt_job(job_id)
                elif token is not None:
                    signalled = session.interrupt_job(token=token)
                else:
                    # -c replaces the default shell with a program; only
                    # that primary channel is signalled, never exec/SFTP.
                    signalled = session.interrupt_job()
            except ValueError as exc:
                _reply(conn, {"error": "mssh: %s" % exc})
                return
            except _SessionDead as exc:
                _session_log("session.interrupt_failed", logging.ERROR,
                             session, session.chan, exc)
                # The Ctrl-C found the break rather than caused it, so it is
                # the same decision as everywhere else: end the session, or
                # start rebuilding it.
                if session.failed(str(exc)):
                    die(str(exc))
                    _reply(conn, {"error": "mssh: session ended: %s" % exc})
                else:
                    _reply(conn, {"error": _reconnecting_message(session, exc)})
                return
            # Whatever output the interrupt produced belongs to the client
            # that is still streaming the interrupted command, not to this
            # one, so there is nothing to return but the fact of it.
            _reply(conn, {"interrupted": signalled, "status": None,
                          "timed_out": False})
            return

        wait = req.get("wait")
        wait = DEFAULT_SESSION_WAIT if wait is None else float(wait)
        if wait <= 0:
            wait = float("inf")           # --wait 0: until it ends or Ctrl-C
        with_stdin = bool(req.get("stdin"))

        # Before the command, not after: whoever sent it is about to act on
        # its output, and that it came out of a shell that remembers nothing
        # is the one thing they have to know first.  It goes to the first
        # command only -- after that the new shell is simply the shell.
        notice = session.take_notice()
        if notice:
            _notify(conn, {"notice": notice})

        if op == "exec":
            dispatch_exec(conn, req, take, wait, with_stdin, rest)
            return

        if with_stdin and session.mode != "shell":
            # Interactive mode has nowhere safe to put it.  The program owns
            # the pty, so input could only be typed at it, and a pty in
            # canonical mode truncates a line at 4095 bytes and reads control
            # bytes as signals -- measured, a 0x03 in the data killed the
            # program.  Silently dropping the data would be worse: the command
            # would appear to work while reading nothing.
            drop()
            _reply(conn, {"error":
                          "mssh: this session holds an interactive program "
                          "(-c %s), whose input is the command line itself; "
                          "stdin cannot be forwarded to it"
                          % (session.command or "")})
            return
        out_fd = take(0)
        if out_fd is None:
            # Every send owes an output pipe with its request; missing, it is a
            # mismatch between client and running daemon.
            _reply(conn, {"error": "mssh: no output pipe came with the "
                                   "request; the running daemon is older than "
                                   "this client -- --stop the session and "
                                   "start it again"})
            return
        in_fd = take(1) if with_stdin else None
        if with_stdin and in_fd is None:
            os.close(out_fd)
            _reply(conn, {"error": "mssh: stdin was requested but no "
                                   "descriptor came with it; the running "
                                   "daemon is older than this client -- "
                                   "--stop the session and start it again"})
            return

        in_chan, in_path = None, None
        try:
            if with_stdin:
                # Open the writer channel *before* the command is framed: it is
                # what creates the fifo, and a command framed against a path
                # that does not exist yet fails at once with "No such file or
                # directory".
                try:
                    in_chan, in_path = session.open_stdin_writer()
                except _SessionDead as exc:
                    _session_log("stdin.setup_failed", logging.ERROR,
                                 session, exc=exc)
                    _reply(conn, {"error": "mssh: %s" % exc})
                    return

            # The output pipe is written from the one loop below, which must
            # never block on it: a client that stopped reading would otherwise
            # stop the channel being read and pin the pty lock with it.
            os.set_blocking(out_fd, False)
            sink = _FdSink(out_fd)

            try:
                status, timed_out = session.run(
                    req.get("line", ""), wait, sink, in_path=in_path,
                    in_fd=in_fd, in_chan=in_chan, conn=conn)
            except _SessionDead as exc:
                _session_log("shell.request_failed", logging.ERROR,
                             session, session.chan, exc)
                # The command is lost either way, and its client is told so
                # either way; what is decided here is whether the session
                # goes with it.  A connection that dropped under a --reconnect
                # session does not: the attempts start now, in the background,
                # and this client is told to come back.
                if session.failed(str(exc)):
                    die(str(exc))
                    _reply(conn, {"error": "mssh: session ended: %s" % exc})
                else:
                    _reply(conn, {"error": _reconnecting_message(session, exc)})
                return
            except _ClientGone as exc:
                _session_log("shell.client_gone", logging.DEBUG, exc=exc)
                return                    # nobody left to tell
            # Whatever the pipe was too full to take is still output: hand it
            # over before the descriptor goes, or a slow client loses the tail.
            sink.drain()
        finally:
            # The command is over, so nothing will read the fifo again: closing
            # the writer releases the remote 'cat' even if it is still being
            # fed, which is what makes 'yes | mssh --session s "echo hi"' end
            # instead of streaming forever.
            session.close_stdin_writer(in_chan)
            for fd in (out_fd, in_fd):
                if fd is not None:
                    try:
                        os.close(fd)
                    except OSError as exc:
                        _session_log("shell.fd_close_failed", logging.WARNING,
                                     exc=exc, fd=fd)

        # The pipe is closed above, so the client has already seen the end of
        # the output by the time this arrives.
        _session_log("shell.finished", session=session, status=status,
                     timed_out=timed_out)
        _reply(conn, {"status": status, "timed_out": timed_out, "end": True})

    def dispatch_exec(conn, req, take, wait, with_stdin, rest=b""):
        """Run one command on a channel of its own, outside the shell.

        Three descriptors instead of two, because without a pty the command's
        streams were never merged: fds[0] is stdout, fds[1] is stderr, and
        fds[2] is the client's stdin when it asked for one.  stdin needs no
        fifo and no writer channel here -- the command's own channel carries
        it -- so there is far less to set up and far less to take down.

        A "pty" in the request asks for a terminal on that channel, which the
        client sends only when it has a terminal of its own on both ends.  The
        raw mode that goes with it is the client's business too: the daemon has
        no terminal at all -- it is a detached process whose standard
        descriptors are /dev/null -- so there is nothing here to put in raw
        mode and nothing to translate.

        A "shell" in the request means there is no command: 'mssh host' is a
        login, and what starts on the channel is the target's shell itself.
        Nothing else about the exchange changes -- same descriptors, same
        loop, same single status at the end, which is then the shell's own.
        """
        out_fd, err_fd = take(0), take(1)
        if out_fd is None or err_fd is None:
            for fd in (out_fd, err_fd):
                if fd is not None:
                    os.close(fd)
            _reply(conn, {"error": "mssh: --exec needs two output pipes with "
                                   "the request; the running daemon is older "
                                   "than this client -- --stop the session "
                                   "and start it again"})
            return
        in_fd = take(2) if with_stdin else None
        if with_stdin and in_fd is None:
            os.close(out_fd)
            os.close(err_fd)
            _reply(conn, {"error": "mssh: stdin was requested but no "
                                   "descriptor came with it; the running "
                                   "daemon is older than this client -- "
                                   "--stop the session and start it again"})
            return

        try:
            # Both pipes are written from the one loop below, which must never
            # block on either: a client reading stdout while ignoring stderr
            # would otherwise stop the channel being read at all.
            os.set_blocking(out_fd, False)
            os.set_blocking(err_fd, False)
            out_sink, err_sink = _FdSink(out_fd), _FdSink(err_fd)

            pty = req.get("pty") or None
            if pty is not None and not isinstance(pty, dict):
                pty = {}
            try:
                rcfile_data = req.get("rcfile")
                if rcfile_data is not None:
                    rcfile_data = base64.b64decode(rcfile_data, validate=True)
                status, timed_out = session.exec_run(
                    req.get("line", ""), wait, out_sink, err_sink,
                    in_fd=in_fd, conn=conn, pty=pty, control=rest,
                    shell=bool(req.get("shell")), rcfile_data=rcfile_data,
                    job_token=req.get("job_token"))
            except _SessionDead as exc:
                _session_log("exec.request_failed", logging.ERROR,
                             session, exc=exc)
                # A channel that could not be opened says nothing about the
                # session's own shell, which is a different channel and may
                # well still be fine; do not take the session down for it.
                # It does say something when the transport under both of them
                # has gone, and then this is where a reconnect starts.
                if session.failed(str(exc)):
                    _reply(conn, {"error": "mssh: --exec: %s" % exc})
                else:
                    _reply(conn, {"error": _reconnecting_message(session, exc)})
                return
            except _ClientGone as exc:
                _session_log("exec.client_gone", logging.DEBUG, exc=exc)
                return                    # nobody left to tell
            # Whatever a pipe was too full to take is still output: hand it
            # over before the descriptor goes, or a slow client loses a tail.
            out_sink.drain()
            err_sink.drain()
        finally:
            for fd in (out_fd, err_fd, in_fd):
                if fd is not None:
                    try:
                        os.close(fd)
                    except OSError as exc:
                        _session_log("exec.fd_close_failed", logging.WARNING,
                                     exc=exc, fd=fd)

        # Both pipes are closed above, so the client has already seen the end
        # of each stream by the time this arrives.
        _session_log("exec.finished", session=session, status=status,
                     timed_out=timed_out)
        _reply(conn, {"status": status, "timed_out": timed_out, "end": True})

    def die(reason):
        _session_log("daemon.ending", logging.ERROR, session,
                     session.chan, reason=reason)
        session.dead = reason
        session.stopping.set()
        state["stop"] = True

    srv.settimeout(1.0)
    try:
        while not state["stop"]:
            try:
                conn, _addr = srv.accept()
            except socket.timeout:
                if session.dead:
                    break
                # The one poll that finds a connection that died with nobody
                # using it.  It is also where a reconnect starts, so the
                # target is usually back before the next command arrives
                # rather than after it.
                if session.check_link():
                    break
                if opts.session_idle > 0 and \
                        time.time() - session.last > opts.session_idle:
                    verbose(opts, "session idle for %gs, exiting"
                            % opts.session_idle)
                    break
                continue
            except OSError as exc:
                _session_log("daemon.accept_failed", logging.ERROR,
                             session, exc=exc)
                break
            worker = threading.Thread(target=handle, args=(conn,))
            worker.daemon = True
            worker.start()
    except BaseException as exc:
        _session_log("daemon.loop_failed", logging.CRITICAL, session, exc=exc)
        raise
    finally:
        _session_log("daemon.exiting", session=session, chan=session.chan,
                     dead=session.dead, stop=state["stop"])
        try:
            srv.close()
        except Exception as exc:
            _session_log("daemon.listener_close_failed", logging.WARNING, exc=exc)
        try:
            os.unlink(path)
        except OSError as exc:
            _session_log("daemon.socket_unlink_failed", logging.WARNING, exc=exc)
        session.stopping.set()            # stop a reconnect run mid-backoff
        session.cleanup_rcfiles()
        session.close_channels()
        close_all(session.chain)
        _session_log("daemon.stopped")


def _one_line(exc):
    """An exception as a single line, for a message that travels on the wire."""
    text = " ".join(str(exc).split())
    return text or type(exc).__name__


def _open_shell(jumps, target, opts):
    """Build the chain and start the framed program on it.

    The whole of a session's remote half, in one place because a reconnect
    has to do it again exactly as the first call did -- same pty, same
    terminal settings, same 'exec' -- and a second copy of it would drift.
    Returns (clients, transport, chan, mark); the caller owns the clients.
    """
    clients, tgt = build_chain(jumps, target, opts)
    try:
        transport = tgt.get_transport()
        chan = transport.open_session(timeout=opts.timeout)
        _request_pty(chan, {"term": SESSION_TERM, "cols": SESSION_COLS,
                           "rows": SESSION_ROWS})
        # Keep signals enabled without echo, canonical buffering or CRLF
        # expansion.  Ctrl-C targets the terminal's foreground process group.
        chan.exec_command(SESSION_STTY + " 2>/dev/null; exec "
                          + (opts.command or SESSION_SHELL))
    except BaseException:
        close_all(clients)
        raise
    return clients, transport, chan, "__MSSH_%s__" % os.urandom(8).hex()


def serve_session(name, srv, path, readyfd, jumps, target, opts):
    """The daemon: build the chain, detach, then serve.

    Runs in the forked child, which still has the terminal: build_chain may
    need to ask for a password, and its -vv trace belongs on the screen.  Only
    once the session is up does this detach for good.
    """
    global _SESSION_LOG_ENABLED, _SESSION_LOG_NAME
    _SESSION_LOG_ENABLED = bool(opts.verbose)
    _SESSION_LOG_NAME = name
    _setup_logging(opts)
    _session_log("daemon.start")
    clients = []
    session = None
    forwards = []
    try:
        clients, transport, chan, mark = _open_shell(jumps, target, opts)
        prompt_re = re.compile(opts.prompt.encode("utf-8")) if opts.prompt else None
        session = _Session(chan, mark,
                           "interactive" if opts.command else "shell",
                           prompt_re, opts.idle, target, opts.command,
                           transport, opts.timeout)
        session.arm(name, jumps, clients, opts)
        banner = session.setup(opts.wait)
        if session.mode == "shell":
            session.setup_rcfile()
        if opts.local_forwards or opts.dynamic_forwards:
            # Bind before reporting success, but do not accept connections
            # while daemonization still changes the process's standard FDs.
            forwards = session.add_forwards(
                opts.local_forwards, start=False, dynamic_specs=opts.dynamic_forwards)
    except SystemExit as exc:
        _session_log("daemon.start_failed", logging.ERROR, session, exc=exc)
        # A SystemExit carries its own message and nothing has printed it yet
        # -- raising it is how mssh reports a failed hop -- so print it here,
        # on the terminal we still hold.  The parent only needs to know that we
        # failed; it deliberately says nothing more, or the same failure would
        # appear twice.
        message = str(exc).rstrip("\n")
        if message and message != "None":
            sys.stderr.write(message + "\n")
            sys.stderr.flush()
        _ready(readyfd, {"ok": False})
        if session is not None:
            session.cleanup_rcfiles()
            session.close_channels()
        close_all(clients)
        return 1
    except BaseException as exc:
        _session_log("daemon.start_failed", logging.ERROR, session, exc=exc)
        # Same reasoning: we still have the terminal, so report here.  The type
        # is included because an unexpected exception's str() is often empty.
        sys.stderr.write("mssh: session %s: %s: %s\n"
                         % (name, type(exc).__name__, exc))
        sys.stderr.flush()
        _ready(readyfd, {"ok": False})
        if session is not None:
            session.cleanup_rcfiles()
            session.close_channels()
        close_all(clients)
        return 1

    verbose(opts, "session %s ready, pid %d" % (name, os.getpid()))
    log_path = os.path.join(session_dir(), name + ".log")
    verbose(opts, "session %s detaching, stderr "
                    "will be written to %s" % (name, log_path))

    # Detach before signalling readiness, not after: the parent exits the
    # moment it hears, and its shell then prints a prompt.  Anything we wrote
    # to the terminal after that would land on top of it.
    try:
        _session_detach(name, opts)
        for job in forwards:
            job.start()
    except BaseException as exc:
        _session_log("daemon.detach_failed", logging.CRITICAL, session, exc=exc)
        _ready(readyfd, {"ok": False})
        session.cleanup_rcfiles()
        session.close_channels()
        close_all(clients)
        raise

    if opts.verbose:
        logger = logging.getLogger("mssh.session")
        # The startup notice is always visible, even at the WARNING threshold.
        record = logger.makeRecord(
            logger.name, logging.INFO, __file__, 0,
            "service started; log level: %s",
            (logging.getLevelName(logger.level),), None)
        for handler in logger.handlers:
            handler.handle(record)
    _session_log("daemon.ready", session=session, chan=session.chan)

    banner64 = base64.b64encode(banner).decode("ascii")
    _ready(readyfd, {"ok": True, "banner": banner64, "forwards": [
        {"id": job.id, "command": job.command} for job in forwards]})

    _session_serve(session, srv, path, opts)
    return 0


def run_session_spawn(name, jumps, target, opts):
    """Start a session daemon in the background and wait for it to be ready.

    The child keeps stdin and the terminal until the chain is up, so a hop that
    needs a password can still ask for one.  That is why there is no separate
    "collect the passwords first" step: connect_hop's own prompting works, in
    the process that actually needs the answer.
    """
    srv, path = _session_listen(name)
    readfd, writefd = os.pipe()

    # Fork before paramiko builds anything: a Transport starts threads, and
    # only the forking thread survives into the child -- measured, the channel
    # times out in a child forked from a process with a live transport.
    pid = os.fork()
    if pid == 0:
        os.close(readfd)
        try:
            _session_predetach()
            serve_session(name, srv, path, writefd, jumps, target, opts)
        except BaseException:
            try:
                os.unlink(path)
            except OSError:
                pass
        finally:
            os._exit(0)

    os.close(writefd)
    srv.close()
    return _await_session(name, readfd, pid, opts)


def _await_session(name, readfd, pid, opts):
    chunks = []
    while True:
        try:
            chunk = os.read(readfd, 4096)
        except OSError:
            break
        if not chunk:
            break
        chunks.append(chunk)
    os.close(readfd)
    # The daemon is our direct child and outlives us, so it cannot be reaped
    # here; only a failed one has already exited.  WNOHANG collects that case
    # without blocking on the one that succeeded.
    try:
        os.waitpid(pid, os.WNOHANG)
    except OSError:
        pass

    raw = b"".join(chunks).strip()
    if not raw:
        # The daemon keeps stderr until it is serving, so whatever killed it
        # has already been printed; there is nothing to point at.
        sys.stderr.write("mssh: session %s: the session daemon exited before "
                         "it was ready\n" % name)
        return 1
    try:
        info = json.loads(raw.decode("utf-8", "replace"))
    except ValueError:
        sys.stderr.write("mssh: session %s: the session daemon sent garbage\n"
                         % name)
        return 1
    if not info.get("ok"):
        # serve_session still had the terminal when it failed, so it printed
        # the reason itself, in full.  Relaying a summary of it here would only
        # print the same failure twice.
        return 1

    banner = base64.b64decode(info.get("banner") or "")
    if banner:
        sys.stdout.buffer.write(banner if banner.endswith(b"\n")
                                else banner + b"\n")
        sys.stdout.buffer.flush()
    verbose(opts, "session %s listening on %s" % (name, session_path(name)))
    _show_forwards(name, info.get("forwards", []))
    return 0


# -- client ----------------------------------------------------------------


def _session_exit_code(name, message, opts, interrupted=None):
    """What this process should exit with, given the daemon's last word.

    The output itself has already been written: it came off the pipe as the
    command produced it, and this is only the one message that ends it.
    """
    message = message or {}
    error = message.get("error")
    status = message.get("status")
    timed_out = bool(message.get("timed_out"))

    if error:
        sys.stderr.write(error.rstrip("\n") + "\n")
        return 1
    if interrupted and interrupted["count"]:
        return 130
    if timed_out:
        sys.stderr.write(
            "mssh: session %s: no end of output after %gs -- the command may "
            "still be running (raise --wait, or --interrupt it)\n"
            % (name, opts.wait)
        )
        return 124
    return int(status) if status is not None else 0


def run_session_send(name, line, opts, shell=False):
    """Stream one command's output to stdout, then exit with its status.

    With --exec the command runs on a channel of its own rather than in the
    session's shell, so stdout and stderr arrive apart and nothing of the
    shell's state applies; everything around it -- Ctrl-C, --wait, stdin, the
    exit code -- is the same either way.

    --exec -t asks for a terminal on that channel, for the programs that will
    not run without one, and then this terminal is the one the remote program
    is really driving: it goes into raw mode for as long as the command runs,
    so a keystroke reaches the program unedited and what the program draws is
    not rewritten on the way out.  That only happens when both ends are a
    terminal -- with either one redirected there is nothing to put in raw mode
    and no size to send, so the pty is not requested at all.

    shell is a login -- 'mssh host' -- which is the same exchange with no
    command in it: the daemon starts a shell on a channel of its own rather
    than a program, and everything --exec -t does for a full-screen program is
    what a shell wants too.  The terminal goes down with it whether or not a
    pty came back, because a shell reads its input either way; that is the one
    place a login differs from a command, where a redirected stdout is reason
    enough not to forward a terminal nobody is going to read.

    Ctrl-C here interrupts the remote command, the way it would in a terminal,
    rather than killing this process and leaving the command running: an agent
    or a script that gives up on a command needs the session left usable.
    """
    use_exec = shell or bool(getattr(opts, "exec_channel", False))
    want_pty = use_exec and (shell or opts.force_tty) and _both_ends_are_tty()
    interrupted = {"count": 0}
    job_token = secrets.token_hex(16) if use_exec else None

    def on_sigint(_signum, _frame):
        interrupted["count"] += 1
        if interrupted["count"] > 1:
            # A second Ctrl-C means "let me out", even if the remote side is
            # not responding.
            raise KeyboardInterrupt
        sys.stderr.write("\nmssh: interrupting the remote command "
                         "(Ctrl-C again to leave it running)\n")
        try:
            control = {"op": "interrupt"}
            if job_token is not None:
                control["job_token"] = job_token
            session_request(name, control, timeout=15.0)
        except (SessionGone, SystemExit, OSError):
            pass

    with_stdin = want_stdin(opts, with_pty=want_pty or shell)

    previous = signal.getsignal(signal.SIGINT)
    try:
        signal.signal(signal.SIGINT, on_sigint)
    except ValueError:
        previous = None                   # not the main thread; leave it alone

    request = {"op": "exec" if use_exec else "send",
               "line": line, "wait": opts.wait}
    if job_token is not None:
        request["job_token"] = job_token
    if shell:
        request["shell"] = True
        if getattr(opts, "rcfile_data", None) is not None:
            request["rcfile"] = base64.b64encode(opts.rcfile_data).decode("ascii")
    if with_stdin:
        request["stdin"] = True
    if want_pty:
        request["pty"] = _terminal_pty()
    call = session_exec if use_exec else session_send

    try:
        verbose(opts, "session %s: %s%s%s, waiting up to %s"
                % (name,
                   "logging in on a channel of its own" if shell
                   else ("running %d byte(s) on its own channel" % len(line))
                   if use_exec else "sending %d byte(s)" % len(line),
                   " with a terminal" if want_pty else "",
                   " and forwarding stdin (%s)" % stdin_kind()
                   if with_stdin else "",
                   ("%gs" % opts.wait) if opts.wait > 0 else "forever"))
        started = time.time()
        # Raw from here until the command is over: the remote pty owns the
        # line discipline now, so this one must not edit, echo or signal on
        # the same keystrokes.  The watcher keeps the remote pty the size of
        # this window for as long as the program is drawing in it.
        with _RawTerminal(stdin_fd() if want_pty else None):
            if want_pty:
                with _WindowWatcher() as watcher:
                    reply = call(name, request, send_stdin=with_stdin,
                                 watcher=watcher)
            else:
                reply = call(name, request, send_stdin=with_stdin)
        code = _session_exit_code(name, reply, opts, interrupted)
        verbose(opts, "session %s: finished in %.3fs, exit %d"
                % (name, time.time() - started, code))
        return code
    except KeyboardInterrupt:
        sys.stderr.write("mssh: detached; the command may still be running "
                         "(mssh --session %s --status)\n" % name)
        return 130
    finally:
        if previous is not None:
            signal.signal(signal.SIGINT, previous)


def run_session_interrupt(name, job_id=None):
    payload = {"op": "interrupt"}
    if job_id is not None:
        payload["job"] = job_id
    reply = session_request(name, payload, timeout=30.0)
    if reply.get("error"):
        sys.stderr.write(reply["error"].rstrip("\n") + "\n")
        return 1
    if reply.get("interrupted"):
        sys.stderr.write("mssh: session %s: interrupted %s\n" %
                         (name, "job %d" % job_id if job_id is not None else
                          "the running command"))
    else:
        sys.stderr.write("mssh: session %s: nothing was running\n" % name)
    return 0


def _show_forwards(name, rows):
    for row in rows:
        sys.stderr.write("mssh: session %s: forwarding job %s: %s\n" %
                         (name, row["id"], row["command"]))


def run_session_forward(name, specs, dynamic_specs=None):
    specs = [_local_forward_spec(parse_local_forward(spec)) for spec in specs]
    payload = {"op": "forward", "specs": specs}
    if dynamic_specs:
        for spec in dynamic_specs:
            parse_dynamic_forward(spec)
        payload.update(op="dynamic_forward", dynamic_specs=dynamic_specs)
    reply = session_request(name, payload, timeout=30)
    if reply.get("error"):
        sys.stderr.write(reply["error"].rstrip("\n") + "\n")
        return 1
    if not reply.get("ok") or "forwards" not in reply:
        raise SystemExit("mssh: session daemon does not support %s; "
                         "stop and recreate the session" %
                         ("-D" if dynamic_specs else "-L"))
    _show_forwards(name, reply["forwards"])
    return 0


class _SessionSFTPChannel(object):
    """A local duplex socket relayed to an SFTP channel on the held transport."""

    def __init__(self, sock, control):
        self.sock = sock
        self.control = control

    def send(self, data):
        return self.sock.send(data)

    def recv(self, size):
        return self.sock.recv(size)

    def settimeout(self, timeout):
        self.sock.settimeout(timeout)

    def get_name(self):
        return "session-sftp"

    def close(self):
        self.sock.close()
        self.control.close()


def open_session_sftp(name, timeout, transfer=None, job_token=None):
    control = _connect_session(name, timeout)
    local, remote = socket.socketpair()
    channel = _SessionSFTPChannel(local, control)
    try:
        payload = {"op": "sftp",
                   "job_token": (job_token if job_token is not None
                                 else secrets.token_hex(16))}
        if transfer is not None:
            payload["transfer"] = transfer
        request = json.dumps(payload).encode("utf-8") + b"\n"
        sent = control.sendmsg(
            [request], [(socket.SOL_SOCKET, socket.SCM_RIGHTS,
                         array.array("i", [remote.fileno()]).tobytes())])
        control.sendall(request[sent:])
        remote.close()
        reply = b""
        while b"\n" not in reply:
            chunk = control.recv(65536)
            if not chunk:
                raise RuntimeError("session daemon closed the SFTP request")
            reply += chunk
        info = _parse_reply(name, reply.split(b"\n", 1)[0])
        if info.get("error"):
            raise RuntimeError(info["error"])
        if not info.get("ok"):
            raise RuntimeError("session daemon did not open an SFTP channel")
        local.settimeout(timeout)
        return paramiko.SFTPClient(channel)
    except BaseException:
        channel.close()
        raise
    finally:
        remote.close()


def run_session_copy(name, opts):
    paths = opts.put if opts.put is not None else opts.get
    direction = "up" if opts.put is not None else "down"

    class Client:
        def open_sftp(self):
            return open_session_sftp(
                name, opts.timeout,
                {"kind": "put" if direction == "up" else "get",
                 "source": paths[0], "destination": paths[1]})

    try:
        return run_copy(Client(), (direction, [paths[0]], paths[1], None), opts)
    except (RuntimeError, socket.error, OSError) as exc:
        raise SystemExit("mssh: session %s: file transfer failed: %s" % (name, exc))


def _uptime(seconds):
    seconds = int(seconds)
    return "%d:%02d:%02d" % (seconds // 3600, seconds // 60 % 60, seconds % 60)


def run_session_status(name):
    info = session_request(name, {"op": "status"}, timeout=15.0)
    if info.get("error"):
        sys.stderr.write(info["error"].rstrip("\n") + "\n")
        return 1
    now = time.time()
    link = info.get("link") or "up"
    rows = info.get("job_details")
    # Old daemons expose only the primary-shell lock and possibly a count.
    # Do not turn missing details into "no jobs" or invent per-type counts.
    state = "running a command" if info.get("running") else "idle"
    if rows is not None:
        if any(row["kind"] != "forward" and row["state"] == "running" for row in rows):
            state = "running"
        elif any(row["state"] == "stopping" for row in rows):
            state = "interrupting"
        elif any(row["state"] == "pending" for row in rows):
            state = "pending"
        elif rows:
            state = "forwarding"
    # Lifecycle takes precedence over surviving listeners or stale job rows.
    if info.get("dead"):
        state = "ended (%s)" % info["dead"]
    elif info.get("stopping"):
        state = "stopping"
    elif link == "reconnecting":
        state = "reconnecting"
    elif link == "down":
        state = "disconnected"
    sys.stdout.write(
        "session:  %s\n"
        "target:   %s\n"
        "mode:     %s\n"
        "program:  %s\n"
        "rcfile:   %s\n"
        "uptime:   %s\n"
        "commands: %d\n"
        "state:    %s\n"
        "pid:      %d\n"
        % (name, info.get("target", "?"), info.get("mode", "?"),
           info.get("command") or "login shell",
           info.get("rcfile") or "none",
           _uptime(max(0, now - float(info.get("started") or now))),
           int(info.get("served") or 0),
           state,
           int(info.get("pid") or 0))
    )
    if rows is not None:
        default = next((row for row in rows if row.get("default")), None)
        sys.stdout.write("default:  %s\n" %
                         ("job %s (%s)" % (default["id"], default["state"])
                          if default else "idle"))
        counts = {}
        for row in rows:
            kind = "socks" if row.get("forward_type") == "socks" else row["kind"]
            counts[kind] = counts.get(kind, 0) + 1
        sys.stdout.write("jobs:     %d%s\n" %
                         (len(rows), " (%s)" % ", ".join(
                             "%s=%d" % (kind, counts[kind]) for kind in sorted(counts))
                          if counts else ""))
    elif "jobs" in info:
        sys.stdout.write("jobs:     %s\n" % info["jobs"])
    else:
        sys.stdout.write("jobs:     unknown\n")
    if info.get("last_activity") is not None:
        sys.stdout.write("activity: %s ago\n" %
                         _uptime(max(0, now - float(info["last_activity"]))))
    if "idle_limit" in info:
        sys.stdout.write("expiry:   %s\n" %
                         ("%gs of inactivity" % info["idle_limit"]
                          if info["idle_limit"] > 0 else "disabled"))
    if link == "reconnecting":
        sys.stdout.write("link:     down (%s) -- reconnecting, attempt %d "
                         "of %d\n"
                         % (info.get("broken") or "?",
                            int(info.get("attempt") or 0),
                            int(info.get("retries") or 0)))
    elif link == "down":
        sys.stdout.write(
            "link:     down (%s); %s\n"
            % (info.get("broken") or "?",
               info.get("refusal")
               or ("reconnection disabled" if not info.get("retries") else
                   "no reconnection left -- one more will be tried when the "
                   "next command arrives" + (", last error: %s"
                                             % info["last_error"]
                                             if info.get("last_error")
                                             else ""))))
    else:
        sys.stdout.write("link:     %s\n" % link)
    if info.get("reconnects"):
        sys.stdout.write("rebuilt:  %d time(s) since it started\n"
                         % int(info["reconnects"]))
    return 0


def run_session_jobs(name):
    info = session_request(name, {"op": "jobs"}, timeout=15.0)
    if info.get("error"):
        sys.stderr.write(info["error"].rstrip("\n") + "\n")
        return 1
    if "jobs" not in info:
        raise SystemExit("mssh: session daemon does not support --jobs; "
                         "stop and recreate the session")
    rows = info["jobs"]
    if not rows:
        sys.stdout.write("No running jobs.\n")
        return 0
    sys.stdout.write("ID    TYPE     CHANNEL  STATE     ELAPSED    COMMAND\n")
    for row in rows:
        # Keep terminal controls and embedded newlines out of the table.
        command = "".join(char if char.isprintable() else " "
                          for char in row.get("command", ""))
        sys.stdout.write("%-5s %-8s %-8s %-9s %-10s %s\n" %
                         (row["id"], row["kind"],
                          row["channel"] if row["channel"] is not None else "-",
                          row["state"],
                          _uptime(max(0, time.time() - row["started"])), command))
    return 0


def run_session_stop(name, job_id=None):
    if job_id is not None:
        # Keep the daemon and other jobs alive; no session socket teardown
        # wait is needed when only one task is being cancelled.
        return run_session_interrupt(name, job_id)
    session_request(name, {"op": "stop"}, timeout=15.0)
    # The daemon acknowledges before it unwinds, so wait for the socket to go:
    # otherwise an immediate restart races the teardown.
    path = session_path(name)
    deadline = time.time() + 15
    while time.time() < deadline and os.path.exists(path):
        time.sleep(0.05)
    sys.stderr.write("mssh: session %s stopped\n" % name)
    return 0


def run_session_list():
    directory = session_dir()
    rows = []
    try:
        entries = sorted(os.listdir(directory))
    except OSError:
        entries = []
    for entry in entries:
        if not entry.endswith(".sock"):
            continue
        name = entry[:-len(".sock")]
        try:
            info = session_request(name, {"op": "status"}, timeout=5.0)
        except SessionGone:
            continue                      # stale socket, a killed daemon
        except SystemExit:
            rows.append((name, "?", "?", "?", 0, "?"))
            continue
        rows.append((name, info.get("target", "?"), info.get("mode", "?"),
                     _uptime(time.time() - float(info.get("started") or 0)),
                     int(info.get("served") or 0),
                     info.get("jobs", "?")))

    if not rows:
        sys.stderr.write("mssh: no live sessions in %s\n" % directory)
        return 1
    width = max(len(r[0]) for r in rows + [("NAME",)])
    tgtw = max(len(r[1]) for r in rows) if rows else 6
    sys.stdout.write("%-*s  %-*s  %-11s  %-9s  %-5s  %s\n"
                     % (width, "NAME", tgtw, "TARGET", "MODE", "UPTIME",
                        "SENT", "JOBS"))
    for row in rows:
        sys.stdout.write("%-*s  %-*s  %-11s  %-9s  %-5d  %s\n"
                         % (width, row[0], tgtw, row[1], row[2], row[3],
                            row[4], row[5]))
    return 0


def _no_session(name):
    raise SystemExit(
        "mssh: no session %r; start one with:\n"
        "    mssh --session %s [-j <jump>...] <target>" % (name, name)
    )


def _live_session_named(name):
    """True when name is a live session, for the bare 'mssh NAME' shorthand.

    A probe, not a check: anything that goes wrong -- a word no session could
    be called, an unusable session directory, a daemon that answers nothing --
    means "not a session", and the argument goes on to be read as a host, which
    is what it was before this shorthand existed.  'mssh 10.0.0.9' must not
    start failing over the state of ~/.mssh, which only sessions care about.
    """
    if not SESSION_NAME_RE.match(name or ""):
        return False
    try:
        return session_alive(name)
    except (SystemExit, socket.error, OSError):
        return False


def _session_login_wanted(opts):
    """True when a session invocation names no work at all, which is a login.

    'mssh host' and 'mssh --session host' ask for nothing to be run, and the
    only thing left to mean is the thing ssh means by the same words: a shell
    on the target, with your terminal at it.  Anything that says what to do --
    a command, a positional, a chain to build, a key to install -- is that
    instead, and so are --status/--stop/--interrupt/--jobs, which act on the session
    rather than on the machine behind it.
    """
    if not opts.session:
        return False
    if opts.args or opts.command or opts.jump or opts.copy_id is not None \
            or opts.put is not None or opts.get is not None or opts.local_forwards \
            or opts.dynamic_forwards:
        return False
    return not (opts.stop or opts.interrupt or opts.status or opts.jobs)


def run_session(parser, opts):
    """Dispatch every --session invocation."""
    name = opts.session
    if not SESSION_NAME_RE.match(name):
        parser.error("invalid session name %r; use up to 64 characters from "
                     "A-Z a-z 0-9 . _ - starting with a letter, digit or _"
                     % name)
        return 2

    if opts.put is not None or opts.get is not None:
        if opts.args or opts.command or opts.jump or opts.copy_id is not None \
                or opts.rcfile or opts.exec_channel or opts.force_tty \
                or opts.stop or opts.interrupt or opts.status or opts.jobs \
                or opts.reconnect or opts.local_forwards or opts.dynamic_forwards \
                or opts.prompt is not None:
            parser.error("--put/--get only combine with file-copy options "
                         "and an existing session name")
        if not all(opts.put if opts.put is not None else opts.get):
            parser.error("--put/--get require nonempty source and destination paths")
        if not session_alive(name):
            _no_session(name)
        try:
            return run_session_copy(name, opts)
        except SessionGone:
            _no_session(name)

    controls = [flag for flag in ("stop", "interrupt", "status", "jobs")
                if getattr(opts, flag)]
    if len(controls) > 1:
        parser.error("--%s and --%s cannot be combined" % tuple(controls[:2]))
        return 2
    if controls:
        if opts.local_forwards or opts.dynamic_forwards:
            parser.error("-L/-D cannot be combined with --%s" % controls[0])
        if opts.jobs and (opts.command or opts.jump or opts.force_tty or
                          opts.recursive or opts.preserve or opts.reconnect or
                          opts.copy_id is not None or opts.stdin):
            parser.error("--jobs only takes an existing session name")
        if opts.args:
            parser.error("--%s takes no other arguments" % controls[0])
            return 2
        if opts.exec_channel:
            parser.error("--exec runs a command; it cannot be combined with "
                         "--%s" % controls[0])
            return 2
        try:
            if controls[0] == "status":
                return run_session_status(name)
            if controls[0] == "jobs":
                return run_session_jobs(name)
            if controls[0] == "stop":
                return run_session_stop(name, opts.job)
            return run_session_interrupt(name, opts.job)
        except SessionGone:
            _no_session(name)

    if opts.copy_id:
        parser.error("--copy-id cannot be combined with --session")
        return 2
    # Nothing to run: a login, and already implied by the absence of anything
    # else, so -t is redundant rather than wrong on it.
    login = _session_login_wanted(opts)
    if opts.force_tty and not (opts.exec_channel or login):
        parser.error("-t only applies to --session --exec; the session's own "
                     "shell already runs behind a pty, and a command sent to "
                     "it reads a fifo rather than that terminal")
        return 2
    if opts.no_stdin and (opts.force_tty or login):
        parser.error("-n contradicts %s: a terminal is forwarded for the "
                     "remote program to read from, and -n is what says not to "
                     "forward anything"
                     % ("a login" if login and not opts.force_tty else "-t"))
        return 2
    if opts.recursive or opts.preserve:
        parser.error("-r/-p only apply to a file copy, not to --session")
        return 2
    if opts.reconnect < 0:
        parser.error("--reconnect takes a number of attempts, not %d"
                     % opts.reconnect)
        return 2
    if opts.prompt is not None and not opts.command:
        parser.error("--prompt marks the end of an interactive program's "
                     "reply, so it needs -c to say which program to run")
        return 2
    if opts.prompt is not None:
        try:
            re.compile(opts.prompt)
        except re.error as exc:
            parser.error("--prompt is not a valid regular expression: %s" % exc)
            return 2

    # A live session takes commands; only a dead one can be started.  That
    # split is by existence, not by guessing whether the argument looks more
    # like a command or a host: against a live session every positional is a
    # command, so 'mssh --session s root@host' runs that word in the shell
    # and says "command not found" rather than being second-guessed here.
    # Only the start-only flags are still refused.  No positional at all is
    # the one thing that is not a command, because it is not anything: that
    # is the login above.
    if session_alive(name):
        if opts.jump or opts.command or opts.reconnect:
            raise SystemExit(
                "mssh: session %r is already running; --status to inspect "
                "it, --stop to end it" % name
            )
        try:
            if opts.local_forwards or opts.dynamic_forwards:
                if opts.args or opts.exec_channel or opts.force_tty or opts.rcfile \
                        or opts.stdin or opts.no_stdin:
                    parser.error("-L/-D only take an existing session name")
                return run_session_forward(
                    name, opts.local_forwards, opts.dynamic_forwards)
            if opts.rcfile and not login:
                parser.error("--rcfile initializes a new shell, not a command "
                             "in an existing session")
            if login:
                # A channel of its own, not the session's shell: that shell is
                # busy being a session -- the framing around every command is
                # what makes 'mssh host cmd' work at all -- so a login can no
                # more borrow it than two people can share one keyboard.
                return run_session_send(name, "", opts, shell=True)
            return run_session_send(name, " ".join(opts.args), opts)
        except SessionGone:
            # It answered a moment ago, so it ended in between -- usually
            # because the previous command was an 'exit'.  Same message as a
            # session that was never there: from here they are the same thing.
            _no_session(name)

    if opts.exec_channel:
        # --exec borrows a live session's chain; there is nothing to borrow
        # before one exists, and the first call is the one that builds it.
        parser.error("--exec runs a command in an existing session; start "
                     "one first with: mssh --session %s [-j <jump>...] "
                     "<target>" % name)
        return 2
    if len(opts.args) != 1:
        _no_session(name)
    try:
        target = parse_endpoint(opts.args[0])
    except ValueError:
        _no_session(name)
    try:
        jumps = [parse_endpoint(spec) for spec in opts.jump]
    except ValueError as exc:
        parser.error(str(exc))
        return 2
    _setup_logging(opts)
    return run_session_spawn(name, jumps, target, opts)


